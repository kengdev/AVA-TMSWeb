@{
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
}
@section Styles {
    <style>
        .action-td {
            width: 35px !important;
            text-align: center;
        }

        .name-td {
            text-align: left;
        }

        .container-td {
            width: 120px;
        }

        .date-td {
            width: 90px;
            text-align: right;
        }

        .place-td {
            text-align: left;
        }

        .currency-td {
            width: 90px;
            text-align: right;
        }

        .text-button {
            font-size: 13px;
        }
    </style>
}
<div class="col-lg-12">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-list font-dark"></i>
                <span class="caption-subject bold uppercase"> รายการใบแจ้งหนี้เลขที่ @ViewBag.Code</span>
                <input type="hidden" id="code" value="@ViewBag.Code" />
            </div>
            <div class="actions">
                <a class="btn btn-lg" href="javascript:;" data-toggle="dropdown" data-hover="dropdown" data-close-others="true">
                    <img src="~/Content/images/icons/icon-print.png" />
                    <span class="text-button">Print</span>
                </a>

                <div class="btn-group">
                    <a class="btn btn-lg" href="javascript:;" data-toggle="dropdown" data-hover="dropdown" data-close-others="true">
                        <img src="~/Content/images/icons/icon-save.png" />
                        <span class="text-button">Save</span>
                        <img src="~/Content/images/icons/icon-down.png" />
                    </a>
                    <ul class="dropdown-menu pull-right">
                        <li>
                            <a href="javascript:;" onclick="fnExport('PDF','@ViewBag.Code','@ViewBag.Customer')">
                                <img src="~/Content/images/icons/icon-pdf.png" />
                                <span class="text-button">&nbsp;&nbsp;Adobe PDF File...</span>
                            </a>
                        </li>
                        <li>
                            <a href="javascript:;" onclick="fnExport('EXC','@ViewBag.Code','@ViewBag.Customer')">
                                <img src="~/Content/images/icons/icon-excel.png" />
                                <span class="text-button">&nbsp;&nbsp;Microsoft Excel File...</span>
                            </a>
                        </li>
                        <li>
                            <a href="javascript:;" onclick="fnExport('DOC','@ViewBag.Code','@ViewBag.Customer')">
                                <img src="~/Content/images/icons/icon-word.png" />
                                <span class="text-button">&nbsp;&nbsp;Microsoft Word File...</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="portlet-body">
            <div class="scroller" style="height:550px" data-rail-visible="1" data-rail-color="yellow" data-handle-color="#a1b2bd">
                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-striped table-bordered table-hover table-checkable order-column" id="sample_1">
                            <thead>
                                <tr>
                                    <th style="padding-left:10px;"> รหัส</th>
                                    <th> ชื่อลูกค้า</th>
                                    <th> สถานที่</th>
                                    <th> วันที่</th>
                                    <th> Container No.</th>
                                    <th> ราคา</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function() {
            var oTable = $('#sample_1').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 10,
                "scrollCollapse": false,
                "order": [[1, "desc"]],
                "sAjaxSource": "/app/CoverSheet/GetJobPreview",
                "fnRowCallback": function(row, aData, index) {
                    $('td', row).eq(5).html(number_format(aData.coversheet_value));
                },
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "code", "value": $("#code").val() });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10" selected>10</option>' +
                        '<option value="20">20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-td", targets: 0 },
                    { className: "name-td", targets: 1 },
                    { className: "date-td", targets: 2 },
                    { className: "name-td", targets: 3 },
                    { className: "container-td", targets: 4 },
                    { className: "currency-td", targets: 5 }
                ],
                "columns":
                    [
                        { "data": "billing_code" },
                        { "data": "customer_name" },
                        { "data": "create_date" },
                        { "data": "fullname" },
                        { "data": "coversheet_amount" },
                        { "data": "coversheet_value" }
                    ],
                "createdRow": function(row, data, dataIndex) {

                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });
        });

        function setValue(code) {
            window.opener.setCustomerBox(code);
            self.close();
        }

        function fnExport(type, code, customer) {
            window.open("http://localhost:82/report/form/coversheet?code=" + code + "&customer=" + customer + "&type=" + type)
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}



