@model TMSWeb.Models.YardModel
@{
    ViewBag.TopActive = "Base";
    ViewBag.MidActive = "place";
    ViewBag.SubActive = "yardport";
    ViewBag.Title = "ข้อมูลท่าเรือและลานตู้";
    var cashing = (TMSWeb.Models.Entities.LOG.TblYardCashing)ViewBag.Cashing;
}
@section Styles {
    <style>
        th {
            text-align: center;
            font-size: 13px !important;
            background-color: #f1f4f7
        }

        .container {
            padding: 3px !important;
            height: 30px !important;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <li>
                <a href="javascript:;">ข้อมูลหลัก</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a href="javascript:;">ข้อมูลสถานที่</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a href="/yardport/">ท่าเรือและลานตู้</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a href="/yardport/edityard?code=@Model.place_code">แก้ไข</a>
            </li>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title tabbable-line">
                <div class="caption">
                    <i class="fad fa-pencil"></i>
                    <span class="caption-subject bold uppercase"> แก้ไขรายการ</span>
                    <span class="caption-helper">[รหัส @Model.place_code]</span>
                </div>
            </div>
            @using (Html.BeginForm("EditYardData", "YardPort", FormMethod.Post, new { id = "frmEdit", onsubmit = "return OnValidate()" }))
            {
                @Html.HiddenFor(m => m.place_code)
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="scroller" style="height:365px" data-rail-visible="1" data-rail-color="yellow" data-handle-color="#a1b2bd">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label>
                                            ชื่อสถานที่
                                            <span class="required"> * </span>
                                        </label>
                                        @Html.TextBoxFor(m => m.place_name, new { id = "txtYardName", Class = "form-control" })
                                        <span class="help-block"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label>
                                            ค่าผ่านท่า
                                            <span class="required"> * </span>
                                        </label>
                                        @Html.TextBoxFor(m => m.import_fee, new { id = "txtYardValue", Class = "form-control form-number" })
                                        <span class="help-block"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="table-scrollable">
                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th colspan="2">ราคารับตู้</th>
                                                    <th colspan="2">ราคาคืนตู้</th>
                                                </tr>
                                                <tr>
                                                    <th>ตู้สั้น</th>
                                                    <th>ตู้ยาว</th>
                                                    <th>ตู้สั้น</th>
                                                    <th>ตู้ยาว</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>
                                                        <input type="text" class="form-control container form-number" name="shortlifton" value="@cashing.ShortliftonFee" />
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control container form-number" name="longlifton" value="@cashing.LongliftonFee" />
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control container form-number" name="shortliftoff" value="@cashing.ShortliftoffFee" />
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control container form-number" name="longliftoff" value="@cashing.LongliftoffFee" />
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label>หมายเหตุ</label>
                                        @Html.TextBoxFor(m => m.place_remark, new { id = "txtRemark", Class = "form-control" })
                                        <span class="help-block"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <div class="row pull-right">
                            <div class="col-md-12">
                                <div class="tools-action">
                                    <a href="/yardport/">กลับหน้าหลัก</a> |
                                    <button type="submit" class="btn green">บันทึกข้อมูล</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        (function($) {
            $("#frmEdit").ajaxForm(function(data) {
                killOverlayForm();
                if (data.result == true) {
                    $.alert.open('info', data.resultMessage, function(r) {
                        window.location.reload();
                    });
                } else {
                    $.alert.open('error', data.resultMessage);
                }
            });

            $('#dspMap').click(function() {
                var lat = $('#txtLat').val();
                var lon = $('#txtLon').val();
                openMapInit(lat, lon);
            });
        }(jQuery));


        function openMapInit(lat, lon) {
            var childWin = window.open("/app/Map/_InitMap?lat=" + lat + "&lon=" + lon, "InitMapWin", "height=620, width=840, status=yes, toolbar=no, menubar=no, location=no,addressbar=no");
        }

        function setValue(lat, lon) {
            $('#txtLat').val(lat);
            $('#txtLon').val(lon);
        }

        function OnValidate() {
            var fn = $('#frmEdit').myfunction({
                rules: {
                    txtYardName: {
                        require: {
                            value: true,
                            message: "กรุณาพิมพ์ชื่อสถานที่"
                        },
                        minlength: {
                            value: 3,
                            message: "กรุณาพิมพ์ข้อความอย่างน้อย 3 ตัวอักษร"
                        }
                    },
                    txtYardValue: {
                        require: {
                            value: true,
                            message: "กรุณาระบุค่าผ่านท่า"
                        }
                    }
                }
            })

            if (fn)
                overLayForm();

            return fn;
        }
    </script>
}


