@model TMSWeb.Models.Entities.LOG.TblBudget
@{
    ViewBag.TopActive = "Job";
    ViewBag.MidActive = "budget";
    ViewBag.Title = "รายการเบิก-จ่าย";
}
@section Styles {
    <style>
        table.dataTable td, table.dataTable th {
            font-size: 13px !important;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }

        #filterDateRangeStart, #filterDateRangeEnd {
            width: 150px !important;
        }

        .status-add {
            background: #26c281;
            color: #fff;
            vertical-align: middle !important;
        }

        .table tr:hover td.status-add {
            background-color: #26c281 !important;
        }

        .status-min {
            background: #e43a45;
            color: #fff;
            vertical-align: middle !important;
        }

        .table tr:hover td.status-min {
            background-color: #e43a45 !important;
        }

        .status-update {
            background: #e87e04;
            color: #fff;
            vertical-align: middle !important;
        }

        .table tr:hover td.status-update {
            background-color: #e87e04 !important;
        }

        .add {
            color: #26c281;
            font-weight: bold;
        }

        .min {
            color: #e43a45;
            font-weight: bold;
        }

        .update {
            color: #e87e04;
            font-weight: bold;
        }

        .currency-td {
            vertical-align: middle !important;
        }

        .balance-wrapper {
            width: 160px;
            text-align: center !important;
        }

        .label-balance {
            font-size: 13px;
            background: green;
            width: 150px;
            text-align: center;
            color: #fff;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">ข้อมูลงาน</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/customer/">รายการเบิก - จ่าย</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> รายการข้อมูลเบิก - จ่าย</span>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn-sm blue btn-circle btn-outline" onclick="getExcel()">
                        <i class="fad fa-download"></i> ดาวน์โหลด
                    </button>
                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-6">
                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right">
                            <input type="text" class="form-control" value="@DateTime.Now.AddDays(-3).ToString(" yyyy/MM/dd")" id="filterDateRangeStart" />
                            <span style="display:inline-block;" class="daterange-to-text">to</span>

                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" value="@DateTime.Now.ToString("yyyy/MM/dd")" id="filterDateRangeEnd">
                                <span class="input-group-btn">
                                    <button class="btn green" id="btnSearch" type="button">ค้นหา</button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <table class="table table-striped table-bordered table-hover table-checkable order-column" id="table-budget">
                    <thead>
                        <tr>
                            <th style="text-align: right!important;padding-right:5px;" colspan="4">ยอดคงเหลือ</th>
                            <th style="text-align: right!important;">
                                @if (Model.Balance > 0)
                                {
                                    <span class="font-green-jungle font-md bold">@Model.Balance.ToString("฿#,##0.00")</span>
                                }
                                else
                                {
                                    <span class="font-red-mint bold">@Model.Balance.ToString("฿#,##0.00")</span>
                                }
                            </th>
                        </tr>
                        <tr>
                            <th></th>
                            <th> วันที่</th>
                            <th> รายการ</th>
                            <th> ประเภท</th>
                            <th> ยอดเงิน</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr role="row" class="heading">
                            <th class="filter"></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameTH" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameEN" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameTH" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameEN" /></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>


@section scripts
{
    <script type="text/javascript">
        (function($) {
            var oTable = $('#table-budget').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[1, "desc"]],
                "sAjaxSource": "/Budget/GetTransportTransactionDataList",
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "filterDateRangeStart", "value": $("#filterDateRangeStart").val() });
                    aoData.push({ "name": "filterDateRangeEnd", "value": $("#filterDateRangeEnd").val() });
                },
                "fnRowCallback": function(row, aData, index) {
                    if (aData.transaction_type == "JOB") {
                        if (aData.payment_type == 'MIN') {
                            $('td', row).eq(2).html('<div><span class="min">จ่ายเงิน</span>สำรองให้งานเลขที่ ' + aData.job_detail_code + '</div><div>ลูกค้า : ' + aData.customer_name + ' [' + aData.start + ' - ' + aData.mission + ']</div>');

                            $('td', row).eq(3).addClass('status-min');
                            $('td', row).eq(3).html('จ่ายออก');
                            $('td', row).eq(4).html('<span class="min">- ฿' + number_format(aData.amount) + '</span>');
                        } else if (aData.payment_type == 'UPDATE') {
                            $('td', row).eq(2).html('<div><span class="update">แก้ไข</span>ยอดจ่ายเงินสำรองให้งานเลขที่ ' + aData.job_detail_code + '</div><div>ลูกค้า : ' + aData.customer_name + ' [' + aData.start + ' - ' + aData.mission + ']</div>');

                            $('td', row).eq(3).addClass('status-update');
                            $('td', row).eq(3).html('แก้ไข');

                            if (aData.amount_diff > 0) {
                                $('td', row).eq(4).html('<span class="add">+ ฿' + number_format(aData.amount_diff) + '</span>');
                            }
                            else {
                                $('td', row).eq(4).html('<span class="min">- ฿' + number_format(Math.abs(aData.amount_diff)) + '</span>');
                            }
                        }
                    }
                    else if (aData.transaction_type == 'OTHER') {
                        $('td', row).eq(2).html(aData.remark);

                        $('td', row).eq(3).addClass('status-min');
                        $('td', row).eq(3).html('จ่ายออก');
                        $('td', row).eq(4).html('<span class="min">- ฿' + number_format(aData.amount) + '</span>');
                    }
                    else {
                        $('td', row).eq(2).html('รับเบิกยอดสำรองจ่ายเข้าระบบ');

                        $('td', row).eq(3).addClass('status-add');
                        $('td', row).eq(3).html('รับเบิก');
                        $('td', row).eq(4).html('<span class="add">+ ฿' + number_format(aData.amount) + '</span>');
                    }
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-3-td text-center", targets: 0 },
                    { className: "datetime-td", targets: 1 },
                    { className: "name-td", targets: 2 },
                    { className: "type-td", targets: 3 },
                    { className: "currency-td", targets: 4 }
                ],
                "columns":
                    [
                        {
                            "data": "transaction_code", "orderable": false, "render": function(data, type, row) {
                                var detail = '';
                                if (row.transaction_type == 'JOB') {
                                    detail = '<a class="btn btn-xs blue" href="javascript:;" data-title="รายละเอียด"  data-toggle="tooltip" data-trigger="hover" onclick=setDetail("' + data + '")><i class="fad fa-clipboard-list"></i></a>';
                                }

                                return detail;
                            }
                        },
                        { "data": "transaction_date" },
                        { "data": "customer_name", "orderable": false },
                        { "data": "transaction_type", "orderable": false },
                        { "data": "amount", "orderable": false }
                    ],
                "createdRow": function(row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-budget tfoot tr').appendTo('#table-budget thead');

            $('#btnSearch').click(function() {
                $('#table-budget').dataTable()._fnAjaxUpdate();
            });

            $('#filterDateRangeStart').datetimepicker({
                format: 'Y/m/d',
                lang: 'th',
                onShow: function(ct) {
                    this.setOptions({
                        maxDate: jQuery('#filterDateRangeEnd').val() ? jQuery('#filterDateRangeEnd').val() : false
                    })
                },
                timepicker: false
            });

            $('#filterDateRangeEnd').datetimepicker({
                format: 'Y/m/d',
                lang: 'th',
                onShow: function(ct) {
                    this.setOptions({
                        minDate: jQuery('#filterDateRangeStart').val() ? jQuery('#filterDateRangeStart').val() : false
                    })
                },
                timepicker: false
            });

        }(jQuery));

        function setDetail(code) {
            var url = '/budget/transactiondetail?code=' + code;
            var setting = 'width=800,height=550';

            window.open(url, 'transaction detail', setting);
        }

        function getExcel() {

            var filterDateRangeStart = $("#filterDateRangeStart").val();
            var filterDateRangeEnd = $("#filterDateRangeEnd").val()

            var url = '/export/BudgetTransactionExcel?filterDateRangeStart=' + filterDateRangeStart + '&filterDateRangeEnd=' + filterDateRangeEnd;
            window.open(url, 'form list');
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}