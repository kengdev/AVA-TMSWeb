@model TMSWeb.Models.Entities.LOG.ViewJobListActive
@{
    ViewBag.Title = "Finish";
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
    var data = (TMSWeb.Models.Entities.LOG.TblBudgetTransaction)ViewBag.Transaction;
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
    <style>
        .table td {
            font-size: 13px;
        }

        .bordered {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }

        .data-bootstrap th {
            font-size: 13px !important;
            text-align: center;
            background: #e8e8e8;
        }

        td.topic {
            width: 120px !important;
            text-align: right;
        }

        a.closed {
            font-size: 16px !important;
            color: red;
        }

            a.closed:hover {
                color: #8e0505
            }

        .caption-helper {
            font-size: 13px;
            color: #929292
        }

        .other-val {
            width: 83px !important;
            display: inline-block;
        }

        .form-body {
            padding-top: 0 !important;
        }

        .form-actions {
            padding: 15px 0 0 0 !important;
            margin: 0;
        }

        .table-responsive {
            overflow-y: visible !important;
            z-index: 999;
        }

        .form-box {
            height: 25px !important;
        }

        th {
            text-align: left !important;
        }

        label.mt-checkbox {
            font-size: 13px !important;
        }

        .lastest-payment {
            padding-top: 10px;
        }
    </style>
}
<div class="col-md-12 ">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <span class="caption-subject bold uppercase"> จ่ายเงินสำรอง</span>
                <span class="caption-helper">[งานเลขที่ @Model.JobDetailCode]</span>
            </div>
        </div>
        @using (Html.BeginForm("UpdateAdvanceData", "Job", FormMethod.Post, new
        {
            role = "form",
            id = "frmFinish",
            onsubmit = "return OnValidate()"
        }))
        {
            @Html.Hidden("job_detail_code", Model.JobDetailCode)
            <div class="portlet-body form">
                <div>
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-12">
                                <ul class="chats">
                                    <li class="in">
                                        <img class="avatar" alt="" src="~/images/office-paperwork.jpg" />
                                        <div class="message">
                                            <span class="arrow"> </span>

                                            @if (Model.ContainerNo != "-" && Model.ContainerNo != "")
                                            {
                                                <div class="font-blue">@Model.TruckNo [@Model.TruckLicense]</div>
                                                <label class="bold font-green-jungle"> @Model.ContainerNo</label>
                                            }
                                            else
                                            {
                                                <div class="bold font-blue">@Model.TruckNo [@Model.TruckLicense]</div>
                                                <label class="bold font-red">ไม่ระบุเบอร์ตู้</label>
                                            }

                                            <span class="datetime"> | @Model.JobDate.ToString("dd MMM yyyy HH:mm") </span>
                                            <span class="body">@Model.StartName to @Model.MissionName</span>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                @await Component.InvokeAsync("EntryUpdateAdvance", new
                                {
                                    code = Model.JobDetailCode,
                                    lift_cash = Model.IsLiftCashing
                                })
                            </div>

                            <div class="col-md-6">
                                @await Component.InvokeAsync("EntryUpdateCashing", new { code = Model.JobDetailCode })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 text-right">
                                <div class="mt-checkbox-inline">
                                    <label class="mt-checkbox">
                                        @if (Model.IsAdvanceProve.Value == true)
                                        {
                                            <input type="checkbox" id="inlineCheckbox21" checked disabled>
                                            @Html.Hidden("is_document", Model.IsAdvanceProve)
                                        }
                                        else
                                        {
                                            <input type="checkbox" id="inlineCheckbox21" name="is_document" value="TRUE">
                                        }
                                        ยืนยันการจบงาน
                                        <span></span>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6 text-right">
                                <div class="font-sm lastest-payment">
                                    @if (Model.IsAdvancePaid.Value)
                                    {
                                        <div class="bold">
                                            <span>ยอดจ่ายล่าสุด : </span>
                                            <span class="font-red-mint"> @data.Amount.ToString("#,##0.00") บ.</span>
                                        </div>
                                        <div class="font-grey-cascade font-sm">
                                            <span>@data.CreateDate.ToString("dd-MM-yyyy HH:mm")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <div class="row pull-right">
                            <div class="col-md-12">
                                <div class="tools-action">
                                    <a href="javascript:;" onclick="window.close();">ยกเลิก</a> |
                                    <button type="submit" class="btn green">บันทึกข้อมูล</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts
{
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        (function($) {
            $("#frmFinish").ajaxForm(function(data) {
                killOverlayForm();
                if (data.result === true) {
                    $.alert.open('info', "บันทึกข้อมูลเรียบร้อยแล้ว", function(r) {
                        window.opener.reloadRow();
                        window.close();
                    });
                } else {
                    $.alert.open('error', "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>");
                }
            });
        }(jQuery));

        function addCashing() {
            var row = '<tr><td style="text-align:center;vertical-align:middle;"><a href="#" class="closed" onclick=removeCashingItem(this)><i class="icon icon-close"></a></td>'
            row += '<td><input type="text" class="form-control form-box" name="nameCashing[]"></td>';
            row += '<td><input type="text" class="form-control cashing-val form-box" name="valCashing[]" value="0" /></td></tr>'
            $('#cashing-table').append(row);
        }

        function addAdvance() {
            var row = $('#advance-table tr td').html();
            if (row == "No matching records found") {
                $('#advance-table tr').remove();
            }
            var row = '<tr><td style="text-align:center;vertical-align:middle;"><a href="#" class="closed" onclick=removeAdvanceItem(this)><i class="icon icon-close"></a></td>'
            row += '<td><input type="text" class="form-control form-box" name="nameAdvance[]"></td>';
            row += '<td><input type="text" class="form-control form-box" name="valSupplier[]" value="0" /></td></tr>'
            $('#advance-table').append(row)
        }

        function removeCashingItem(e) {
            //var val = $(e).closest("td").next().next().find("input").val();
            $(e).parent().parent().remove()
            TotalCashingSum();
        }

        function removeAdvanceItem(e) {
            //var val = $(e).closest("td").next().next().find("input").val();
            $(e).parent().parent().remove()
            TotalAdvanceSum();
        }

        function TotalCashingSum() {
            var sum = 0;
            $(".cashing-val").each(function() {
                sum += parseFloat(this.value) || 0;
            });

            $('#total-cashing').html(number_format(sum));
            $('#hidden-total-cashing').val(sum);
        }

        function TotalAdvanceSum() {
            var sum = 0;
            $(".advance-val").each(function() {
                sum += parseFloat(this.value) || 0;
            });

            $('#total-advance').html(number_format(sum));
            $('#hidden-total-advance').val(sum);
        }

        function OnValidate() {
            overLayForm();
            return true;
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}