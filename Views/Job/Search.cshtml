@{
    ViewBag.TopActive = "Job";
    ViewBag.MidActive = "searchjob";
    ViewBag.Title01 = "ข้อมูลงาน";
    ViewBag.Link01 = "javascript:;";
    ViewBag.Title02 = "ค้นหางานในระบบ";
}
@section Styles{
    <link rel="stylesheet" type="text/css" href="~/css/profile/todo-2.min.css" />
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
    <style>
        .table td, .table th {
            font-size: 13px!important;
        }
        .dataTables_length {
            /*display: none;*/
        }

        .data-bootstrap th {
            font-size: 13px !important;
            text-align: center;
            background: #e8e8e8;
        }
        .font-small{
            font-size:10px!important;
        }
        .action-td{
            text-align: center!important;
        }
        .date-td{
            width:100px!important;
        }
        .code-td{
            width:110px!important;
        }
        .booking-td,.invoice-td,.container-td
        {
            width:130px!important;
        }
        .dropdown-td {
            width: 70px !important;
            padding-left: 7px !important;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <li>
                <a href="javascript:;">ข้อมูลงาน</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a href="/job/search/">ค้นหางานในระบบ</a>
            </li>
        </li>
    </ul>
</div>
<br/>
<div class="row">
    <div class="col-md-12 ">
        <!-- BEGIN SAMPLE FORM PORTLET-->
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption font-green">
                    <span class="caption-subject bold uppercase"> ค้นหางานในระบบทั้งหมด </span>
                </div>
            </div>

            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <form class="form-inline" role="form">
                                <div class="form-group">
                                    <div class="input-icon">
                                        <i class="fa fa-search"></i>
                                        <input type="email" class="form-control" value="" id="txtSearch" placeholder="เบอร์ตู้ / เลขที่งาน">
                                    </div>
                                </div>
                                <button type="button" class="btn btn-default" id="btnSearch">ค้นหา</button>
                            </form>
                        </div>
                        <div class="col-md-6">

                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <table id="list" class="table table-striped table-bordered table-sm">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>วันที่</th>
                                        <th>เลขที่งาน</th>
                                        <th>Booking</th>
                                        <th>Invoice</th>
                                        <th>Container</th>
                                        <th>ลูกค้า</th>
                                        <th>สถานที่</th>
                                        <th>Supplier</th>
                                        <th>สถานะ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            var oTable = $('#list').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "paging":   false,
                "scrollCollapse": false,
                "searching": true,
                "order": [[2, "desc"]],
                "sAjaxSource": "/Job/SearchResult",
                "fnRowCallback": function (row, aData, index) {
                    var status = aData.tracking_status;

                    if ( status == 'PN') {
                        $('td', row).eq(9).addClass('PN');
                        $('td', row).eq(9).html('รอ');
                    }
                    else if ( status == 'ST') {
                        $('td', row).eq(9).addClass('ST');
                        $('td', row).eq(9).html('รับงาน');
                    }
                    else if (status == 'WP') {
                        $('td', row).eq(9).addClass('WP');
                        $('td', row).eq(9).html('รอรับตู้');
                    }
                    else if (status == 'PU') {
                        $('td', row).eq(9).addClass('PU');
                        $('td', row).eq(9).html('รับตู้แล้ว');
                    }
                    else if (status == 'AR') {
                        var msg = aData.job_type == 'IMPORT' ? 'รอเปิด' : 'รอบรรจุ';
                        $('td', row).eq(9).addClass('AR');
                        $('td', row).eq(9).html(msg);
                    }
                    else if (status == 'DO') {
                        $('td', row).eq(9).addClass('DO');
                        $('td', row).eq(9).html('เสร็จสิ้น');
                    }
                    else if (status == 'BO') {
                        $('td', row).eq(9).addClass('BO');
                        $('td', row).eq(9).html('คืนตู้');
                    }
                },
                "fnServerParams": function (aoData) {
                    aoData.push({ "name": "code", "value": $("#txtSearch").val() });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-2-td text-center", targets: 0 },
                    { className: "date-td font-small", targets: 1 },
                    { className: "code-td font-small", targets: 2 },
                    { className: "booking-td font-small", targets: 3 },
                    { className: "invoice-td font-small", targets: 4 },
                    { className: "container-td font-small", targets: 5 },
                    { className: "name-td font-small", targets: 6 },
                    { className: "name-td font-small", targets: 7 },
                    { className: "status-td font-small", targets: 8 },
                    { className: "status-td font-small", targets: 9 },
                ],
                "columns":
                    [
                        {
                            "data": "job_detail_code", "orderable": false, "render": function (data, type, row) {
                                var tracking = '<a href="javascript:;" data-title="สถานะการส่งสินค้า" data-toggle="tooltip" class="btn btn-xs yellow" data-trigger="hover" onclick=getStatus("' + data + '")><i class="fad fa-map-signs"></i></a>';
                                var detail = '<a href="javascript:;" data-title="รายละเอียด" data-toggle="tooltip" class="btn btn-xs blue" data-trigger="hover" onclick=getDetail("' + data + '")><i class="fad fa-clipboard-list"></i></a>';
                                var cancel = '<a href="javascript:;" data-title="ยกเลิกงาน" data-toggle="tooltip" class="btn btn-xs red" data-trigger="hover" onclick=setCancel("' + data + '")>&nbsp;<i class="fa fa-times"></i>&nbsp;</a>';

                                return cancel + detail;
                            }
                        },
                        { "data": "job_date", "orderable": false },
                        { "data": "job_detail_code", "orderable": false },
                        { "data": "booking_no", "orderable": false },
                        { "data": "job_invoice", "orderable": false },
                        { "data": "container_no", "orderable": false },
                        { "data": "customer_name", "orderable": false },
                        { "data": "mission_name", "orderable": false },
                        { "data": "supplier_name", "orderable": false },
                        { "data": "mission_name", "orderable": false }
                    ],
                "createdRow": function (row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#btnSearch').click(function () {
                $('#list').dataTable()._fnAjaxUpdate();
            });
        });

        function getStatus(code) {
            var url = '/job/updatestatus?code=' + code;
            var setting = 'width=1100,height=665';

            window.open(url, 'Status Station', setting);
        }

        function getPrint(code) {
            var url = '/form/order?code=' + code;

            window.open(url, 'Print Station');
        }

        function setCancel(code) {
            var url = '/job/canceljob?code=' + code;
            var setting = 'width=1000,height=648';

            window.open(url, 'Cancel Station', setting);
        }

        function reloadRow() {
            $("#table-station").DataTable().ajax.reload();
        }

        function closeModal() {
            $.modal.close();
        }

        function getDetail(code){
            var url = '/job/searchdetail?code=' + code;
            var setting = 'width=900,height=500';

            window.open(url, 'detail search', setting);
        }
    </script>
}