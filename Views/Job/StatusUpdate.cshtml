@model TMSWeb.Models.UpdateStatusModel
@{
    ViewBag.Title = "Add";
    Layout = "~/Views/Shared/_PartialLayout.cshtml";

    var data = (TMSWeb.Models.Entities.LOG.ViewJobListActive)ViewBag.Data;
    var list = (List<TMSWeb.Models.ViewModels.StepViewModel>)ViewBag.Tracking;

}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/profile/todo-2.min.css" />
    <link rel="stylesheet" type="text/css" href="~/fonts/icomoon/icomoon.css" />
    <style>
        .table td {
            font-size: 13px;
        }

        th {
            font-size: 13px !important;
            text-align: center;
        }

        td.topic {
            text-align: left;
        }

        .mt-step-title {
            font-size: 14px !important;
            font-weight: bold !important;
        }

        #form-content {
            padding: 30px;
        }
    </style>
}
<div class="col-md-12 ">
    <!-- BEGIN SAMPLE FORM PORTLET-->
    <div class="portlet light bordered">
        <div class="portlet-body form">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-12 align-middle">
                        <div class="mt-element-step">
                            <div class="row step-line">
                                @foreach (var item in list)
                                {
                                    <div class="col-md-@item.column mt-step-col @item.index @item.active">
                                        <div class="mt-step-number bg-white font-grey">
                                            <i class="@item.icon"></i>
                                        </div>
                                        <div class="mt-step-title uppercase font-grey-cascade">@item.action</div>
                                        <div class="mt-step-content font-grey-cascade">@item.action_time</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="scroller" style="height:310px" data-rail-visible="1" data-rail-color="yellow"
                                 data-handle-color="#a1b2bd">
                                <div class="col-md-6">
                                    <div class="table-scrollable table-scrollable-borderless">
                                        <table class="table table-light">
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">ลูกค้า</span>
                                                </td>
                                                <td> @data.CustomerNameTh</td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">พนักงานขับรถ</span>
                                                </td>
                                                <td> @data.DriverFullname</td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">วันที่</span>
                                                </td>
                                                <td> @data.JobDate.ToString("dd-MM-yyyy HH:mm") </td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">รับตู้</span>
                                                </td>
                                                <td> @data.StartName </td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">คืนตู้</span>
                                                </td>
                                                <td> @data.FinishName</td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">ประเภทงาน/ขนาดตู้</span>
                                                </td>
                                                <td>
                                                    @data.JobType / @data.ContainerSizeName
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">จำนวนตู้</span>
                                                </td>
                                                <td> @data.LiftedAmount / @data.ContainerAmount</td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">หมายเหตุ</span>
                                                </td>
                                                <td> @data.JobRemark </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="table-scrollable table-scrollable-borderless">
                                        <table class="table table-light">
                                            <tr>
                                                <td style="border:none;">&nbsp;</td>
                                                <td style="border:none;">&nbsp;</td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">ทะเบียน</span>
                                                </td>
                                                <td colspan="2"> @data.TruckLicense / @data.TrailerLicense</td>
                                            </tr>

                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">วันที่</span>
                                                </td>
                                                <td> @data.JobDate.ToString("dd-MM-yyyy HH:mm") </td>
                                                <td class="topic">
                                                    <span class="font-green-sharp">Closing Time</span>
                                                </td>
                                                <td> @data.ClosingTime</td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">เปิดตู้/บรรจุ</span>
                                                </td>
                                                <td colspan="2"> @data.MissionName </td>
                                            </tr>
                                            <tr>
                                                <td class="topic">
                                                    <span class="font-green-sharp">Booking No.</span>
                                                </td>
                                                <td> @data.BookingNo </td>

                                                <td class="topic">
                                                    <span class="font-green-sharp">Invoice/Job</span>
                                                </td>
                                                <td> @data.JobInvoice</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                @if (Model.status != "BO")
                {
                    <button type="button" onclick="getUpdate('@data.HashCode')" class="btn blue">อัพเดทสถานะ</button>
                }

                <button type="button" onclick="reverseStatus('@data.HashCode', '@Model.status')"
                        class="btn red">
                    ย้อนกลับสถานะ
                </button>
            </div>
        </div>
    </div>
</div>

<div id="modal-update-form" style="display:none;">
    <div id="form-content">
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        (function($) {
            $("#frmAdd").ajaxForm(function(data) {
                unoverLay();
                if (data.result === true) {
                    $.alert.open('info', "บันทึกข้อมูลเรียบร้อยแล้ว", function(r) {
                        window.location.reload();
                    });
                } else {
                    $.alert.open('error',
                        "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>"
                    );
                }
            });

            $('.datetimepicker').datetimepicker({
                datepicker: true,
                timepicker: true,
                lang: 'th',
                step: 30,
                format: 'Y-m-d H:i',
                inline: false
            });
        }(jQuery));

        function reverseStatus(code, status) {
            $.alert.open('confirm', 'คุณต้องการถอยกลับสถานะ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLay();
                    $.post("/Invoice/ReverseStatus",
                        {
                            status: status,
                            code: code
                        }, function(result) {
                            if (result === true) {
                                window.location.reload();
                            } else {
                                $.alert.open('error',
                                    "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>"
                                );
                            }
                        });
                }
            });
        }

        function getUpdate(code) {
            var url = "/status/importinvoice?code=" + code;
            window.location.replace(url);
        }
    </script>
}