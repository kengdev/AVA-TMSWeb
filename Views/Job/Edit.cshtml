@model TMSWeb.Models.Entities.LOG.TblJobDetail
@{
    ViewBag.Title = "ข้อมูลงาน";
    Layout = "~/Views/Shared/_PartialLayout.cshtml";

    var data = (TMSWeb.Models.Entities.LOG.ViewJobListActive)ViewBag.Data;
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/profile/todo-2.min.css" />
    <style>
        .table td {
            font-size: 13px;
        }

        th {
            font-size: 13px !important;
            text-align: center;
        }

        td.topic {
            width: 120px !important;
            text-align: right;
        }
    </style>
}
<div class="col-md-12 ">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-pencil"></i>
                <span class="caption-subject bold uppercase"> แก้ไขรายการ</span>
                <span class="caption-helper">[เลขที่ @Model.JobCode]</span>
            </div>
        </div>
        @using (Html.BeginForm("EditOrderTruck", "Job", FormMethod.Post, new { id = "frmEdit", onsubmit = "return OnValidate()" }))
        {
            @Html.HiddenFor(m => m.JobDetailCode)
            @Html.HiddenFor(m => m.DriverCode)
            @Html.HiddenFor(m => m.CostValue)
            @Html.HiddenFor(m => m.ContainerNo)
            @Html.HiddenFor(m => m.SealNo)
            @Html.HiddenFor(m => m.TareWeight)
            @Html.HiddenFor(m => m.JobStatus)
            @Html.HiddenFor(m => m.TrailerLicense)
            @Html.HiddenFor(m => m.TrackingStatus)
            @Html.HiddenFor(m => m.JobCode)
            @Html.HiddenFor(m => m.StartPlaceCode)
            @Html.HiddenFor(m => m.MissionPlaceCode)
            @Html.HiddenFor(m => m.FinishPlaceCode)
            @Html.HiddenFor(m => m.SupplierInvoice)
            @Html.HiddenFor(m => m.IsDocument)
            @Html.HiddenFor(m => m.IsBilling)
            @Html.HiddenFor(m => m.IsPayment)
            @Html.HiddenFor(m => m.IsAdvancePaid)
            @Html.HiddenFor(m => m.IsEnabled)
            @Html.HiddenFor(m => m.CreateDate)
            @Html.HiddenFor(m => m.CreateBy)
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="table-scrollable table-scrollable-borderless">
                                <table class="table table-light">
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">ลูกค้า</span>
                                        </td>
                                        <td> @data.CustomerAcronym</td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">รับตู้</span>
                                        </td>
                                        <td> @data.StartName </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">เปิดตู้/บรรจุ</span>
                                        </td>
                                        <td> @data.MissionName </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">คืนตู้</span>
                                        </td>
                                        <td> @data.FinishName</td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">วันที่</span>
                                        </td>
                                        <td> @data.JobDate.ToString("dd-MM-yyyy HH:mm") </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">ประเภทงาน/ขนาด</span>
                                        </td>
                                        <td>
                                            @data.JobType / @data.ContainerSizeName
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">Booking No.</span>
                                        </td>
                                        <td> @data.BookingNo </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">Invoice/Job</span>
                                        </td>
                                        <td> @data.JobInvoice</td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">จำนวนตู้</span>
                                        </td>
                                        <td> @data.ContainerAmount รายการ</td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">หมายเหตุ</span>
                                        </td>
                                        <td> @data.JobRemark </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="col-md-6">
                            @if (data.JobType != "FLOOR")
                            {
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>ประเภท</label>
                                            <div class="mt-radio-inline">
                                                <label class="mt-radio mt-radio-outline">
                                                    @Html.RadioButtonFor(m => m.IsSingleTrip, false, new
                                                    {
                                                        @Class =
                                                    "rdoTrip",
                                                        autocomplete = "off",
                                                        Checked = "Checked"
                                                    })
                                                    งานรับ-คืนตู้
                                                    <span></span>
                                                </label>
                                                <label class="mt-radio mt-radio-outline">
                                                    @Html.RadioButtonFor(m => m.IsSingleTrip, true, new
                                                    {
                                                        @Class =
                                                    "rdoTrip",
                                                        autocomplete = "off"
                                                    }) งานตู้ตัดหาง
                                                    <span></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @Html.HiddenFor(m => m.IsSingleTrip)
                            }
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>
                                            บริษัทผู้รับงาน
                                        </label>
                                        <br />
                                        @Html.DropDownList("new_supplier_code", null, new
                                        {
                                            id = "supplyer_code",
                                            @Class =
                                        "form-control"
                                        })
                                        <span class="help-block help-filter"></span>
                                    </div>
                                </div>
                            </div>

                            @if (Model.SupplierCode != "SP18001")
                            {
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>
                                                ทะเบียนรถ
                                            </label>
                                            <br />
                                            @Html.DropDownList("new_truck_code", null, "-----เลือก-----", new
                                            {
                                                id = "truck_code",
                                                @Class = "form-control",
                                                disabled = "Disabled"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>
                                                พนักงานขับรถ
                                            </label>
                                            <br />
                                            @Html.DropDownList("new_driver_code", null, "-----เลือก-----", new
                                            {
                                                id = "driver_code",
                                                @Class = "form-control",
                                                disabled = "Disabled"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>
                                                ทะเบียนรถ
                                            </label>
                                            <br />
                                            @Html.DropDownList("new_truck_code", null, "-----เลือก-----", new
                                            {
                                                id = "truck_code",
                                                @Class = "form-control"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>
                                                พนักงานขับรถ
                                            </label>
                                            <br />
                                            @Html.DropDownList("new_driver_code", null, "-----เลือก-----", new
                                            {
                                                id = "driver_code",
                                                @Class = "form-control"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <div class="row pull-right">
                        <div class="col-md-12">
                            <div class="tools-action">
                                <a href="javascript:;" onclick="window.close();">ยกเลิก</a> |
                                <button type="submit" class="btn green">บันทึกข้อมูล</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @section scripts
    {
        <script src="~/js/autocomplete/bootstrap3-typeahead.min.js" type="text/javascript"></script>
        <script type="text/javascript">
                (function($) {
                    $("#frmEdit").ajaxForm(function(data) {
                        killOverlayForm();
                        if (data.result === true) {
                            $.alert.open('info', data.resultMessage, function(r) {
                                window.opener.reloadRow();
                                window.close();
                            });
                        } else {
                            $.alert.open('error', data.resultMessage);
                        }
                    });

                    $('#supplyer_code').change(function() {
                        var supplyer = $(this).val();
                        if (supplyer == 'SP18001') {
                            $('#truck_code').prop('disabled', false);
                            $('#driver_code').prop('disabled', false);
                            setDriverDropDown(supplyer);
                        } else {
                            $('#truck_code').val('');
                            $('#driver_code').val('');
                            $('#truck_code').prop('disabled', true);
                            $('#driver_code').prop('disabled', true);
                        }
                    });

                    $('#truck_code').change(function() {
                        var truck = $(this).val();
                        setSelectDriver(truck);
                    });
                }(jQuery));

                function setTruckDropDown(supplyer) {
                    $("#truck_code option").remove();
                    $.post("/AutoComplete/GetTruckBySupplyer", {
                        code: supplyer
                    }, function(data) {
                        $('#truck_code').append("<option>-----เลือก-----</option>");
                        $.each(data.result, function(i, item) {
                            var option = "<option value='" + item.truck_code + "'>" + item.truck_license +
                                "</option>"
                            $('#truck_code').append(option)
                        });
                        if (sgfpplyer != 'SP18001') {
                            $('#truck_code').append("<option value='T000000'>ไม่ระบุ</option>");
                        }
                    });
                }

                function setDriverDropDown(supplyer) {
                    $("#driver_code option").remove();
                    $.post("/Order/GetDriverData", {

                    }, function(data) {
                        $('#driver_code').append("<option>-----เลือก-----</option>");
                        $.each(data.result, function(i, item) {
                            var option = "<option value='" + item.driver_code + "'>" + item.fullname +
                                "</option>"
                            $('#driver_code').append(option)
                        });
                        if (supplyer != 'SP18001') {
                            $('#driver_code').append("<option value='DV000000'>ไม่ระบุ</option>");
                        }
                    });
                }

                function setSelectDriver(truck) {
                    $.post("/Order/GetTruckDriverByTruckCode", {
                        code: truck
                    }, function(result) {
                        $('#driver_code').val(result.driver_code);
                    });
                }

                function OnValidate() {
                    var result = 0;
                    var e = $('#driver_cost');
                    var supplier = $('#supplyer_code').val();
                    var truck = $('#truck_code').val();
                    var driver = $('#driver_code').val();
                    var truck_element = $('#truck_code');
                    var driver_element = $('#driver_code');

                    if (supplier == 'SP18001') {
                        if (truck === '') {

                            truck_element.closest("div.form-group").addClass("has-error");
                            truck_element.closest('div.form-group').find('span.help-block').html('กรุณาเลือกทะเบียนรถ');
                            result++;
                        } else {
                            truck_element.closest("div.form-group").removeClass("has-error");
                            truck_element.closest('div.form-group').find('span.help-block').html('');
                        }

                        if (driver === '') {

                            driver_element.closest("div.form-group").addClass("has-error");
                            driver_element.closest('div.form-group').find('span.help-block').html('กรุณาเลือกทะเบียนรถ');
                            result++;
                        } else {
                            driver_element.closest("div.form-group").removeClass("has-error");
                            driver_element.closest('div.form-group').find('span.help-block').html('');
                        }
                    } else {
                        truck_element.closest("div.form-group").removeClass("has-error");
                        truck_element.closest('div.form-group').find('span.help-block').html('');

                        driver_element.closest("div.form-group").removeClass("has-error");
                        driver_element.closest('div.form-group').find('span.help-block').html('');
                    }

                    if (result === 0) {
                        overLayForm();
                        return true;
                    } else {
                        return false;
                    }
                }
        </script>
    }