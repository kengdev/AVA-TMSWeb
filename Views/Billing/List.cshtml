@{
    ViewBag.TopActive = "Billing";
    ViewBag.MidActive = "billing";
    ViewBag.SubActive = "listbilling";
    ViewBag.Title = "ข้อมูลการวางบิล";
}
@section Styles {
    <style>
        .dataTables_filter {
            display: none;
        }

        table.dataTable td, table.dataTable th {
            font-size: 13px !important;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">การวางบิล</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="javascript:;">รายการวางบิล</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/billing/list">รายการแจ้งหนี้ทั้งหมด</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> สรุปรายการวางบิล</span>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn-sm blue btn-circle btn-outline" onclick="getExcel()">
                        <i class="fad fa-download"></i> ดาวน์โหลด
                    </button>
                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-6">
                            </div>

                            <div class="col-md-6">
                                <div class="form-inline pull-right" role="form">
                                    <div class="form-group">
                                        @Html.DropDownList("month", null, new { @Class = "form-control dlListForm", Style = "width:120px;" })
                                    </div>
                                    <div class="form-group">
                                        @Html.DropDownList("year", null, new { @Class = "form-control dlListForm", Style = "width:90px;" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <table class="table table-striped table-bordered table-hover" id="table-billing">
                            <thead>
                                <tr>
                                    <th style="text-align:center!important;"></th>
                                    <th> วันที่</th>
                                    <th> รหัส</th>
                                    <th> ชื่อลูกค้า</th>
                                    <th> สถานที่</th>
                                    <th> จำนวน</th>
                                    <th> ยอดเงิน</th>
                                    <th> ประเภท</th>
                                    <th> สถานะ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr role="row" class="heading">
                                    <th class="filter"></th>
                                    <th class="filter"></th>
                                    <th class="filter"><input type="text" class="form-control filterText" id="filterCode" /></th>
                                    <th class="filter"><input type="text" class="form-control filterText" id="filterCustomer" /></th>
                                    <th class="filter"><input type="text" class="form-control filterText" id="filterMission" /></th>
                                    <th class="filter"></th>
                                    <th class="filter"></th>
                                    <th class="filter"></th>
                                    <th class="filter"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="finished-modal"></div>

@using (Html.BeginForm("Edit", "Billing", FormMethod.Post, new { id = "submit_edit" }))
{
    @Html.Hidden("billing_code")
}

@section scripts
{
    <script type="text/javascript">
        (function($) {
            var oTable = $('#table-billing').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[2, "desc"]],
                "sAjaxSource": "/Billing/GetAllBillingDataList",
                "fnRowCallback": function(row, aData, index) {
                    var status = '';
                    if (aData.is_clearing == true) {
                        status = '<span class="label label-sm label-success"> Completed </span>';
                    }
                    else {
                        status = '<span class="label label-sm label-danger"> Pending </span>';
                    }

                    if (aData.billing_type == "M") {
                        $('td', row).eq(7).addClass('mix');
                        $('td', row).eq(7).html('รวม');
                    }
                    else if (aData.billing_type == "T") {
                        $('td', row).eq(7).addClass('transport');
                        $('td', row).eq(7).html('ค่าเที่ยว');
                    }
                    else if (aData.billing_type == "A") {
                        $('td', row).eq(7).addClass('advance');
                        $('td', row).eq(7).html('ค่าใช้จ่าย');
                    }
                    else if (aData.billing_type == "O") {
                        $('td', row).eq(7).addClass('other');
                        $('td', row).eq(7).html('อื่น ๆ');
                    }

                    $('td', row).eq(8).html(status);
                    $('td', row).eq(6).html(number_format(aData.billing_total));
                },
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "month", "value": $("#month").val() });
                    aoData.push({ "name": "year", "value": $("#year").val() });
                    aoData.push({ "name": "filterMission", "value": $("#filterMission").val() });
                    aoData.push({ "name": "filterCustomer", "value": $("#filterCustomer").val() });
                    aoData.push({ "name": "filterCode", "value": $("#filterCode").val() });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-2-td text-center", targets: 0 },
                    { className: "date-td", targets: 1 },
                    { className: "code-td", targets: 2 },
                    { className: "name-td", targets: 3 },
                    { className: "name-td", targets: 4 },
                    { className: "amount-td", targets: 5 },
                    { className: "currency-td", targets: 6 },
                    { className: "type-td", targets: 7 },
                    { className: "code-td", targets: 8 }
                ],
                "columns":
                    [
                        {
                            "data": "billing_code", "orderable": false, "render": function(data, type, row) {
                                var detail = '<a href="javascript:;" class="btn btn-xs blue" data-title="รายละเอียด" data-toggle="tooltip" data-trigger="hover" onclick=setDetail("' + data + '","' + row.billing_type + '")><i class="fad fa-clipboard-list"></i></a>';
                                var print = '<a href="javascript:;" class="btn btn-xs grey" data-title="พิมพ์เอกสาร" data-toggle="tooltip" data-trigger="hover" onclick=doc_print("' + data + '","' + row.billing_type + '")><i class="fad fa-print"></i></a>';
                                var excel = '<a href="javascript:;" class="btn btn-xs green-jungle" data-title="ส่งออก Excel" data-toggle="tooltip" data-trigger="hover" onclick=doc_excel("' + data + '","' + row.billing_type + '")><i class="fad fa-file-excel"></i></a>';

                                return detail + print + excel;
                            }
                        },
                        { "data": "billing_date" },
                        { "data": "billing_code" },
                        { "data": "customer_name" },
                        { "data": "mission_name" },
                        { "data": "billing_amount", "orderable": false },
                        { "data": "billing_total", "orderable": false },
                        { "data": "billing_type", "orderable": false },
                        { "data": "is_clearing", "orderable": false }
                    ],
                "createdRow": function(row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-billing tfoot tr').appendTo('#table-billing thead');

            $('.filterText').keyup(function() {
                $('#table-billing').dataTable()._fnAjaxUpdate();
            });

            $('.dlListForm').change(function() {
                $('#table-billing').dataTable()._fnAjaxUpdate();
            });
        }(jQuery));

        function doc_print(code, type) {
            var url = "";
            if (type == "M") {
                url = '/formbilling/allpdf?code=' + code;
            }
            else if (type == "T") {
                url = '/formbilling/transportpdf?code=' + code;
            }
            else if (type == "O") {
                url = '/formbilling/otherpdf?code=' + code;
            }
            else {
                url = '/formbilling/advancepdf?code=' + code;
            }

            window.open(url, 'form billing');
        }

        function doc_excel(code, type) {
            var url = "";
            if (type == "M") {
                url = '/export/all?code=' + code;
            }
            else if (type == "T") {
                url = '/export/transport?code=' + code;
            }
            else if (type == "O") {
                url = '/export/other?code=' + code;
            }
            else {
                url = '/export/advance?code=' + code;
            }

            window.open(url, 'form billing');
        }

        function getExcel() {

            var month = $('#month').val();
            var year = $('#year').val();
            var filterMission = $("#filterMission").val();
            var filterCustomer = $("#filterCustomer").val();
            var filterCode = $("#filterCode").val();

            var url = '/Export/GetBillingPDFList?month=' + month + '&year=' + year + '&filterMission=' + filterMission + '&filterCustomer=' + filterCustomer + '&filterCode=' + filterCode;
            window.open(url, 'form list');
        }

        function doc_export(code, type) {
            window.open("/app/RPTReport/GetBillingListReport?type=" + type + "&code=" + code);
        }

        function setDetail(code, type) {
            if (type == 'O') {
                url = '/billing/detailother?code=' + code;
                setting = 'width=1200,height=634';
            }
            else {
                url = '/billing/detail?code=' + code;
                setting = 'width=1200,height=634';
            }

            window.open(url, 'Detail Billing', setting);
        }

        function reloadRow() {
            $("#table-billing").DataTable().ajax.reload();
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}
