@model List<TMSWeb.Models.ViewModels.BillingViewModel>
@{
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
    ViewBag.Title = "รายละเอียดรายการวางบิล";
    var data = Model.FirstOrDefault();
    var total = Model.Sum(s => s.cost_value);
    var amount = Model.Count();
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
    <style>
        .todo-tasklist {
            padding-left: 20px;
        }

        .action-td {
            text-align: center;
            width: 150px;
        }

        .highlight {
            border-left: none !important;
        }

        .table td {
            font-size: 13px !important;
        }

        th {
            font-size: 13px !important;
            font-weight: bold !important;
            text-align: center !important;
        }

        table.dataTable thead td {
            border-bottom: 0;
        }

        table.dataTable tfoot td {
            border-top: 0;
        }

        th,
        td {
            font-size: 13px !important;
        }

            td.topic {
                width: 150px !important;
            }

        .value-content {
            width: 80px;
            display: inline-block;
            margin-right: 15px;
        }

        .rate {
            padding: 0 !important;
            height: 25px;
            padding-left: 5px !important;
            display: none;
        }

        .btnEdit,
        .btnEditAdvance {
            color: #c4b505;
        }

        .btnSave {
            display: none;
            font-size: 16px !important;
        }

        .btnCancel {
            display: none;
            color: red;
            font-weight: bold;
            font-size: 16px !important;
        }

        .title-modal {
            width: 100%;
            height: 32px;
            background-color: #0094ff;
            padding: 5px;
            padding-top: 7px;
            color: #fff;
            font-weight: bold;
            font-size: 13px;
        }

        .actions-modal {
            width: 100%;
            background-color: #e6e6e6;
            padding: 10px;
            color: #fff;
            font-weight: bold;
            font-size: 13px;
        }

        a.close-modal {
            color: #337ab7 !important;
            font-weight: normal;
            font-size: 14px;
        }
    </style>
}
<div class="col-md-12">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-clipboard-list"></i>
                <span class="caption-subject bold small">รายละเอียดการวางบิล</span>
                <span class="caption-helper">[เลขที่ @data.billing_code]</span>
            </div>
            <div class="actions">
                <div class="btn-group btn-group-devided" data-toggle="buttons">
                </div>
            </div>
        </div>
        <div class="portlet-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-scrollable table-scrollable-borderless">
                        <table class="table table-light">
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">เลขที่</span>
                                </td>
                                <td> @data.billing_code</td>
                            </tr>
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">ประเภท</span>
                                </td>
                                <td>
                                    @if (data.billing_type == "M")
                                    {
                                        <span>รวม</span>
                                    }
                                    else if (data.billing_type == "T")
                                    {
                                        <span>ค่าขนส่ง</span>
                                    }
                                    else if (data.billing_type == "A")
                                    {
                                        <span>สำรองจ่าย</span>
                                    }
                                    else if (data.billing_type == "O")
                                    {
                                        <span>สำรองจ่ายอื่น ๆ</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">ลูกค้า</span>
                                </td>
                                <td> @data.customer_name</td>
                            </tr>
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">สถานที่</span>
                                </td>
                                <td> @data.mission_name</td>
                            </tr>
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">วันที่</span>
                                </td>
                                <td> @data.billing_date_value.ToString("dd MMMM yyyy") </td>
                            </tr>

                        </table>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <table data-toggle="table" id="list-detail" data-height="300">
                        <thead>
                            <tr>
                                <th data-align="center" data-width="150">วันที่</th>
                                <th data-align="center" data-width="190">Booking</th>
                                <th data-align="center" data-width="190">Container</th>
                                <th data-align="left" data-width="">รายการ</th>
                                <th data-align="right" data-width="170">ยอดเงิน</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.job_date</td>
                                    <td><span class="font-small">@item.booking_no</span></td>
                                    <td><span class="font-small">@item.container_no</span></td>
                                    <td><span class="font-small">@item.advance_other</span></td>
                                    <td>
                                        <div class="value-content">
                                            <span>@item.advance_value.ToString("#,##0.00")</span>
                                            <input type="text" value="@item.advance_value"
                                                   class="form-control rate" />
                                        </div>
                                        <div style="display:inline-block">
                                            <a href="javascript:;" class="btnEdit" onclick="edittransport(this)">
                                                <i class='fad fa-pencil'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnSave"
                                               onclick="save(this, '@item.id')">
                                                <i class='fa fa-save'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnCancel" onclick="cancel(this)">
                                                <i class="fa fa-times"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal-update-form" style="display:none;">
    @using (Html.BeginForm("EditAdvanceDetailData", "Billing", FormMethod.Post, new
    {
        id = "frmEdit",
        onsubmit =
    "return OnValidate()"
    }))
    {
        <div id="form-content">
            <div style="width:550px;">
                <div class="title-modal">
                    แก้ไขรายการเงินสำรองจ่าย
                </div>
                <br />
                <input type="hidden" name="billing_code" value="@data.billing_code" />
                <input type="hidden" name="AdvanceCode" id="txtAdvance" />
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>ค่าผ่านลาน/ผ่านท่า</label>
                                <input type="text" id="txtYard" name="AdvanceYard" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>ค่าผ่านลาน/ผ่านท่า</label>
                                <input type="text" id="txtPort" name="AdvancePort" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <input type="text" id="txtLiftOn" name="AdvanceLiftOn" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <input type="text" id="txtLiftOff" name="AdvanceLiftOff" class="form-control" />
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="actions-modal pull-right">
            <div style="width:100%;text-align:right;">
                <a class="close-modal" onclick="closeModal()" href="javascript:;">ยกเลิก</a> |
                <button type="submit" class="btn btn-info">บันทึกข้อมูล</button>
            </div>
        </div>
    }
</div>
@section scripts
{
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            $("#frmEdit").ajaxForm(function(data) {
                unoverLay();
                if (data.result === true) {
                    $.alert.open('info', "บันทึกข้อมูลเรียบร้อยแล้ว", function(r) {
                        window.opener.reloadRow();
                        window.location.reload();
                        closeModal();
                    });
                } else {
                    $.alert.open('error',
                        "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>"
                    );
                }
            });
        });

        function cancel(item) {
            $(item).hide();
            $(item).prev().hide();
            $(item).prev().prev().show();
            $(item).closest('td').find('.rate').hide();
            $(item).closest('td').find('span').show();
        }

        function edittransport(item) {
            $(item).closest('td').find('span').hide()
            $(item).closest('td').find('.rate').show();
            $(item).hide();
            $(item).next().show();
            $(item).next().next().show();
        }

        function save(item, id) {
            var x = $(item).closest('td').find('.rate').val();
            $(item).next().hide();
            $(item).prev().hide();
            $(item).hide();
            $(item).closest('div').prev().html('<div class="spin-item"><div class="loader10-sm"></div></div>');

            $.post("/billing/EditAdvanceOtherDetailData", {
                value: x,
                id: id
            }, function(data) {
                if (data.result == true) {
                    window.opener.reloadRow();
                    window.location.reload();
                } else {
                    jAlert('ผลการทำงาน',
                        "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>"
                    );
                    reloadRow();
                }
            });
        }
    </script>
}