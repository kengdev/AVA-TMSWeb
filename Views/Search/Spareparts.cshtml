@{
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
}
@section Styles{
    <style>
        table.dataTable td, table.dataTable th {
            font-size: 13px !important;
        }

        .cancelItem {
            text-decoration: line-through;
            text-decoration-color: red;
            color: #b4b4b4;
        }
        .dataTables_filter {
            display: inline!important;
        }
    </style>
}
<div class="col-lg-12">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption font-dark">
                <i class="icon-list font-dark"></i>
                <span class="caption-subject bold uppercase"> รายการวัสดุในคลัง</span>
            </div>
            <div class="actions">
            </div>
        </div>
        <div class="portlet-body">
            <table class="table table-striped table-bordered table-hover table-checkable order-column" id="table-sparepart">
                <thead>
                    <tr>
                        <th></th>
                        <th> รายการ</th>
                        <th> ราคาต่อหน่วย</th>
                        <th> จำนวนคงเหลือ</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        (function ($) {
            var oTable = $('#table-sparepart').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[3, "desc"]],
                "sAjaxSource": "/Search/GetSparepartDataList",
                "fnServerParams": function (aoData) {

                },
                "fnRowCallback": function (row, aData, index) {

                    if (aData.type == 'A') {
                        $('td', row).eq(2).html(number_format(aData.price) + ' บาท');
                        $('td', row).eq(3).html(aData.quantity + ' ' + aData.unit);
                        if (aData.quantity < 1) {
                            $('td', row).addClass('cancelItem');
                        }
                    }
                    else {
                        $('td', row).eq(2).html('-');
                        $('td', row).eq(3).html('-');
                    }
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-td text-center", targets: 0 },
                    { className: "name-td", targets: 1 },
                    { className: "currency-td", targets: 2 },
                    { className: "currency-td", targets: 3 }
                ],
                "columns":
                    [
                        {
                            "data": "sparepart_code", "orderable": false, "render": function (data, type, row) {
                                var load = '<a href="javascript:;" data-title="ใช้ข้อมูลนี้"  data-toggle="tooltip" data-trigger="hover" onclick=setValue("' + data + '")><i class="fad fa-link"></i></a>';
                                return load
                            }
                        },
                        { "data": "sparepart_name" },
                        { "data": "price" },
                        { "data": "quantity" }
                    ],
                "createdRow": function (row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });
        }(jQuery));

        function setValue(code) {
            window.opener.setSparepartBox(code);
            self.close();
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}