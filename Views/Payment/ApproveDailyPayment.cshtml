@{
    ViewBag.TopActive = "File";
    ViewBag.MidActive = "payment";
    ViewBag.SubActive = "dailypayment";
    ViewBag.Title = "รายการเบิกจ่ายเงินรายวัน";
}
@section Styles {
    <style>
        table.dataTable td,
        table.dataTable th {
            font-size: 13px !important;
        }

        .dataTables_filter {
            display: none;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }

        .dropdown-menu {
            left: auto, important !important;
            right: 0 !important;
        }

        .dropdown-td {
            width: 81px !important;
            padding-top: 11px !important;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">การเบิกจ่ายเงิน</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/payment/dailypayment/">รายวัน</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> รายการเบิกจ่ายรายวัน </span>
                </div>
                <div class="actions">
                    <div class="clearfix">
                        <div class="btn-group btn-group-circle">
                            <button type="button" class="btn btn-outline blue btn-sm" onclick="setBalance()">
                                <i class="fad fa-money-check-alt"></i> รับยอด-จ่ายออก
                            </button>
                            <div class="btn-group">
                                <button type="button"
                                        class="btn btn-outline blue btn-circle-right dropdown-toggle btn-sm"
                                        data-toggle="dropdown">
                                    <i class="fad fa-download"></i> ดาวน์โหลด
                                    <i class="fa fa-angle-down"></i>
                                </button>
                                <ul class="dropdown-menu pull-right">
                                    <li>
                                        <a href="javascript:;" data-action="0" class="tool-action font-sm" onclick="setExcel()">
                                            <i class="fad fa-person-dolly font-lg"></i> รายการงานรอเอกสาร
                                        </a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" data-action="0" class="tool-action font-sm" onclick="setPaymentExcel()">
                                            <i class="fad fa-money-check-edit-alt font-lg"></i> รายการจ่ายเงิน
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="portlet-body table-both-scroll">
                <div class="row">
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-6">
                        <div class="form-inline pull-right">
                            <div class="form-group">
                                @Html.DropDownList("month", null, new
                                {
                                    @Class = "form-control dlListForm",
                                    Style =
                                "width:120px;"
                                })
                            </div>
                            <div class="form-group">
                                @Html.DropDownList("year", null, new
                                {
                                    @Class = "form-control dlListForm",
                                    Style =
                                "width:90px;"
                                })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-striped table-bordered table-hover table-checkable order-column"
                               id="table-receipt">
                            <thead>
                                <tr>
                                    <th style="text-align: right!important;padding-right:5px;" colspan="5">ยอดคงเหลือ</th>
                                    <th style="text-align: right!important;">
                                        @if (Model.Balance > 0)
                                        {
                                            <span class="font-green-jungle font-md bold">@Model.Balance.ToString("฿#,##0.00")</span>
                                        }
                                        else
                                        {
                                            <span class="font-red-mint bold">@Model.Balance.ToString("฿#,##0.00")</span>
                                        }
                                    </th>
                                </tr>
                                <tr>
                                    <th></th>
                                    <th> วันที่/เวลา</th>
                                    <th> เลขที่</th>
                                    <th> ผู้ขออนุมัติ</th>
                                    <th> ยอดเงิน</th>
                                    <th> สถานะ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr role="row" class="heading">
                                    <th class="filter"></th>
                                    <th class="filter"></th>
                                    <th class="filter"><input type="text" class="form-control filterText" id="filterCode" /></th>
                                    <th class="filter"><input type="text" class="form-control filterText" id="filterCustomer" /></th>
                                    <th class="filter"></th>
                                    <th class="filter"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/Scripts/default/jQuery.print.js"></script>
    <script type="text/javascript">
        (function($) {
            var oTable = $('#table-receipt').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[2, "desc"]],
                "sAjaxSource": "/Payment/GetAllDailyDataList",
                "fnRowCallback": function(row, aData, index) {
                    $('td', row).eq(4).html(number_format(aData.total));
                    if (aData.approve_status == 'A') {
                        $('td', row).eq(5).addClass('approved');
                        $('td', row).eq(5).html('อนุมัติ');
                    }
                    else if (aData.approve_status == 'R') {
                        $('td', row).eq(5).addClass('pending');
                        $('td', row).eq(5).html('ไม่อนุมัติ');
                    }
                },
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "month", "value": $("#month").val() });
                    aoData.push({ "name": "year", "value": $("#year").val() });
                    aoData.push({ "name": "filterCode", "value": $("#filterCode").val() });
                    aoData.push({ "name": "filterCustomer", "value": $("#filterCustomer").val() });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-3-td text-center", targets: 0 },
                    { className: "dropdown-td text-left", targets: 1 },
                    { className: "date-td", targets: 2 },
                    { className: "name-td", targets: 3 },
                    { className: "currency-td", targets: 4 },
                    { className: "dropdown-td text-left", targets: 5 }
                ],
                "columns":
                    [
                        {
                            "data": "payment_id", "orderable": false, "render": function(data, type, row) {
                                var print = '<a  class="btn btn-xs grey" href="javascript:;" data-title="พิมพ์เอกสาร"  data-toggle="tooltip" data-trigger="hover" onclick=setPrint("' + data + '","' + row.payment_type + '")><i class="fad fa-print"></i></a>';
                                var remove = '<a class="btn btn-xs red" href="javascript:;" data-title="ลบ"  data-toggle="tooltip" data-trigger="hover" onclick=setRemove("' + data + '")><i class="fad fa-trash"></i></a>';
                                if (row.approve_status == 'W') {
                                    return remove + print;
                                }
                                else {
                                    return print;
                                }
                            }
                        },
                        { "data": "payment_date" },
                        { "data": "payment_id" },
                        { "data": "payment_name" },
                        { "data": "total", "orderable": false },
                        {
                            "data": "approve_status", "orderable": false, "render": function(data, type, row) {
                                var action = '<div class="btn-group dropup">';
                                action += '<button class="btn btn-xs blue dropdown-toggle" type="button" data-toggle="dropdown" aria-expanded="false"> รอดำเนินการ ';
                                action += '<i class="fa fa-angle-down"></i>';
                                action += '</button>';
                                action += '<ul class="dropdown-menu pull-right" role="menu">';
                                action += '<li><a href="javascript:;" onclick=setApprove("' + row.payment_id + '")><i class="fa fa-check"></i> อนุมัติ </a></li>';
                                action += '<li class="divider"> </li>';
                                action += '<li><a href="javascript:;" onclick=setReject("' + row.payment_id + '")><i class="fa fa-times"></i> ไม่อนุมัติ </a></li>';

                                action += '</ul></div>';

                                return action
                            }
                        }
                    ],
                "createdRow": function(row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-receipt tfoot tr').appendTo('#table-receipt thead');

            $('.filterText').keyup(function() {
                $('#table-receipt').dataTable()._fnAjaxUpdate();
            });

            $('.dlListForm').change(function() {
                $('#table-receipt').dataTable()._fnAjaxUpdate();
            });
        }(jQuery));

        function setPrint(code, type) {
            var url = '/formava/dailypayment?code=' + code;
            window.open(url, '_blank');
        }

        function setEdit(code, type) {
            var url = '/payment/editdailypayment?code=' + code;
            var setting = 'width=1250,height=782';

            window.open(url, 'edit payment', setting);
        }

        function setAddDailyPayment() {
            var url = '/payment/adddailypayment';
            var setting = 'width=1250,height=782';

            window.open(url, 'add payment', setting);
        }

        function setAddMonthlyPayment() {
            var url = '/payment/addmonthlypayment';
            var setting = 'width=1250,height=782';

            window.open(url, 'add payment', setting);
        }

        function reloadRow() {
            $("#table-receipt").DataTable().ajax.reload();
        }

        function setBalance() {
            var url = '/budget/setgebalance';
            var setting = 'width=1100,height=672';

            window.open(url, 'Status Station', setting);
        }

        function setRemove(code) {
            $.alert.open('confirm', 'คุณต้องการลบข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Payment/RemoveDailyPayment",
                        {
                            code: code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function(r) {
                                    $('#table-receipt').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                jAlert('ผลการทำงาน', data.resultMessage);
                            }
                        });
                }
            });
        }

        function setApprove(code) {
            $.alert.open('confirm', 'คุณต้องการ อนุมัติข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Payment/ApproveDailyPayment",
                        {
                            code: code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function(r) {
                                    $('#table-receipt').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                jAlert('ผลการทำงาน', data.resultMessage);
                            }
                        });
                }
            });
        }

        function setReject(code) {
            $.alert.open('confirm', 'คุณต้องการ ปฏิเสธการอนุมัติข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Payment/RejectDailyPayment",
                        {
                            code: code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function(r) {
                                    $('#table-receipt').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                jAlert('ผลการทำงาน', data.resultMessage);
                            }
                        });
                }
            });
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}
