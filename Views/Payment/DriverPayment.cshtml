@{
    ViewBag.TopActive = "Allowance";
    ViewBag.MidActive = "driverpayment";
    ViewBag.SubActive = "drivertrip";
    ViewBag.Title = "รายการจ่ายเงินพนักงานขับรถ";
}
@section Styles {
    <style>
        table.dataTable td,
        table.dataTable th {
            font-size: 13px !important;
        }

        .dataTables_filter {
            display: none;
        }

        .action-td {
            width: 30px !important;
            text-align: center;
        }

        .name-td {
            text-align: left;
        }

        .gender-td {
            width: 40px !important;
            text-align: center;
        }

        .age-td {
            text-align: right;
            width: 40px !important;
        }

        .currency {
            text-align: right;
        }

        .date-td {
            width: 90px !important;
            text-align: center;
        }

        .phone-td {
            width: 90px !important;
            text-align: center;
        }

        td.details-control {
            background: url('/images/details_open.png') no-repeat center center;
            cursor: pointer;
        }

        tr.shown td.details-control {
            background: url('/images/details_close.png') no-repeat center center;
        }

        .table-detail {
            border-collapse: collapse;
            border-bottom: 1px solid #ccc;
            width: 100%;
        }

            .table-detail th {
                text-align: center;
            }

            .table-detail td,
            .table-detail th {
                border: 1px solid #ccc;
            }

                .table-detail td.name {
                    text-align: left;
                }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }

        td.action {
            width: 120px;
        }

        td.approve {
            background: #4c9ef7
        }

        td.pending {
            background-color: #ffa1a1
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">ทำจ่าย</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="javascript:;">ค่าเที่ยวพนักงานขับรถ</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/payment/driverpayment">ข้อมูลค่าเที่ยวพนักงานขับรถ</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> รายการจ่ายเงินค่าเที่ยวพนักงานขับรถ</span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-6">
                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right" role="form">
                            <div class="form-group">
                                @Html.DropDownList("month", null, new
                                {
                                    @Class = "form-control dlListForm",
                                    Style =
                                "width:120px;"
                                })
                            </div>
                            <div class="form-group">
                                @Html.DropDownList("year", null, new
                                {
                                    @Class = "form-control dlListForm",
                                    Style =
                                "width:90px;"
                                })
                            </div>
                            |
                            <button type="button" class="btn btn-transparent red btn-outline btn-sm active"
                                    onclick="setAdd()">
                                ทำรายการ
                            </button>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-striped table-bordered  table-checkable order-column" id="table-driver">
                            <thead>
                                <tr>
                                    <th style="width:100px!important;"></th>
                                    <th></th>
                                    <th>รอบการจ่ายเงินวันที่</th>
                                    <th>ยอดรวม</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function() {
            var oTable = $('#table-driver').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[2, "desc"]],
                "sAjaxSource": "/payment/GetDriverList",
                "fnRowCallback": function(row, aData, index) {
                    $('td', row).eq(2).html(aData.start_date_text + ' - ' + aData.end_date_text);
                    $('td', row).eq(3).html(number_format(aData.allowance_total));
                },
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "month", "value": $("#month").val() });
                    aoData.push({ "name": "year", "value": $("#year").val() });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-td", targets: 0 },
                    { className: "action-2-td", targets: 1 },
                    { className: "name-td", targets: 2 },
                    { className: "currency-td", targets: 3 }
                ],
                "columns":
                    [
                        {
                            "className": 'details-control',
                            "orderable": false,
                            "data": null,
                            "defaultContent": ''
                        },
                        {
                            "data": "start_date_text", "orderable": false, "render": function(data, type, row) {
                                var print = '<a class="btn btn-xs default" href="javascript:;" data-title="พิมพ์ใบจ่ายเงิน"  data-toggle="tooltip" data-trigger="hover" onclick=printAll("' + row.start_date_form + '","' + row.end_date_form + '")><i class="fad fa-print"></i></a>';
                                return print;
                            }
                        },
                        { "data": "start_date_text" },
                        { "data": "allowance_total" },
                    ],
                "createdRow": function(row, data, dataIndex) {

                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('.dlListForm').change(function() {
                $('#table-driver').dataTable()._fnAjaxUpdate();
            });

            $('#table-driver tbody').on('click', 'td.details-control', function() {
                var tr = $(this).closest('tr');
                var row = oTable.row(tr);
                if (row.child.isShown()) {
                    // This row is already open - close it
                    row.child.hide();
                    tr.removeClass('shown');
                }
                else {
                    // Open this row
                    row.child(format(row.data())).show();
                    SetDetail(row.data().start_date_form);
                    tr.addClass('shown');
                }
            });
        });

        function setRemove(start_date) {
            $.alert.open('confirm', 'คุณต้องการลบข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Payment/RemoveDriverTrip",
                        {
                            start_date: start_date
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', "จัดการข้อมูลเรียบร้อยแล้ว", function(r) {
                                    $('#table-driver').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                jAlert('ผลการทำงาน', "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>");
                            }
                        });
                }
            });
        }

        function SetDetail(start_date) {
            var t = '<table class="table-detail"><tr><th>ชื่อ-นามสกุล</th><th>ทะเบียน</th><th>ยอดรวม</th><th></th></tr>';
            var row = '';
            $.post("/Payment/GetDriverPaymentByDate",
                {
                    start_date: start_date
                }, function(data) {
                    $.each(data.query, function(i, item) {
                        var truck = item.truck_license != null ? item.truck_license + " [" + item.truck_no + "]" : "-";
                        row += '<tr><td class="name">' + item.driver_fullname + '</td><td>' + truck + '</td><td class="currency">' + number_format(item.allowance_total) + '</td>';

                        row += '<td class="action"><a class="btn btn-xs grey" href="javascript:;" onclick=printAllowance("' + item.allowance_code + '","' + item.driver_code + '")><i class="fad fa-print"></i></a>';
                        row += '<a class="btn btn-xs blue" href="javascript:;" onclick=detailAllowance("' + item.allowance_code + '","' + item.driver_code + '")><i class="fad fa-clipboard-list"></i></a>';
                        row += '<a class="btn btn-xs red" href="javascript:;" onclick=removeAllowance("' + item.allowance_code + '")><i class="fad fa-trash"></i></a></td></tr>';
                    });

                    t += row + '</table>';
                    $('#detail-row').html(t);
                });
        }

        function format(d) {
            return '<div id="detail-row"><img src="/images/loading-spinner-grey.gif" /></div>';
        }

        function printAll(start, end) {
            var url = '/form/driverpaymentlist?start=' + start + '&end=' + end;
            window.open(url, 'print allowance');
        }

        function printAllowance(allowance_code, driver_code) {
            var url = '/form/driverpayment?code=' + allowance_code + '&driver_code=' + driver_code;

            window.open(url, 'print allowance');
        }

        function detailAllowance(allowance_code, driver_code) {
            var url = '/payment/driverpaymentdetail?allowance_code=' + allowance_code + '&driver_code=' + driver_code;
            var setting = 'width=1080,height=647';

            window.open(url, 'detail allowance', setting);
        }

        function removeAllowance(code) {
            $.alert.open('confirm', 'คุณต้องการลบข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Payment/RemoveDriverPayment",
                        {
                            code: code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $('#table-driver').dataTable()._fnAjaxUpdate();
                            } else {
                                $.alert.open('error', "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>");
                            }
                        });
                }
            });
        }

        function reloadRow() {
            $("#table-driver").DataTable().ajax.reload();
        }

        function setAdd() {
            var url = '/payment/adddriverpayment';
            var setting = 'width=1080,height=653';

            window.open(url, 'add driver', setting);
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}
