@model TMSWeb.Models.ViewModels.FleetPaymentViewModel
@{
    var list = (List<TMSWeb.Models.ViewModels.JobViewModel>)ViewBag.List;
}
@{
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
    var data = list.FirstOrDefault();
    var total = list.Sum(s => s.cost_value);
    var amount = list.Count();
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
    <style>
        .todo-tasklist {
            padding-left: 20px;
        }

        .action-td {
            text-align: center;
            width: 150px;
        }

        .highlight {
            border-left: none !important;
        }

        .table td {
            font-size: 13px !important;
        }

        th {
            font-size: 13px !important;
            font-weight: bold !important;
            text-align: center !important;
        }

        table.dataTable thead td {
            border-bottom: 0;
        }

        table.dataTable tfoot td {
            border-top: 0;
        }

        th,
        td {
            font-size: 13px !important;
        }

        .value-content {
            width: 80px;
            display: inline-block;
            margin-right: 15px;
        }

        .rate {
            padding: 0 !important;
            height: 25px;
            padding-left: 5px !important;
            display: none;
        }

        .btnEdit,
        .btnEditAdvance {
            color: #c4b505;
        }

        .btnSave {
            display: none;
        }

        .btnCancel {
            display: none;
            color: red;
            font-weight: bold;
        }

        .title-modal {
            width: 100%;
            height: 32px;
            background-color: #0094ff;
            padding: 5px;
            padding-top: 7px;
            color: #fff;
            font-weight: bold;
            font-size: 13px;
        }

        .actions-modal {
            width: 100%;
            background-color: #e6e6e6;
            padding: 10px;
            color: #fff;
            font-weight: bold;
            font-size: 13px;
        }

        a.close-modal {
            color: #337ab7 !important;
            font-weight: normal;
            font-size: 14px;
        }

        .total .right {
            text-align: right;
            width: 180px;
        }

        .total .topic {
            text-align: right;
        }

        h2 {
            font-size: 14px;
            font-weight: bold;
        }
    </style>
}
<div class="col-md-12">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-clipboard-list"></i>
                <span class="caption-subject bold uppercase"> รายละเอียดการจ่ายเงิน</span>
                <span class="caption-helper">[เลขที่ @Model.code]</span>
            </div>
            <div class="actions">
                <div class="btn-group btn-group-devided" data-toggle="buttons">
                </div>
            </div>
        </div>
        <div class="portlet-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="invoice-content-2 bordered">
                        <div class="row invoice-cust-add">
                            <div class="col-xs-4">
                                <h2 class="invoice-title uppercase">ทะเบียน</h2>
                                <p class="invoice-desc">@Model.supplier_name</p>
                            </div>
                            <div class="col-xs-3">
                                <h2 class="invoice-title uppercase">รอบเดือน</h2>
                                <p class="invoice-desc inv-address">@Model.month @Model.year</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <table data-toggle="table" id="list-detail" data-height="321">
                        <thead>
                            <tr>
                                <th data-align="center">วันที่</th>
                                <th data-align="center" data-width="140">คอนเทนเนอร์</th>
                                <th data-align="center" data-width="140">โรงงาน</th>
                                <th data-align="right" data-width="150">ค่าขนส่ง</th>
                                <th data-align="right" data-width="150">ค่าเที่ยว</th>
                                <th data-align="right" data-width="150">ค่าทางด่วน</th>
                                <th data-align="right" data-width="150">น้ำมัน (ลิตร)</th>
                                <th data-align="right" data-width="90">น้ำมัน (บาท)</th>
                                <th data-align="right" data-width="80">รวม</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in list)
                            {
                                <tr>
                                    <td>@item.job_date_value.ToString("MMM, dd").ToUpper()</td>
                                    <td><span class="font-small">@item.container_no</span></td>
                                    <td><span class="font-small">@item.mission_name</span></td>
                                    <td>
                                        <div class="value-content">
                                            <span>@item.transport_value.ToString("#,##0.00")</span>
                                            <input type="text" value="@item.transport_value"
                                                   class="form-control rate" />
                                        </div>
                                        <div style="display:inline-block">
                                            <a href="javascript:;" class="btnEdit"
                                               onclick="editTransport(this)">
                                                <i class='fad fa-pencil'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnSave"
                                               onclick="saveTransport(this, '@item.job_detail_code')">
                                                <i class='fad fa-save'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnCancel" onclick="cancelTransport(this)">
                                                <i class="fa fa-times"></i>
                                            </a>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="value-content">
                                            <span>@item.trip_value.ToString("#,##0.00")</span>
                                            <input type="text" value="@item.trip_value"
                                                   class="form-control rate" />
                                        </div>
                                        <div style="display:inline-block">
                                            <a href="javascript:;" class="btnEdit"
                                               onclick="editTrip(this)">
                                                <i class='fad fa-pencil'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnSave"
                                               onclick="saveTrip(this, '@item.job_detail_code')">
                                                <i class='fad fa-save'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnCancel"
                                               onclick="cancelTrip(this)"><i class="fa fa-times"></i></a>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="value-content">
                                            <span>@item.express_value.ToString("#,##0.00")</span>
                                            <input type="text" value="@item.express_value"
                                                   class="form-control rate" />
                                        </div>
                                        <div style="display:inline-block">
                                            <a href="javascript:;" class="btnEdit"
                                               onclick="editExpress(this)">
                                                <i class='fad fa-pencil'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnSave"
                                               onclick="saveExpress(this, '@item.job_detail_code')">
                                                <i class='fad fa-save'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnCancel"
                                               onclick="cancelExpress(this)"><i class="fa fa-times"></i></a>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="value-content">
                                            <span>@item.fuel_litre.ToString("#,##0.00")</span>
                                            <input type="text" value="@item.fuel_litre"
                                                   class="form-control rate" />
                                        </div>
                                        <div style="display:inline-block">
                                            <a href="javascript:;" class="btnEdit"
                                               onclick="editFuel(this)">
                                                <i class='fad fa-pencil'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnSave"
                                               onclick="saveFuel(this, '@item.job_detail_code')">
                                                <i class='fad fa-save'></i>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:;" class="btnCancel"
                                               onclick="cancelFuel(this)"><i class="fa fa-times"></i></a>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="padding-right: 3px!important;">@item.fuel_value.ToString("#,##0.00")</span>
                                    </td>
                                    <td style="text-align: right;">
                                        <span style="padding-right: 3px!important;">@item.payment_value.ToString("#,##0.00")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="table-scrollable table-scrollable-borderless">
                        <table class="table table-light total">
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">เงินเดือน</span>
                                </td>
                                <td class="right"> @Model.salary.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">ค่าบริการ ช.</span>
                                </td>
                                <td class="right"> @Model.shore.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">ค่าเช่าลาน</span>
                                </td>
                                <td class="right"> @Model.area.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">ค่าซ่อมบำรุง</span>
                                </td>
                                <td class="right"> @Model.maintenance.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
                                <td class="topic">
                                    <span class="font-green-sharp">ยอดรวม</span>
                                </td>
                                <td class="right"> @Model.net_total.ToString("#,##0.00")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts
{
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        function cancelTransport(item) {
            $(item).hide();
            $(item).prev().hide();
            $(item).prev().prev().show();
            $(item).closest('td').find('span').show();
            $(item).closest('td').find('.rate').hide();
        }

        function editTransport(item) {
            $(item).closest('td').find('span').hide();
            $(item).closest('td').find('.rate').show();
            $(item).hide();
            $(item).next().show();
            $(item).next().next().show();
        }

        function editExpress(item) {
            $(item).closest('td').find('span').hide();
            $(item).closest('td').find('.rate').show();
            $(item).hide();
            $(item).next().show();
            $(item).next().next().show();
        }

        function cancelTrip(item) {
            $(item).hide();
            $(item).prev().hide();
            $(item).prev().prev().show();
            $(item).closest('td').find('span').show();
            $(item).closest('td').find('.rate').hide();
        }

        function editTrip(item) {
            $(item).closest('td').find('span').hide();
            $(item).closest('td').find('.rate').show();
            $(item).hide();
            $(item).next().show();
            $(item).next().next().show();
        }

        function cancelFuel(item) {
            $(item).hide();
            $(item).prev().hide();
            $(item).prev().prev().show();
            $(item).closest('td').find('span').show();
            $(item).closest('td').find('.rate').hide();
        }

        function editFuel(item) {
            $(item).closest('td').find('span').hide();
            $(item).closest('td').find('.rate').show();
            $(item).hide();
            $(item).next().show();
            $(item).next().next().show();
        }

        function cancelExpress(item) {
            $(item).hide();
            $(item).prev().hide();
            $(item).prev().prev().show();
            $(item).closest('td').find('span').show();
            $(item).closest('td').find('.rate').hide();
        }

        function closeModal() {
            $.modal.close();
        }

        function saveTransport(item, job_detail_code) {
            var x = $(item).closest('td').find('.rate').val();
            $(item).next().hide();
            $(item).prev().hide();
            $(item).hide();
            $(item).closest('div').prev().html('<div class="spin-item"><div class="loader10-sm"></div></div>');

            $.post("/Payment/EditFleetTransportCost", {
                value: x,
                job_detail_code: job_detail_code
            }, function(data) {
                if (data.result) {
                    window.opener.reloadRow();
                    window.location.reload();
                }
            });
        }

        function saveTrip(item, job_detail_code) {
            var x = $(item).closest('td').find('.rate').val();
            $(item).next().hide();
            $(item).prev().hide();
            $(item).hide();
            $(item).closest('div').prev().html('<div class="spin-item"><div class="loader10-sm"></div></div>');

            $.post("/Payment/EditFleetTripCost", {
                value: x,
                job_detail_code: job_detail_code
            }, function(data) {
                if (data.result) {
                    window.opener.reloadRow();
                    window.location.reload();
                }
            });
        }

        function saveFuel(item, job_detail_code) {
            var x = $(item).closest('td').find('.rate').val();
            $(item).next().hide();
            $(item).prev().hide();
            $(item).hide();
            $(item).closest('div').prev().html('<div class="spin-item"><div class="loader10-sm"></div></div>');

            $.post("/Payment/EditFleetFuelCost", {
                value: x,
                job_detail_code: job_detail_code
            }, function(data) {
                if (data.result) {
                    window.opener.reloadRow();
                    window.location.reload();
                }
            });
        }

        function saveExpress(item, job_detail_code) {
            var x = $(item).closest('td').find('.rate').val();
            $(item).next().hide();
            $(item).prev().hide();
            $(item).hide();
            $(item).closest('div').prev().html('<div class="spin-item"><div class="loader10-sm"></div></div>');

            $.post("/Payment/EditFleetExpressCost", {
                value: x,
                job_detail_code: job_detail_code
            }, function(data) {
                if (data.result) {
                    window.opener.reloadRow();
                    window.location.reload();
                }
            });
        }
    </script>
}