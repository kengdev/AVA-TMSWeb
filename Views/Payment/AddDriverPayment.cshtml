@model TMSWeb.Models.Entities.LOG.TblAllowance
@{
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
<style>
    .table th {
        font-size: 12px !important;
        background-color: #e9e9e9
    }

    .table td {
        font-size: 13px !important;
        padding-top: 5px;
    }

        .table td.date,
        .table td.booking,
        .table td.container {
            font-size: 11px !important;
        }

        .table td.currency {
            font-size: 13px !important;
            text-align: right;
            width: 80px !important;
        }

        .table td.license {
            font-size: 13px !important;
            text-align: center;
            width: 110px;
        }

        .table td.action {
            text-align: center !important;
        }

    .form-subtract {
        height: 25px !important;
    }

    .pic-bordered {
        border: 1px solid #808080;
        width: 158px;
        height: 200px;
    }

    .topic-content {
        font-weight: bold;
        font-size: 13px;
        display: inline-block;
        width: 100px;
    }

    .action {
        text-align: center !important;
    }

    .date {
        text-align: center;
    }

    .booking {
        text-align: center;
        width: 170px !important;
    }

    .container {
        text-align: center;
    }

    .currency_val {
        width: 70px;
        padding-left: 7px;
    }

    a.closed {
        color: red;
    }

        a.closed:hover {
            color: #071849
        }

    .approve {
        text-align: center;
        background-color: #128f04;
        color: #fff;
    }

    .pending {
        text-align: center;
        background-color: #e11e1e;
        color: #fff;
        font-weight: 100;
    }

    .none {
        text-align: center;
        background-color: #fff;
    }

    .stop {
        text-align: center;
        background-color: #7d3caa;
        color: #fff;
    }


    .table tr:hover td.pending {
        background: #e11e1e !important;
        pointer-events: none !important
    }

    .table tr:hover td.approve {
        background: #128f04 !important;
        pointer-events: none !important
    }

    .table tr:hover td.none {
        background: #fff !important;
        pointer-events: none !important
    }

    .table tr:hover td.stop {
        background: #7d3caa !important;
        pointer-events: none !important
    }

    fieldset {
        border: none;
        padding: 0;
        margin: 0;
        z-index: 9999;
    }

    .table {
        overflow: hidden;
    }

    .active-row {
        background-color: #cacaca
    }

    table.table-toggle td {
        height: 32px !important;
        padding-top: 3px !important;
    }

    .selected-row {
        color: #ccc;
    }
</style>

<div class="col-md-12">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-plus-circle"></i>
                <span class="bold small"> ทำรายการจ่ายเงินพนักงานขับรถ</span>
            </div>

            <div class="actions">
                <div class="form-inline" role="form">
                    @Html.DropDownList("driver", null, "-----เลือก-----", new { @Class = "form-control input-sm" })
                    <div class="form-group">
                        <input type="text" class="form-control input-sm datepicker" id="filterDateRangeStart" placeholder="เริ่มต้น" autocomplete="Off">
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-control input-sm datepicker" id="filterDateRangeEnd" placeholder="สิ้นสุด" autocomplete="Off">
                    </div>
                    <button type="button" class="btn btn-sm yellow" id="calculate">เรียกดูข้อมูล</button>
                </div>
            </div>
        </div>
        <div class="portlet-body form">
            @using (Html.BeginForm("AddDriverPaymentData", "Payment", FormMethod.Post, new { role = "form", id = "frmAdd", onsubmit = "return OnValidate()" }))
            {
                @Html.HiddenFor(m => m.DriverCode)
                @Html.HiddenFor(m => m.StartDate)
                @Html.HiddenFor(m => m.EndDate)
                <div class="row">
                    <div class="col-sm-7 col-md-7 col-lg-7">
                        <table class="table-toggle" data-toggle="table" data-height="200" data-search="false">
                            <thead>
                                <tr>
                                    <th data-align="center" data-width="50">
                                        <a href="#" class="font-red-thunderbird" onclick="selectAll()">All</a>
                                    </th>
                                    <th data-width="130">Date</th>
                                    <th data-width="130">Container No.</th>
                                    <th data-width="140">Industry</th>
                                    <th>zone</th>
                                </tr>
                            </thead>
                            <tbody id="order-body">
                            </tbody>
                        </table>
                    </div>

                    <div class="col-sm-5 col-md-5 col-lg-5">
                        <table data-toggle="table" data-height="200">
                            <thead>
                                <tr>
                                    <th data-width="90" data-align="center">
                                        <a href="#" class="font-red-thunderbird" onclick="addSpecial()" id="btnAdd">เพิ่ม</a>
                                    </th>
                                    <th>ประเภท</th>
                                    <th>รายการ</th>
                                    <th>ยอดเงิน</th>
                                </tr>
                            </thead>
                            <tbody id="list-subtract">
                                <tr>
                                    <td></td>
                                    <td>
                                        <select class="optional" name="subtractType[]">
                                            <option value="add">เพิ่ม</option>
                                            <option value="sub">หัก</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-subtract"
                                               name="subtractName[]" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-subtract"
                                               name="subtractVal[]" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-12">
                        <table data-toggle="table" data-height="250">
                            <thead>
                                <tr>
                                    <th data-width="50"></th>
                                    <th data-width="130">Date</th>
                                    <th data-width="200">สถานที่</th>
                                    <th data-width="200">Container</th>
                                    <th data-width="100">เบี้ยเลี้ยง</th>
                                    <th data-width="100">น้ำมัน</th>
                                    <th data-width="100">เสียเวลา</th>
                                    <th>อื่น ๆ</th>
                                </tr>
                            </thead>
                            <tbody id="selected-body">
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row pull-right">
                        <div class="col-md-12">
                            <div class="tools-action">
                                <a href="javascript:;" onclick="window.close();">ยกเลิก</a> |
                                <button type="submit" class="btn green">บันทึกข้อมูล</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        (function($) {
            $("#frmAdd").ajaxForm(function(data) {
                killOverlayForm();
                if (data.result == true) {
                    $.alert.open('info', data.resultMessage, function(r) {
                        window.opener.reloadRow();
                        location.reload();
                    });
                } else {
                    $.alert.open('error', data.resultMessage);
                }
            });

            jQuery('#filterDateRangeStart').datetimepicker({
                format: 'Y/m/d',
                lang: 'th',
                onShow: function(ct) {

                },
                timepicker: false
            });

            jQuery('#filterDateRangeEnd').datetimepicker({
                format: 'Y/m/d',
                lang: 'th',
                onShow: function(ct) {

                },
                timepicker: false
            });

            $('#calculate').click(function() {
                var start = $('#filterDateRangeStart').val();
                var end = $('#filterDateRangeEnd').val();
                var driver = $('#driver').val();
                $('#DriverCode').val(driver);
                $('#StartDate').val(start);
                $('#EndDate').val(end);
                $.post("/payment/getdriverjob", {
                    driver_code: driver,
                    start: start,
                    end: end
                }, function(data) {
                    var row = "";
                    $('#order-body').empty();
                    $.each(data, function(i, item) {
                        var code = item.code;

                        row = '<tr><td class="action"><a href="#" class="unchecked font-green-jungle" onclick=appendRow(this,"' + item.job_detail_code + '","' + item.working_date + '","' + item.allowance_code + '","' + driver + '")><i class="fa fa-check"></i></a>';
                        row += '<input class="unchecked-item" type="hidden" value="' + code + '" id="' + code + '"/><input type="hidden" value="' + item.job_detail_code + '" class="job_detail_code" /><input type="hidden" value="' + item.working_date + '" class="working_date" /></td>';
                        row += "<td class=''>" + item.trip_date + "</td>";
                        row += "<td class=''>" + item.container_no + "</td>";
                        row += "<td>" + item.mission_name + "</td>";
                        row += "<td>" + item.zone_name + "</td></tr>";

                        $('#order-body').append(row);
                    });
                });
            });
        }(jQuery));

        function addSpecial() {
            var msg = '<tr><td style="text-align:center;"><a href="#" class="closed" onclick="$(this).parent().parent().remove()"><i class="fa fa-times"></i></a></td>';
            msg += '<td><select class="optional" name="subtractType[]"><option value="add">เพิ่ม</option><option value="sub">หัก</option></select></td>';
            msg += '<td><input type="text" class="form-control form-subtract" name="subtractName[]" /></td>';
            msg += '<td><input type="text" class="form-control form-subtract" name="subtractVal[]" /></td></tr>';

            $('#list-subtract').append(msg);
        }

        function selectAll() {
            $('#selected-body').empty();
            var driver_code = $('#driver').val();
            $('.unchecked-item').each(function(i, obj) {
                var code = $(this).val();
                var job_detail_code = $(this).closest('td').find('.job_detail_code').val();
                var working_date = $(this).closest('td').find('.working_date').val();
                if (job_detail_code != '-') {
                    $.post("/Payment/DriverPaymentEntry", {
                        job_detail_code: job_detail_code,
                        code: code,
                        driver_code: driver_code
                    }, function(data) {
                        var row = $('#selected-body tr td').html();
                        if (row == "No matching records found") {
                            $('#selected-body').empty();
                        }

                        $('#selected-body').append(data);
                    });
                }
                else {
                    $.post("/Payment/DriverPaymentEntry", {
                        working_date: working_date,
                        code: code,
                        driver_code: driver_code
                    }, function(data) {
                        var row = $('#selected-body tr td').html();
                        if (row == "No matching records found") {
                            $('#selected-body').empty();
                        }

                        $('#selected-body').append(data);
                    });
                }

                var item = $(this).closest('td');
                item.find('.unchecked').hide();
                item.closest('tr').find('td').addClass('selected-row');
            });
        }

        function appendRow(e, job_detail_code, working_date, code, driver_code) {
            var item = $(e).closest('td');
            $(e).hide();
            item.closest('tr').find('td').addClass('selected-row');
            if (job_detail_code != '-') {
                $.post("/Payment/DriverPaymentEntry", {
                    job_detail_code: job_detail_code,
                    code: code,
                    driver_code: driver_code
                }, function(data) {
                    var row = $('#selected-body tr td').html();
                    if (row == "No matching records found") {
                        $('#selected-body').empty();
                    }

                    $('#selected-body').append(data);
                });
            }
            else {
                $.post("/Payment/DriverPaymentEntry", {
                    working_date: working_date,
                    code: code
                }, function(data) {
                    var row = $('#selected-body tr td').html();
                    if (row == "No matching records found") {
                        $('#selected-body').empty();
                    }

                    $('#selected-body').append(data);
                });
            }
        }

        function removeFunc(code) {
            var item = $('#' + code).closest('td');
            item.find('.unchecked').show();
            item.closest('tr').find('td').removeClass('selected-row');
        }

        function OnValidate() {
            overLayForm();
            return true;
        }
    </script>
}