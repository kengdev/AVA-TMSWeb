@model TMSWeb.Models.ViewModels.OrderFormViewModel
@{
    Layout = "~/Views/Shared/_PartialMobileLayout.cshtml";
    var tracking = (List<TMSWeb.Models.ViewModels.StepWizardViewModels>)ViewBag.Tracking;
    string container = Model.container_no != null && Model.container_no != "-" ? Model.container_no : "";
    string seal = Model.seal_no != null && Model.seal_no != "-" ? Model.seal_no : "";
}
@section Styles{
    <link href="~/css/site/invoicedriver.css" rel="stylesheet" type="text/css" />
}

<div class="row">
    <div class="col-sm-12 col-xs-12 col-md-12 align-middle">
        <div class="container">
            <div class="row bs-wizard" style="border-bottom:0;">
                @foreach (var item in tracking)
                {
                    <div class="col-xs-3 bs-wizard-step complete">
                        <div class="text-center bs-wizard-stepnum">@item.action</div>
                        <div class="progress">
                            <div class="@item.progress"></div>
                        </div>
                        <a href="#" class="@item.wizard"></a>
                        <div class="bs-wizard-info text-center">@item.action_time</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12">
        <table class="table table-striped table-bordered">
            <tr>
                <td>ชื่อ</td>
                <td>@Model.driver_fullname</td>
            </tr>
            <tr>
                <td>ทะเบียน</td>
                <td>@Model.truck_license</td>
            </tr>
            <tr>
                <td>เลขที่</td>
                <td>@Model.job_detail_code</td>
            </tr>
            <tr>
                <td>BOOKING</td>
                <td>@Model.booking_no</td>
            </tr>
            <tr>
                <td>สถานะ</td>
                <td>
                    <span>ขาเข้า</span>
                </td>
            </tr>
            <tr>
                <td>สภานที่</td>
                <td>@Model.mission_name</td>
            </tr>
            <tr>
                <td>วันที่และเวลา</td>
                <td>@Model.job_date.ToString("dd-MM-yyyy HH:mm")</td>
            </tr>
        </table>
    </div>
</div>

@if (Model.tracking_status == "PN")
{
    using (Html.BeginForm("UpdateST", "DriverJob", FormMethod.Post, new { id = "frmAdd", @encType = "multipart/form-data", onsubmit = "return OnValidate()" }))
    {
        @Html.HiddenFor(m => m.job_detail_code)
        @Html.HiddenFor(m => m.driver_code)
        @Html.Hidden("Lat")
        @Html.Hidden("Lon")

        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <button type="submit" class="btn btn-circle yellow btn-block">อัพเดทสถานะ</button>
            </div>
        </div>
    }
}
else if (Model.tracking_status == "ST")
{
    using (Html.BeginForm("UpdateWP", "DriverJob", FormMethod.Post, new { id = "frmAdd", @encType = "multipart/form-data", onsubmit = "return OnWPValidate()" }))
    {
        @Html.HiddenFor(m => m.job_detail_code)
        @Html.HiddenFor(m => m.driver_code)
        @Html.Hidden("Lat")
        @Html.Hidden("Lon")
        Html.RenderPartial("_Import1", Model);
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <button type="submit" class="btn btn-circle yellow btn-block">บันทึกข้อมูล</button>
            </div>
        </div>
    }
}
else if (Model.tracking_status == "WP")
{
    using (Html.BeginForm("UpdateImportAR", "DriverJob", FormMethod.Post, new { id = "frmAdd", @encType = "multipart/form-data", onsubmit = "return OnARValidate()" }))
    {
        @Html.HiddenFor(m => m.job_detail_code)
        @Html.HiddenFor(m => m.driver_code)
        @Html.Hidden("Lat")
        @Html.Hidden("Lon")
        Html.RenderPartial("_Import2");
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <button type="submit" class="btn btn-circle yellow btn-block">บันทึกข้อมูล</button>
            </div>
        </div>
    }
}
else if (Model.tracking_status == "AR")
{
    using (Html.BeginForm("UpdateImportDO", "DriverJob", FormMethod.Post, new { id = "frmAdd", @encType = "multipart/form-data", onsubmit = "return OnDOValidate()" }))
    {
        @Html.HiddenFor(m => m.job_detail_code)
        @Html.HiddenFor(m => m.driver_code)
        @Html.Hidden("Lat")
        @Html.Hidden("Lon")
        Html.RenderPartial("_Import3");
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <button type="submit" class="btn btn-circle yellow btn-block">บันทึกข้อมูล</button>
            </div>
        </div>
    }
}

@section scripts
{
    <script src="~/js/sites/toastr.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            var getPosition = {
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 0
            };

            function success(gotPosition) {
                var code = $('#job_detail_code').val();
                var driver_code = $('#driver_code').val();
                var lat = gotPosition.coords.latitude;
                var lon = gotPosition.coords.longitude;
                $('#Lat').val(lat);
                $('#Lon').val(lon);
            };

            function error(err) {
                switch (error.code) {
                    case error.PERMISSION_DENIED:
                        $("#location-error").html('User denied the request for Geolocation.');
                        break;
                    case error.POSITION_UNAVAILABLE:
                        $("#location-error").html('Location information is unavailable.');
                        break;
                    case error.TIMEOUT:
                        $("#location-error").html('The request to get user location timed out.');
                        break;
                    case error.UNKNOWN_ERROR:
                        $("#location-error").html('An unknown error occurred.');
                        break;
                }
            };

            navigator.geolocation.getCurrentPosition(success, error, getPosition);

            $('.file-upload').change(function() {
                $(this).parent().hide();
                $(this).parent().prev('.file-true').show();
            });

            $("#frmAdd").ajaxForm(function(data) {
                if (data.result == true) {
                    $.alert.open('info', data.resultMessage, function(r) {
                        window.location.reload();
                    });
                } else {
                    $.alert.open('error', data.resultMessage);
                }
            });
        });

        function OnWPValidate() {
            var fn = $('#frmAdd').myfunction({
                rules: {
                    container_no: {
                        require: {
                            message: "กรุณาพิมพ์เบอร์ตู้",
                            type: 'group'
                        },
                        container_format: {
                            message: "อาจมีข้อผิดพลาดเกี่ยวกับเบอร์ตู้ กรุณาตรวจสอบความถูกต้อง",
                            type: 'group'
                        }
                    },
                    seal_no: {
                        require: {
                            message: "กรุณาพิมพ์เบอร์ซีล",
                            type: 'group'
                        }
                    },
                    trailer_license: {
                        require: {
                            message: "กรุณาพิมพ์ทะเบียนหาง",
                            type: 'group'
                        }
                    },
                    container_image: {
                        file: {
                            type: 'button-circle'
                        }
                    },
                    seal_image: {
                        file: {
                            type: 'button-circle'
                        }
                    }
                }
            })

            return fn;
        }

        function OnARValidate() {
            var fn = $('#frmAdd').myfunction({
                rules: {
                    fuel: {
                        require: {
                            message: "กรุณาจำนวนน้ำมัน หากไม่เติมพิมพ์ 0",
                            type: 'group'
                        }
                    },
                    yard: {
                        require: {
                            message: "กรุณาพิมพ์ค่าผ่านท่า หากไม่มีพิมพ์ 0",
                            type: 'group'
                        }
                    }
                }
            })

            return fn;
        }

        function OnDOValidate() {
            var fn = $('#frmAdd').myfunction({
                rules: {
                    express: {
                        require: {
                            message: "กรุณาพิมพ์ค่าทางด่วน หากไม่มีพิมพ์ 0",
                            type: 'group'
                        }
                    },
                    lift1: {
                        require: {
                            message: "กรุณาพิมพ์ค่ายก หากไม่มีพิมพ์ 0",
                            type: 'group'
                        }
                    },
                    lift2: {
                        require: {
                            message: "กรุณาพิมพ์ค่ายก หากไม่มีพิมพ์ 0",
                            type: 'group'
                        }
                    },
                    lift3: {
                        require: {
                            message: "กรุณาพิมพ์ค่ายก หากไม่มีพิมพ์ 0",
                            type: 'group'
                        }
                    }
                }
            })

            return fn;
        }
    </script>
}