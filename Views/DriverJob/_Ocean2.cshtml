@{
    Layout = null;
}
<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12">
        <table style="width:100%">
            <tr>
                <td>
                    <div class="form-group">
                        <div class="input-group">
                            <span class="input-group-addon input-circle-left">
                                <i class="fad fa-sign"></i>&nbsp;
                            </span>
                            <input type="text" name="yard" id="yard" class="form-control input-circle-right form-number" placeholder="ค่าผ่านท่า" autocomplete="off">
                        </div>
                        <span class="help-block"></span>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="form-group">
                        <div class="input-group">
                            <span class="input-group-addon input-circle-left">
                                <i class="fad fa-gas-pump"></i>&nbsp;
                            </span>
                            <input type="text" name="fuel" id="fuel" class="form-control input-circle-right form-number" placeholder="เติมน้ำมัน" autocomplete="off">
                        </div>
                        <span class="help-block"></span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>