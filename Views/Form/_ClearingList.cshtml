@model TMSWeb.Models.ViewModels.ClearingFormViewModel
@{
    Layout = null;
}
<link rel="stylesheet" type="text/css" href="~/css/print/printform.css" media="print">
<style>
    .page {
        font: 13px "Tahoma", Times, serif;
        padding: 0.5cm;
    }

    table.list {
        width: 100%;
        border-collapse: collapse;
    }

        table.list th {
            font-size: 11px !important;
            border: 1px solid #000;
            padding: 3px;
        }

        table.list td {
            font-size: 11px !important;
            border: 1px solid #000;
            padding: 3px;
        }

    @@media all {
        .page-break {
        }
    }

    @@media print {

        html,
        body {
            height: 99%;
        }
    }

    @@media print {
        .page-break {
            page-break-after: avoid;
        }
    }
</style>
<div class="page">
    <div class="header">
        <div style="width:100%;text-align:center;font-size:13px;font-weight:bold;">
            <span>รายการเคลียร์ยอดเงินสำรองจ่าย</span>
        </div>
    </div>
    <br />
    <div class="content">
        <span>รับยอด ณ วันที่ @Model.data.ReceiveDate.ToString("MMM, dd yyyy")</span>
        <table class="list">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Place</th>
                    <th>Booking</th>
                    <th>Container</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.list)
                {
                    <tr>
                        <td style="text-align: center;">@item.job_date_value.ToString("dd-MM-yyyy")</td>
                        <td style="text-align: center;width:110px;">@item.customer_name</td>
                        <td style="text-align: center;">@item.mission_name</td>
                        <td style="text-align: center;">@item.booking_no</td>
                        <td style="text-align: center;">@item.container_no</td>
                        <td style="text-align: right;">@item.cost_value.Value.ToString("#,##0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" style="text-align: right;">Total</td>
                    <td style="text-align: right;">
                        @Model.data.Total.ToString("#,##0.00")
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>