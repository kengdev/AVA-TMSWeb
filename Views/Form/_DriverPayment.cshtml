@{
    Layout = null;
    var thCulture = new System.Globalization.CultureInfo("th-TH", false);
    var allowance = Model.allowance;
    var subtract = Model.substract;
    var addit = Model.addit;
    var driver = Model.driver;
    //var date = (AVA.Models.Entities.TblAllowance)ViewBag.Date;
    decimal trip = Model.trip_value;
    decimal fuel = Model.fuel_value;
    decimal waste = Model.waste_value;
    decimal other = Model.other_value;
    decimal total_subtract = Model.total_substract;
    decimal trip_total = (trip + fuel + waste + other);
}
<style>
    body {
        background-color: #fff;
    }

    .page {
        padding: 0.5cm;
        font: 10pt "Tahoma", Times, serif;
        z-index: 1000;
    }

    .top-header {
        width: 100%;
        display: inline-block;
    }

    label {
        font-size: 13px;
    }

    .form-wrap {
        padding: 7px;
    }

    .form-detail {
        border-bottom: 1px solid #ccc;
        font-size: 14px;
    }

    .header-col-1 {
        width: 150px;
        float: left;
        display: table;
    }

    .header-col-6 {
        width: 400px;
        float: left;
        display: table;
    }

    .company-name {
        font-size: 14px;
        font-weight: bold;
    }

    .company-detail {
        font-size: 13px !important;
    }

    .topic-name {
        width: 100%;
        text-align: center;
        font-weight: bold;
        font-size: 13px;
        margin-top: 20px;
    }

    .table th {
        font-size: 11px;
        border: 1px solid #000 !important;
        text-align: center !important;
        padding: 7px;
    }

    .table {
        border-collapse: collapse;
        width: 100%;
    }

        .table td {
            font-size: 11px;
            border: 1px solid #000 !important;
            padding: 3px !important;
            line-height: 17px !important;
        }

    .center-td {
        text-align: center;
    }

    .currency-td {
        text-align: right;
    }

    .total-td {
        text-align: right;
        font-weight: bold;
    }

    @@page {
        size: landscape;
    }

    @@media all {
        .page-break {
            display: none;
        }
    }

    @@media print {
        html, body {
            height: 99%;
        }
    }

    @@media print {
        .page-break {
            display: block;
            page-break-before: always;
        }
    }
</style>
<div class="page">
    <div class="top-header">
        @{
            Html.RenderPartial("Header");
        }
    </div>
    <div class="topic-name">
    </div>
    <br />
    <div>
        <table class="table-header" style="font-size:14px;">
            <tr>
                <td style="font-weight:bold;">ชื่อ</td>
                <td style="padding-left:10px;">
                    <div style="width:150px;">@driver.Fullname</div>
                </td>
                <td style="font-weight:bold;">ทะเบียน</td>
                <td style="padding-left:10px;">@driver.TruckLicense</td>
            </tr>
        </table>
    </div>
    <div style="margin-top:5px;">
        <table class="table table-bordered">
            <tr>
                <th>Date</th>
                <th>Booking</th>
                <th>Container</th>
                <th>สถานที่</th>
                <th>เบี้ยเลี้ยง</th>
                <th>น้ำมัน</th>
                <th>เสียเวลา</th>
                <th>อื่น ๆ</th>
            </tr>
            @foreach (var item in Model.data)
            {
                <tr>
                    <td class="center-td">@item.working_date</td>
                    <td class="center-td">@item.booking_no</td>
                    <td class="center-td">@item.container_no</td>
                    <td class="center-td">@item.trip_place</td>
                    <td class="currency-td">@item.trip_value.ToString("#,##0.00")</td>
                    <td class="currency-td">@item.fuel_value.ToString("#,##0.00")</td>
                    <td class="currency-td">@item.waste_value.ToString("#,##0.00")</td>
                    <td class="currency-td">@item.other_value.ToString("#,##0.00")</td>
                </tr>
            }
            <tr>
                <td colspan="4" class="total-td">ยอดรวม</td>
                <td class="total-td">@trip.ToString("#,##0.00")</td>
                <td class="total-td">@fuel.ToString("#,##0.00")</td>
                <td class="total-td">@waste.ToString("#,##0.00")</td>
                <td class="total-td">@other.ToString("#,##0.00")</td>
            </tr>
            <tr>
                <th colspan="4">รายการหัก</th>
                <th colspan="4"></th>
            </tr>
            @if (subtract != null)
            {
                foreach (var item in subtract)
                {
                    <tr>
                        <td colspan="4" style="padding-left:30px!important;">@item.subtract_name</td>
                        <td colspan="4" class="currency-td" style="color:red;">@item.subtract_value.ToString("#,##0.00")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" style="padding-left:30px!important;">-</td>
                    <td colspan="4"></td>
                    <td class="currency-td"></td>
                </tr>
            }
            <tr>
                <td colspan="4" class="total-td">ยอดหักรวม</td>
                <td colspan="4" class="currency-td" style="color:red;">@total_subtract.ToString("#,##0.00")</td>
            </tr>
            <tr>
                <td colspan="4" class="total-td">ยอดเงินได้รวม</td>
                <td colspan="4" class="currency-td">@trip_total.ToString("#,##0.00")</td>
            </tr>
            <tr>
                <td colspan="4" class="total-td">ยอดเงินทั้งสิ้น</td>
                <td colspan="4" class="currency-td" style="font-weight:bold;">@Model.net_total.ToString("#,##0.00")</td>
            </tr>
        </table>
    </div>
    <div>
        <table>
            <tr>
                <th></th>
            </tr>
        </table>
    </div>
</div>