@model List<TMSWeb.Models.ViewModels.PND50ViewModel>;
@{
    Layout = null;
    int pg = 0;
}
<style>
    body {
        background: #fff;
    }

    label {
        font-size: 13px;
    }

    .page {
        font: 10pt "Tahoma", Times, serif;
        z-index: 1000;
        width: 100%;
        padding: 0.5px;
    }

    .pnd-50-form {
        font-family: 'Angsana New';
        font-size: 13pt;
        border: 1px solid #000;
        padding: 10px;
    }

    /*-----------------for top header-----------------------------*/
    .topic label {
        font-family: 'Angsana New';
        font-weight: bolder;
        font-size: 12pt;
    }

    .topic span {
        font-family: 'Angsana New';
        font-style: italic;
        font-size: 13pt;
    }

    /*-----------------for border-----------------------*/
    .outer-wrapper-1 {
        font-family: 'Angsana New';
        border: 1px solid #000;
        padding-left: 15px;
        padding-right: 15px;
        border-radius: 5px !important;
    }

    /*-----------------for square box---------------------------*/
    .block-square-id {
        border: 1px solid #000;
        width: 200px;
        height: 20px;
        display: inline-block;
        margin-top: 2px;
        text-align: center;
        font-size: 13pt;
    }

    .block-square-blank {
        border: 1px solid #000;
        height: 20px;
        display: inline-block;
        margin-top: 2px;
        text-align: center;
        font-size: 14pt;
    }

    .block-square-check {
        display: inline-block;
        margin-left: 10px;
        border: 1px solid #000;
        width: 15px;
        height: 15px;
        font-size: 13px;
        text-align: center;
    }

    .wrapper-square {
        display: inline-block;
    }

    /*-----------------for detail (block 1)-----------------------*/
    .header-wrapper-1 .header-1 {
        width: 100%;
        text-align: center;
        font-size: 16pt;
        font-weight: bold;
        padding: 0;
        display: inline-block;
        margin-top: -10px
    }

    .header-wrapper-1 .header-2 {
        text-align: center;
        font-size: 13pt;
        padding: 0;
        font-weight: normal;
        margin-top: -10px;
    }

    .header-wrapper-1 .header-no {
        font-size: 13pt;
        padding: 0;
        font-weight: normal;
        position: relative;
        width: 100%;
        text-align: right;
        top: -40px
    }

    /*-----------------for detail (block 2)-----------------------*/
    .content-block {
        display: inline-block;
    }

        .content-block .topic {
            font-size: 13pt;
            font-weight: bolder;
            display: inline-block;
        }

        .content-block .sub-topic {
            font-size: 12pt;
            font-weight: bolder;
            display: inline-block;
        }

        .content-block .detail-1 {
            display: inline-block;
        }

        .content-block .detail-1-line {
            border: 1px dashed #000;
            line-height: 22px;
            display: inline-block;
            text-align: left;
            font-size: 13pt;
            position: relative;
            padding: 0;
        }

    .detail-1-line .detail-1-text {
        position: absolute;
        top: -18px;
        bottom: 0;
        left: 0;
    }

    .detail-help {
        font-size: 12pt;
        font-style: italic;
        margin-left: 50px;
        margin-top: -9px;
    }

    .sub-content .topic {
        display: inline-block;
        font-weight: bolder;
        font-family: 'Angsana New';
        font-size: 14pt;
    }

    .topic-help {
        font-size: 12pt;
        font-style: italic;
        margin-top: -3px;
    }

    .sub-content {
        margin-top: -7px;
    }

        .sub-content span {
            font-size: 12pt;
            padding-left: 10px;
        }

        .sub-content label {
            font-size: 12pt;
            font-weight: bolder;
        }

    /*--------------------for detail block 3--------------------*/
    .content-break {
        height: 3px;
    }

    .table-content {
        width: 100%;
        border-collapse: collapse;
    }

        .table-content th {
            border-bottom: 1px solid #000;
            font-size: 12pt;
            padding: 0;
            text-align: center;
            font-weight: bolder;
        }

        .table-content td {
            font-family: 'Angsana New';
            font-size: 12pt;
            padding: 0 5px 0 5px !important;
        }

    .font-ang {
        font-family: 'Angsana New';
    }

    /*--------------------footer---------------------*/
    .footer-wrapper {
        font-family: 'Angsana New';
        border: 1px solid #000;
        padding-top: 3px;
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 3px;
        border-radius: 5px !important;
        display: inline-block;
        height: 115px;
    }

    .date-sign {
        width: 150px;
        border-bottom: 1px dotted #000;
        display: inline-block;
    }

    @@media all {
        .page-break {
            display: block;
            page-break-after: always !important;
        }
    }

    @@media print {
        html, body {
            height: 99%;
        }
    }

    @@media print {
        .page-break {
            display: block;
            page-break-after: always !important;
        }
    }
</style>
@foreach (var item in Model)
{
