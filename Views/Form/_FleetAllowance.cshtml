@foreach (var obj in Model)
{
    decimal row = obj.detail.Count;
    int pg = (int)Math.Ceiling(row / 20);
    var pindex = 0;
    int index = 1;
    int item = 0;
    pg = (row >= 41 && row <= 50 ? pg - 1 : pg);
    pg = (row >= 61 && row <= 100 ? pg - 1 : pg);
    pg = (row >= 101 && row <= 160 ? pg - 2 : pg);
    pg = (row >= 151 && row <= 170 ? pg - 3 : pg);
    pg = (row >= 171 && row <= 250 ? pg - 3 : pg);
    @for (int c = 0; c < pg; c++)
    {
        pindex++;
        if (c > 0)
        {
            <div style="height:110px!important;width:100%;"></div>
        }
        <div class="page">
            <div class="form-content">
                <div class="top-header">
                    @{
                        Html.RenderPartial("HeaderPdf");
                    }
                    <div class="header-col-3">
                        <div>
                            หน้า @pindex.ToString() จาก @pg
                        </div>
                    </div>
                </div>
                <br />
                <div class="clear-float"></div>
                <div class="topic-name">
                    ใบสำคัญจ่ายเงิน
                </div>

                <div style="width:390px;margin-top:10px;display:inline-block">
                    <div class="topic-customer-name">
                        @obj.supplier_name.ToUpper()
                    </div>
                    <div class="topic-customer-address">
                        @obj.supplier_address.ToUpper()
                    </div>
                    <div class="topic-customer-tax">
                        TAX ID : @obj.supplier_tax
                    </div>
                </div>

                <div style="vertical-align:top;text-align:left;float:right;">
                    <div style="text-align:left;">
                        <div class="topic-date">Date</div>
                        <span>@obj.payment_date.ToString("dd MMMM yyyy", enCulture)</span>
                    </div>
                    <div style="text-align:left;margin-top:10px;">
                        <div class="topic-invoice">Invoice No.</div>
                        <span>@obj.payment_code</span>
                    </div>
                    <div style="text-align:left;margin-top:10px;">
                        <div class="topic-invoice">ทะเบียน</div>
                        <span>@obj.license</span>
                    </div>
                </div>

                <div class="clear-float"></div>
                <div class="content-topic">
                    Payment Description
                </div>
                <div class="content-body">
                    <table class="table-invoice">
                        <tr>
                            <th style="width:30px;">ลำดับ</th>
                            <th style="width:66px;">วันที่</th>
                            <th style="width:150px!important">คอนเทนเนอร์</th>
                            <th style="width:150px!important">โรงงาน</th>
                            <th>ค่าขนส่ง</th>
                            <th>เบี้ยเลี้ยง</th>
                            <th style="width:80px;">ค่าน้ำมัน</th>
                            <th style="width:80px;">ค่าเที่ยว/วัน</th>
                        </tr>
                        @{
                            var rowcontrol = 29;
                            if (pindex == pg)
                            {
                                rowcontrol = 18;
                            }
                        }
                        @for (int i = 0; i < rowcontrol; i++)
                        {
                            if (item < obj.detail.Count())
                            {
                                <tr>
                                    <td class="col-index">@index.ToString().</td>
                                    <td class="col-center">@obj.detail[item].job_date.ToString("dd-MM-yyyy")</td>
                                    <td class="col-center">@obj.detail[item].container_no</td>
                                    <td class="col-center">@obj.detail[item].mission_name</td>
                                    <td class="currency-td">
                                        @obj.detail[item].transport_value.ToString("#,##0.00")
                                    </td>
                                    <td class="currency-td">
                                        @obj.detail[item].trip_value.ToString("#,##0.00")
                                    </td>
                                    <td class="currency-td">
                                        @obj.detail[item].fuel_value.ToString("#,##0.00")
                                    </td>
                                    <td class="currency-td">
                                        @obj.detail[item].total_value.ToString("#,##0.00")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td class="col-index" style="width:30px;">&nbsp;</td>
                                    <td class="col-center">&nbsp;</td>
                                    <td class="col-center">&nbsp;</td>
                                    <td class="col-center">&nbsp;</td>
                                    <td class="currency-td">&nbsp;</td>
                                    <td class="currency-td">&nbsp;</td>
                                    <td class="currency-td">&nbsp;</td>
                                    <td class="currency-td">&nbsp;</td>
                                </tr>
                            }
                            index++;
                            item++;
                        }
                        @if (pindex == pg)
                        {
                            <tr>
                                <td colspan="4" style="text-align:right;font-weight:bold;">รวม</td>
                                <td class="currency-td">@obj.transport_total.ToString("#,##0.00")</td>
                                <td class="currency-td">@obj.trip_total.ToString("#,##0.00")</td>
                                <td class="currency-td">@obj.fuel_total.ToString("#,##0.00")</td>
                                <td class="currency-td">@obj.payment_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
                                <td colspan="3" style="font-weight:bold;border-bottom:none!important;">หมายเหตุ</td>
                                <td style="text-align:right;font-weight:bold;">เงินเดือน</td>
                                <td colspan="4" class="currency">@obj.salary_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
                                <td colspan="3" rowspan="6" style="border-top:none!important;">
                                    <div style="word-wrap: break-word;padding-left:10px!important;">
                                        @obj.remark
                                    </div>
                                </td>
                                <td style="text-align:right;font-weight:bold;">ค่าทางด่วน</td>
                                <td colspan="4" class="currency">@obj.express_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
                                <td style="text-align:right;font-weight:bold;">ค่าบริการ ช.</td>
                                <td colspan="4" class="currency">@obj.shore_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>

                                <td style="text-align:right;font-weight:bold;">ค่าเช่าลาน</td>
                                <td colspan="4" class="currency">@obj.area_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>

                                <td style="text-align:right;font-weight:bold;">ค่าซ่อมบำรุง</td>
                                <td colspan="4" class="currency">@obj.maintenance_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>

                                <td style="text-align:right;font-weight:bold;">ค่ายาง</td>
                                <td colspan="4" class="currency">@obj.tyre_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>

                                <td style="text-align:right;font-weight:bold;">ค่าบริการยาง</td>
                                <td colspan="4" class="currency">@obj.tyre_service_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
                                <td colspan="3" rowspan="3" class="text-currency">@this.ChangeCurrencyToText(obj.fleetpayment_total)</td>
                                <td style="text-align:right;font-weight:bold;">อื่น ๆ</td>
                                @if (obj.other > 0)
                                {
                                    <td colspan="4" class="currency" style="font-weight:bold;">@obj.other.ToString("#,##0.00")</td>
                                }
                                else
                                {
                                    <td colspan="4" class="currency" style="font-weight:bold;">-</td>
                                }
                            </tr>
                            <tr>
                                <td style="text-align:right;font-weight:bold;">ยอดจ่ายสุทธิ</td>
                                <td colspan="4" class="currency" style="font-weight:bold;">@obj.fleetpayment_total.ToString("#,##0.00")</td>
                            </tr>
                        }
                    </table>
                    @if (pindex == pg)
                    {
                        <table style="width:100%;font-size:13px;margin-top:10px;">
                            <tr>
                                <td style="text-align:center;font-weight:bold;">ได้รับชำระเงินไว้ถูกต้องแล้ว<br />Payment received with thanks</td>
                                <td style="text-align:center;font-weight:bold;">ในนาม บริษัทเอวา โกลบอล โลจิสติกส์ จำกัด<br />For AVA GLOBAL LOGISTICS CO.,LTD</td>
                            </tr>
                            <tr>
                                <td style="text-align:center;font-weight:bold;height:70px">_____________________________<br />ลายมือชือผู้รับเงิน / Receipt Signature</td>
                                <td style="text-align:center;font-weight:bold;">_____________________________<br />ลายมือผู้มีอำนาจลงนาม / Authorized Signature</td>
                            </tr>
                        </table>
                    }
                </div>
            </div>
        </div>
    }
}

