@model TMSWeb.Models.ViewModels.CoverSheetPdfFormViewModel
@{
    Layout = null;
    var enCulture = new System.Globalization.CultureInfo("en-US", false);
    var data = (List<TMSWeb.Models.ViewModels.CoverSheetFormViewModel>)Model.coversheet;
    var customer = (TMSWeb.Models.Entities.LOG.TblCustomer)Model.customer;
    var aData = data.FirstOrDefault();

    var total = data.Sum(s => s.coversheet_value);
    var vat = (total * 1) / 100;
    var grand = (aData.is_vat == true ? total - vat : total);
    string text_total = this.ChangeCurrencyToText(grand);

    decimal row = data.Count;
    int pg = (int)Math.Ceiling(row / 20);
    pg = (row >= 41 && row <= 50 ? pg - 1 : pg);
    pg = (row >= 61 && row <= 100 ? pg - 1 : pg);
    pg = (row >= 101 && row <= 160 ? pg - 2 : pg);
    pg = (row >= 151 && row <= 170 ? pg - 3 : pg);
}
