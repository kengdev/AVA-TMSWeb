@for (int c = 0; c < pg; c++)
{
    pindex++;
    if (c > 0)
    {
        <div style="height:110px!important;width:100%;"></div>
    }
    <div class="page">
        <div class="form-content">
            <div class="top-header">
                @{
                    Html.RenderPartial("HeaderPdf");
                }
                <div class="header-col-3">
                    <div>
                        หน้า @pindex.ToString() จาก @pg
                    </div>
                </div>
            </div>
            <br />
            <div class="clear-float"></div>
            <div class="topic-name">
                ใบสำคัญจ่ายเงิน
            </div>

            <div style="width:390px;margin-top:10px;display:inline-block">
                <div class="topic-customer-name">
                    @Model.supplier_name.ToUpper()
                </div>
                <div class="topic-customer-address">
                    @Model.supplier_address.ToUpper()
                </div>
                <div class="topic-customer-tax">
                    TAX ID : @Model.supplier_tax
                </div>
            </div>

            <div style="vertical-align:top;text-align:left;float:right;">
                <div style="text-align:left;">
                    <div class="topic-date">Date</div>
                    <span>@Model.supplierpayment_date.ToString("dd MMMM yyyy", enCulture)</span>
                </div>
                <div style="text-align:left;margin-top:10px;">
                    <div class="topic-invoice">Invoice No.</div>
                    <span>@Model.supplierpayment_code</span>
                </div>
            </div>

            <div class="clear-float"></div>
            <div class="content-topic">
                Payment Description
            </div>
            <div class="content-body">
                <table class="table-invoice">
                    <tr>
                        <th style="width:30px;">No.</th>
                        <th style="width:66px;">Date</th>
                        <th style="width:110px!important">Invoice No.</th>
                        <th style="width:70">Container</th>
                        <th>Description</th>
                        <th style="width:60px;">Transport</th>
                        <th style="width:60px;">Expenses</th>
                        <th style="width:60px;">Total</th>
                    </tr>
                    @{
                        var rowcontrol = 30;
                        if (pindex == pg)
                        {
                            rowcontrol = 20;
                        }
                    }
                    @for (int i = 0; i < rowcontrol; i++)
                    {
                        if (item < Model.detail.Count())
                        {
                            <tr>
                                <td class="col-index">@index.ToString().</td>
                                <td class="col-center">@Model.detail[item].job_date.ToString("dd-MM-yyyy")</td>
                                <td class="col-center">@Model.detail[item].invoice_no</td>
                                <td class="col-center">@Model.detail[item].container_no</td>
                                <td class="col-center">
                                    @Model.detail[item].mission_name
                                </td>
                                <td class="currency">
                                    @Model.detail[item].transport_value.ToString("#,##0.00")
                                </td>
                                <td class="currency">
                                    @Model.detail[item].advance_value.ToString("#,##0.00")
                                </td>
                                <td class="currency">
                                    @Model.detail[item].total_value.ToString("#,##0.00")
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td class="col-index" style="width:30px;">&nbsp;</td>
                                <td class="col-center" style="width:66px!important">&nbsp;</td>
                                <td class="col-center">&nbsp;</td>
                                <td class="col-center">&nbsp;</td>
                                <td class="col-center" style="width:150px!important">&nbsp;</td>
                                <td class="currency" style="width:80px;">&nbsp;</td>
                                <td class="currency" style="width:80px;">&nbsp;</td>
                                <td class="currency" style="width:80px;">&nbsp;</td>
                            </tr>
                        }
                        index++;
                        item++;
                    }
                    @if (pindex == pg)
                    {
                        <tr>
                            <td colspan="4" style="font-weight:bold;border-bottom:none!important;">หมายเหตุ</td>
                            <td style="text-align:right;font-weight:bold;">รวม</td>
                            <td class="currency">@Model.total_transport.ToString("#,##0.00")</td>
                            <td class="currency">@Model.total_advance.ToString("#,##0.00")</td>
                            <td class="currency">@total.ToString("#,##0.00")</td>
                        </tr>
                        <tr>
                            <td colspan="4" style="border-top:none!important;">
                                <div style="word-wrap: break-word;padding-left:10px!important;">
                                    @Model.remark
                                </div>
                            </td>
                            <td style="text-align:right;font-weight:bold;">ภาษี ณ ที่จ่าย 1%</td>
                            <td colspan="3" class="currency">@Model.transport_vat.ToString("#,##0.00")</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-currency">@this.ChangeCurrencyToText(Model.supplierpayment_total)</td>
                            <td style="text-align:right;font-weight:bold;">ยอดเงินสุทธิ</td>
                            <td colspan="4" class="currency" style="font-weight:bold;">@Model.supplierpayment_total.ToString("#,##0.00")</td>
                        </tr>
                    }
                </table>
                @if (pindex == pg)
                {
                    <div style="font-size:14px;width:100%;">
                        <div style="font-weight:bold;margin-top:10px;">จ่ายเงินโดย</div>
                        <div style="padding-left:20px;padding-top:10px;font-size:13px;">
                            <div>
                                <div class="item-box">
                                    @if (Model.payment_type == "02")
                                    {
                                        <span>&#10004;</span>
                                    }
                                </div>
                                @if (Model.payment_type == "02")
                                {
                                    <span style="margin-left:20px;">โอนเงิน วันที่</span>
                                    <div style="display:inline-block;border-bottom:1px dashed #000;width:150px;padding-left:10px">
                                        @if (Model.supplierpayment_date.ToString("yyyy") != "0001")
                                        {
                                            @Model.supplierpayment_date.ToString("dd MMMM yyyy", enCulture)
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="margin-left:20px;">โอนเงิน วันที่</span>
                                    <div style="display:inline-block;border-bottom:1px dashed #000;width:90px;padding-left:10px"></div>
                                }
                            </div>
                            <br />
                            <div>
                                <div class="item-box">
                                    @if (Model.payment_type == "03")
                                    {
                                        <span>&#10004;</span>
                                    }
                                </div>
                                @if (Model.payment_type == "03")
                                {
                                    <span style="margin-left:20px;">
                                        เช็คธนาคาร
                                    </span>
                                    <span style="margin-left:10px;">
                                        เลขที่
                                    </span>
                                    <div style="display:inline-block;border-bottom:1px dashed #000;width:190px;padding-left:10px">@Model.cheque_no</div>
                                }
                                else
                                {
                                    <span style="margin-left:20px;">
                                        เช็คธนาคาร
                                    </span>
                                    <span style="margin-left:10px;">
                                        เลขที่
                                    </span>
                                    <div style="display:inline-block;border-bottom:1px dashed #000;width:190px;padding-left:10px">&nbsp;</div>
                                }

                            </div>
                        </div>
                    </div>
                    <br />
                    <div>
                        <table style="width:100%;font-size:13px;margin-top:10px">
                            <tr>
                                <td style="text-align:center;font-weight:bold;">ได้รับชำระเงินไว้ถูกต้องแล้ว<br />Payment received with thanks</td>
                                <td style="text-align:center;font-weight:bold;">ในนาม บริษัทเอวา โกลบอล โลจิสติกส์ จำกัด<br />For AVA GLOBAL LOGISTICS CO.,LTD</td>
                            </tr>
                            <tr>
                                <td style="text-align:center;font-weight:bold;height:70px">
                                    <div class="receiver-topic">
                                        _____________________________<br />ลายมือชือผู้รับเงิน / Receipt Signature
                                    </div>
                                </td>
                                <td style="text-align:center;font-weight:bold;">
                                    <div class="sign">
                                        <div class="sign-img">
                                            @{
                                                Html.RenderPartial("SignJutaratPdf");
                                            }
                                        </div>
                                    </div>
                                    <div class="approve-topic">
                                        _____________________________<br />ลายมือผู้มีอำนาจลงนาม / Authorized Signature
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

