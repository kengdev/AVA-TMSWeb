@model TMSWeb.Models.ViewModels.SupplierFormViewModel
@{
    Layout = null;
    var col = ViewBag.Col;
    var enCulture = new System.Globalization.CultureInfo("en-US", false);
    //var data = (AVA.Models.SupplyerFormViewModel)ViewBag.Data;
    //var addit = (List<AVA.Models.AdditionalChargeViewModel>)ViewBag.Additional;
    decimal row = Model.detail.Count;
    decimal total = Model.total_transport + Model.total_advance;
    int pg = (int)Math.Ceiling(row / 20);
    var pindex = 0;
    int index = 1;
    int item = 0;
    pg = (row >= 41 && row <= 50 ? pg - 1 : pg);
    pg = (row >= 61 && row <= 100 ? pg - 1 : pg);
    pg = (row >= 101 && row <= 160 ? pg - 2 : pg);
    pg = (row >= 151 && row <= 170 ? pg - 3 : pg);
    pg = (row >= 171 && row <= 250 ? pg - 3 : pg);
}
<link rel="stylesheet" type="text/css" href="~/css/print/printform.css" media="print">
