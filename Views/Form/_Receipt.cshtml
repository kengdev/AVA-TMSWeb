@{
    Layout = null;
    var enCulture = new System.Globalization.CultureInfo("en-US", false);
    var data = (TMSWeb.Models.ViewModels.ReceiptFormViewModel)ViewBag.Data;
}
<link rel="stylesheet" type="text/css" href="~/css/print/printform.css" media="print">
<style>
    body {
        background: #fff;
    }

    label {
        font-size: 13px;
    }

    .page {
        padding: 0.5cm;
        font: 10pt "Tahoma", Times, serif;
        z-index: 1000;
        width: 100%;
    }

    .form-wrap {
        padding: 7px;
    }

    .form-detail {
        border-bottom: 1px solid #ccc;
        font-size: 14px;
    }

    .header-col-1 {
        width: 150px;
        float: left;
        display: inline-block;
    }

    .header-col-6 {
        width: 400px;
        float: left;
        display: inline-block;
    }

    .header-col-3 {
        float: right;
        text-align: center;
        display: inline-block
    }

    .company-name {
        font-size: 16px;
        font-weight: bold;
    }

    .company-detail {
        font-size: 13px !important;
    }

    .topic-name {
        width: 100%;
        text-align: center;
        font-weight: bold;
        font-size: 16px;
        display: inline-block !important;
    }

    .table-bordered td, .table-bordered th {
        border: 1px solid #000 !important;
    }

    td.header-topic {
        text-align: center;
        vertical-align: middle !important;
        font-weight: bold;
    }

    .topic-customer-name, .topic-customer-tax {
        font-weight: bold;
        font-size: 13px;
    }

    .topic-customer-tax {
        margin-top: 10px;
    }

    .topic-customer-address {
        font-size: 13px;
        width: 350px;
        height: 40px;
    }

    .table {
        border-collapse: collapse;
    }

        .table th {
            padding: 5px !important;
            text-align: center !important;
        }

        .table td {
            padding: 3px !important;
        }

    table td.topic-body {
        font-weight: bold;
        text-align: center;
        height: 35px;
        vertical-align: middle !important;
    }

    .item-box {
        border: 1px solid #000;
        width: 20px;
        height: 20px;
        text-align: center;
        display: inline-block;
    }

    .stamp {
        text-align: center;
        position: relative;
        top: -35px !important;
        left: -30px !important;
    }

    .stamp-img {
        display: inline-block;
        opacity: 0.8;
    }

    @@media all {
        .page-break {
            display: none;
        }
    }

    @@media print {
        html, body {
            height: 99%;
        }
    }

    @@media print {
        .page-break {
            display: block;
            page-break-before: always;
        }
    }
</style>

@for (int i = 0; i < 2; i++)
{
    <div class="page">
        <div class="form-content">
            <div class="top-header">
                @{
                    Html.RenderPartial("Header");
                }
            </div>
            <br />
            <div class="topic-name">
                @if (i == 0)
                {
                    <div style="font-size:18px;font-weight:bold;">ต้นฉบับใบเสร็จรับเงิน</div>
                    <div style="font-size:18px;font-weight:bold;">ORIGINAL RECEIPT</div>
                }
                else
                {
                    <div style="font-size:18px;font-weight:bold;">สำเนาใบเสร็จรับเงิน</div>
                    <div style="font-size:18px;font-weight:bold;">COPY RECEIPT</div>
                }
            </div>
            <br />
            <div style="width:100%!important;">
                <table class="table table-bordered" style="width:96%;">
                    <tr>
                        <td rowspan="2" colspan="2">
                            <div style="width:390px;margin-top:10px;display:inline-block">
                                <div class="topic-customer-name">
                                    @data.customer_name
                                </div>
                                <div class="topic-customer-address">
                                    @data.customer_address
                                </div>
                                <div class="topic-customer-tax">
                                    Tax ID : @data.customer_tax
                                </div>
                            </div>
                        </td>
                        <td class="header-topic">
                            วันที่ / Date :
                        </td>
                        <td class="header-topic">
                            @data.receipt_date.ToString("dd MMMM yyyy", enCulture)
                        </td>
                    </tr>
                    <tr>
                        <td class="header-topic">เลขที่ / NO.</td>
                        <td class="header-topic">@data.receipt_part_code</td>
                    </tr>

                    <tr>
                        <td colspan="4" style="border-left:none!important;border-right:none!important;"></td>
                    </tr>

                    <tr>
                        <td style="width:50px" class="topic-body">ลำดับ</td>
                        <td colspan="2" class="topic-body">รายละเอียด</td>
                        <td style="width:150px;" class="topic-body">จำนวนเงิน</td>
                    </tr>
                    <tr>
                        <td class="topic-body">No.</td>
                        <td colspan="2" class="topic-body">Description</td>
                        <td class="topic-body">Total</td>
                    </tr>
                    <tr>
                        <td style="text-align:center;">1.</td>
                        <td colspan="2">@data.receipt_name</td>
                        <td style="text-align:right;">@data.transport_value.ToString("#,##0.00")</td>
                    </tr>
                    @if (data.is_excharge)
                    {
                        <tr>
                            <td style="text-align:center">2.</td>
                            <td colspan="2">@data.excharge_topic</td>
                            <td style="text-align:right;">
                                @data.advance_value.ToString("#,##0.00")
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>&nbsp;</td>
                            <td colspan="2">&nbsp;</td>
                            <td>&nbsp;</td>
                        </tr>
                    }
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2">&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>

                    <tr>
                        <td colspan="2" style="text-align:center;vertical-align:middle!important;">@this.ChangeCurrencyToText(data.transport_value)</td>
                        <td class="topic-body">ยอดเงินทั้งสิ้น</td>
                        <td style="text-align:right;padding-right:30px!important;vertical-align:middle!important">@data.transport_value.ToString("#,##0.00")</td>
                    </tr>
                    <tr>
                        <td colspan="2" style="vertical-align:middle!important;font-size:13px;">
                            <span style="font-weight:bold;">*** หมายเหตุ</span>
                            <span>@data.receipt_remark</span>
                        </td>
                        <td class="topic-body">เงินสำรองจ่าย</td>
                        <td style="text-align:right;padding-right:30px!important;vertical-align:middle!important">
                            @if (data.advance_value > 0)
                            {
                                <span>@data.advance_value.ToString("#,##0.00")</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>

            <div style="font-size:14px;width:100%;">
                <div style="font-weight:bold;margin-top:10px;">ชำระโดย</div>
                <div style="padding-left:20px;padding-top:10px;font-size:13px;">
                    <div>
                        <div class="item-box">
                            @if (data.receipt_type == "01")
                            {
                                <span>&#10004;</span>
                            }
                        </div>
                        <span style="margin-left:20px;">เงินสด</span>
                    </div>
                    <br />
                    <div>
                        <div class="item-box">
                            @if (data.receipt_type == "02")
                            {
                                <span>&#10004;</span>
                            }
                        </div>
                        @if (data.receipt_type == "02")
                        {
                            <span style="margin-left:20px;">โอนเงิน วันที่</span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:150px;padding-left:10px">
                                @if (data.receipt_date.ToString("yyyy") != "0001")
                                {
                                    @data.receipt_date.ToString("dd MMMM yyyy", enCulture)
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span style="margin-left:20px;">โอนเงิน วันที่</span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:90px;padding-left:10px"></div>
                        }
                    </div>
                    <br />
                    <div>
                        <div class="item-box">
                            @if (data.receipt_type == "03")
                            {
                                <span>&#10004;</span>
                            }
                        </div>
                        @if (data.receipt_type == "03")
                        {
                            <span style="margin-left:20px;">
                                เช็คธนาคาร
                            </span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:140px;padding-left:10px">@data.bank_name</div>
                            <span style="margin-left:10px;">
                                สาขา
                            </span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:100px;padding-left:10px">@data.bank_branch_name</div>
                            <span style="margin-left:10px;">
                                เลขที่
                            </span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:90px;padding-left:10px">@data.cheque_no</div>
                            <span style="margin-left:10px;">
                                ลงวันที่
                            </span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:90px;padding-left:10px">@data.receipt_date.ToString("dd-MM-yyyy", enCulture)</div>
                        }
                        else
                        {
                            <span style="margin-left:20px;">
                                เช็คธนาคาร
                            </span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:140px;padding-left:10px">&nbsp;</div>
                            <span style="margin-left:10px;">
                                สาขา
                            </span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:100px;padding-left:10px">&nbsp;</div>
                            <span style="margin-left:10px;">
                                เลขที่
                            </span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:90px;padding-left:10px">&nbsp;</div>
                            <span style="margin-left:10px;">
                                ลงวันที่
                            </span>
                            <div style="display:inline-block;border-bottom:1px dashed #000;width:90px;padding-left:10px">&nbsp;</div>
                        }

                    </div>
                </div>
            </div>
            <br />
            <div>
                ** ใบเสร็จรับเงินฉบับนี้จะสมบูรณ์เมื่อลงลายมือรับเงินเรียบร้อยแล้ว ถ้าชำระเป็นเช็คจะสมบูรณ์เมือได้รับเงินตามเช็คเรียบร้อยแล้ว
            </div>
            <br />
            <div>
                <div class="stamp">
                    <div class="stamp-img">
                        @{
                            Html.RenderPartial("Stamp");
                        }
                    </div>
                </div>
                <table style="width:100%;font-size:13px;">
                    <tr>
                        <td style="text-align:center;font-weight:bold;">ได้รับชำระเงินไว้ถูกต้องแล้ว<br />Payment received with thanks</td>
                        <td style="text-align:center;font-weight:bold;">ในนาม บริษัทเอวา โกลบอล โลจิสติกส์ จำกัด<br />For AVA GLOBAL LOGISTICS CO.,LTD</td>
                    </tr>
                    <tr>
                        <td style="text-align:center;font-weight:bold;height:120px">_____________________________<br />ลายมือชือผู้รับเงิน / Receipt Signature</td>
                        <td style="text-align:center;font-weight:bold;">_____________________________<br />ลายมือผู้มีอำนาจลงนาม / Authorized Signature</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    if (i == 0)
    {
        <div class="page-break"></div>
    }
}

@functions {
    private string ChangeCurrencyToText(decimal val)
    {
        string bahtTxt, n, bahtTH = "";
        double amount;
        try { amount = Convert.ToDouble(val); }
        catch { amount = 0; }
        bahtTxt = amount.ToString("####.00");
        string[] num = { "ศูนย์", "หนึ่ง", "สอง", "สาม", "สี่", "ห้า", "หก", "เจ็ด", "แปด", "เก้า", "สิบ" };
        string[] rank = { "", "สิบ", "ร้อย", "พัน", "หมื่น", "แสน", "ล้าน" };
        string[] temp = bahtTxt.Split('.');
        string intVal = temp[0];
        string decVal = temp[1];
        if (Convert.ToDouble(bahtTxt) == 0)
            bahtTH = "ศูนย์บาทถ้วน";
        else
        {
            for (int i = 0; i < intVal.Length; i++)
            {
                n = intVal.Substring(i, 1);
                if (n != "0")
                {
                    if ((i == (intVal.Length - 1)) && (n == "1"))
                        bahtTH += "เอ็ด";
                    else if ((i == (intVal.Length - 2)) && (n == "2"))
                        bahtTH += "ยี่";
                    else if ((i == (intVal.Length - 2)) && (n == "1"))
                        bahtTH += "";
                    else
                        bahtTH += num[Convert.ToInt32(n)];
                    bahtTH += rank[(intVal.Length - i) - 1];
                }
            }
            bahtTH += "บาท";
            if (decVal == "00")
                bahtTH += "ถ้วน";
            else
            {
                for (int i = 0; i < decVal.Length; i++)
                {
                    n = decVal.Substring(i, 1);
                    if (n != "0")
                    {
                        if ((i == decVal.Length - 1) && (n == "1"))
                            bahtTH += "เอ็ด";
                        else if ((i == (decVal.Length - 2)) && (n == "2"))
                            bahtTH += "ยี่";
                        else if ((i == (decVal.Length - 2)) && (n == "1"))
                            bahtTH += "";
                        else
                            bahtTH += num[Convert.ToInt32(n)];
                        bahtTH += rank[(decVal.Length - i) - 1];
                    }
                }
                bahtTH += "สตางค์";
            }
        }
        return bahtTH;
    }

}