@model TMSWeb.Models.ViewModels.BillingPdfFormViewModel
@{
    Layout = null;

    var enCulture = new System.Globalization.CultureInfo("en-US", false);
    var data = Model.billing;
    var advance = Model.advance;
    var customer = Model.customer;

    string code = Model.billing_code;
    decimal row = data.Count();

    int pg = (int)Math.Ceiling(row / 20);
    pg = (row >= 41 && row <= 50 ? pg - 1 : pg);
    pg = (row >= 61 && row <= 100 ? pg - 1 : pg);
    pg = (row >= 101 && row <= 160 ? pg - 2 : pg);
    pg = (row >= 151 && row <= 170 ? pg - 3 : pg);
}
<link rel="stylesheet" type="text/css" href="~/css/print/printform.css" media="print">
