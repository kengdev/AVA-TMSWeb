                                <td class="currency">@Model.s_port.ToString("#,##0.00")</td>
                                <td class="currency">@Model.s_lifton.ToString("#,##0.00")</td>
                                <td class="currency">@Model.s_liftoff.ToString("#,##0.00")</td>
                                <td class="currency">@Model.net_transport_total.ToString("#,##0.00")</td>
                            </tr>
                            <tr>
