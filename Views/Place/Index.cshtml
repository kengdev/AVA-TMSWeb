@{
    ViewBag.TopActive = "Base";
    ViewBag.MidActive = "place";
    ViewBag.SubActive = "industry";
    ViewBag.Title = "ข้อมูลสถานที่เปิดตู้/บรรจุ";
}
@section Styles{
    <style>
        table.dataTable td, table.dataTable th {
            font-size: 13px !important;
        }
        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">ข้อมูลหลัก</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="javascript:;">ข้อมูลสถานที่</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/place/">ข้อมูลสถานที่เปิด/บรรจุ</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> รายการสถานที่เปิดตู้/บรรจุ</span>
                </div>
                <div class="actions">

                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-6">

                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right">
                            <a href="/place/add" class="btn btn-sm red">เพิ่มข้อมูล</a>
                        </div>
                    </div>
                </div>
                <table class="table table-striped table-bordered table-hover table-checkable order-column" id="table-place">
                    <thead>
                        <tr>
                            <th></th>
                            <th>รหัสท่าเรือ</th>
                            <th> ชื่อสถานที่</th>
                            <th>โซน</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr role="row" class="heading">
                            <th class="filter"></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterCustomer" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameTH" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameEN" /></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm("Edit", "Place", FormMethod.Post, new { id = "submit_edit" }))
{
    @Html.Hidden("place_code")
}

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            var oTable = $('#table-place').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[1, "desc"]],
                "sAjaxSource": "/Place/GetPlaceDataList",
                "fnRowCallback": function (row, aData, index) {

                },
                "fnServerParams": function (aoData) {
                    aoData.push({ "name": "filterCustomer", "value": $("#filterCustomer").val() });
                    aoData.push({ "name": "filterNameTH", "value": $("#filterNameTH").val() });
                    aoData.push({ "name": "filterNameEN", "value": $("#filterNameEN").val() });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                            '<option value="10">10</option>' +
                            '<option value="20" selected>20</option>' +
                            '<option value="30">30</option>' +
                            '<option value="40">40</option>' +
                            '<option value="50">50</option>' +
                            '<option value="100">100</option>' +
                            '</select> รายการ'
                },
                "columnDefs": [
                      { className: "action-3-td text-center", targets: 0 },
                      { className: "code-td", targets: 1 },
                      { className: "name-td", targets: 2 },
                      { className: "name-td", targets: 3 },
                ],
                "columns":
                [
                      {
                          "data": "place_code", "orderable": false, "render": function (data, type, row) {
                                var modify = '<a class="btn btn-xs yellow" href="javascript:;" data-title="แก้ไขข้อมูล"  data-toggle="tooltip" data-trigger="hover" onclick=setEdit("' + data + '")><i class="fad fa-pencil-alt"></i></a>';
                                var remove = '<a class="btn btn-xs red" href="javascript:;" data-title="ลบข้อมูล"  data-toggle="tooltip" data-trigger="hover" onclick=setDisabled("' + data + '")><i class="fad fa-trash-alt"></i></a>';
                                var active = '<a class="btn btn-xs green-jungle" href="javascript:;" data-title="เปิดใช้งาน"  data-toggle="tooltip" data-trigger="hover" onclick=setActive("' + data + '")><i class="fa fa-check"></i></a>';
                                var inactive = '<a class="btn btn-xs grey" href="javascript:;" data-title="ปิดใช้งาน"  data-toggle="tooltip" data-trigger="hover" onclick=setInactive("' + data + '")><i class="fa fa-times"></i></a>';

                                if (row.is_actived) {
                                    return inactive + remove + modify;
                                } else {
                                    return active + remove;
                                }
                          }
                      },
                      { "data": "place_port_code" },
                      { "data": "place_name" },
                      { "data": "zone_name" }
                ],
                "createdRow": function (row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-place tfoot tr').appendTo('#table-place thead');

            $('.filterText').keyup(function () {
                $('#table-place').dataTable()._fnAjaxUpdate();
            });
        });

        function reloadRow() {
            $("#table-place").DataTable().ajax.reload();
        }

        function setAdd() {
            var url = '/place/add';
            var setting = 'width=900,height=665';

            window.open(url, 'add place', setting);
        }

        function setEdit(code) {
            var url = '/place/edit?code=' + code;
            window.location = url;
        }

        function setDisabled(code) {
            $.alert.open('confirm', 'คุณต้องการลบข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function (r) {
                if (r) {
                    overLayPage();
                    $.post("/Place/Remove",
                            {
                                code: code
                            }, function (data) {
                                killOverlayPage();
                                if (data.result == true) {
                                    $.alert.open('info', data.resultMessage, function (r) {
                                        $('#table-place').dataTable()._fnAjaxUpdate();
                                    });
                                } else {
                                    $.alert.open('error', data.resultMessage);
                                }
                            });
                }
            });
        }

        function setActive(code) {
            $.alert.open('confirm', 'คุณต้องการเปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function (r) {
                if (r) {
                    overLayPage();
                    $.post("/Place/Active", {
                        code: code
                    }, function (data) {
                        killOverlayPage();
                        if (data.result == true) {
                            $.alert.open('info', data.resultMessage, function (r) {
                                $('#table-place').dataTable()._fnAjaxUpdate();
                            });
                        } else {
                            $.alert.open('error', data.resultMessage);
                        }
                    });
                }
            });
        }

        function setInactive(code) {
            $.alert.open('confirm', 'คุณต้องการปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function (r) {
                if (r) {
                    overLayPage();
                    $.post("/Place/Inactive", {
                        code: code
                    }, function (data) {
                        killOverlayPage();
                        if (data.result == true) {
                            $.alert.open('info', data.resultMessage, function (r) {
                                $('#table-place').dataTable()._fnAjaxUpdate();
                            });
                        } else {
                            $.alert.open('error', data.resultMessage);
                        }
                    });
                }
            });
        }
    </script>
}