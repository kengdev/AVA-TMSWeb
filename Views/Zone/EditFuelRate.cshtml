@{
    ViewBag.TopActive = "Base";
    ViewBag.MidActive = "place";
    ViewBag.SubActive = "zone";
    ViewBag.Title = "ข้อมูลโซนที่ตั้ง";
    var data = (List<TMSWeb.Models.ViewModels.ZoneViewModel>)ViewBag.Data;
}
@section Styles {
    <style>
        .rate-name {
            text-align: center;
            font-weight: bold !important;
            font-size: 13px !important;
        }

        .table th {
            font-size: 11px !important;
            font-weight: bold !important;
        }

        .table td {
            font-size: 13px !important;
        }

        .rate {
            text-align: right;
        }

        .zone {
            font-weight: bold;
        }

        .form-number {
            width: 100px;
            height: 25px !important;
            font-size: 13px;
        }

        .box-value {
            text-align: center !important;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <li>
                <a href="javascript:;">ข้อมูลหลัก</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a href="javascript:;">ข้อมูลสถานที่</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a href="/zone/">ข้อมูลโซนที่ตั้ง</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a href="/zone/editfuelrate">แก้ไขเรทน้ำมัน</a>
            </li>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 ">
        <!-- BEGIN SAMPLE FORM PORTLET-->
        <div class="portlet light bordered">
            <div class="portlet-title tabbable-line">
                <div class="caption font-dark">
                    <i class="icon-note font-dark"></i>
                    <span class="caption-subject bold uppercase"> แก้ไขเรทน้ำมัน</span>
                </div>
            </div>

            <div class="portlet-body">
                @using (Html.BeginForm("EditRate", "Zone", FormMethod.Post, new
                {
                    id = "frmEditRate",
                    onsubmit =
                "return OnValidate()"
                }))
                {
                    <table class="table table-striped table-bordered table-advance table-hover">
                        <thead>
                            <tr>
                                <th>โซน</th>
                                <th>4TR</th>
                                <th>6TR</th>
                                <th>10TR</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in data)
                            {
                                <tr>
                                    <td>
                                        @item.zone_name
                                        @Html.Hidden("zone", item.zone_code)
                                    </td>
                                    <td>
                                        @Html.TextBox("tr4", item.tr4, new { @Class = "form-control form-number" })
                                    </td>
                                    <td>
                                        @Html.TextBox("tr6", item.tr6, new { @Class = "form-control form-number" })
                                    </td>
                                    <td>
                                        @Html.TextBox("tr10", item.tr10, new { @Class = "form-control form-number" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <hr />
                    <div class="form-actions">
                        <div class="row">
                            <div class="col-md-12">
                                <a href="/zone/">กลับหน้าหลัก</a> |
                                <button type="submit" class="btn green">บันทึกข้อมูล</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script type="text/javascript">
        (function($) {
            $("#frmEditRate").ajaxForm(function(data) {
                overLay();
                if (data.result == true) {
                    unoverLay();
                    $.alert.open('info', data.resultMessage, function(r) {
                        window.location.reload();
                    });
                } else {
                    unoverLay();
                    $.alert.open('error', data.resultMessage);
                }
            });
        }(jQuery));

        function OnValidate() {
            overLay();
        }
    </script>
}