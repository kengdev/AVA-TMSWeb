@{
    ViewBag.TopActive = "File";
    ViewBag.MidActive = "vat";
    ViewBag.Title = "ข้อมูลเอกสารหัก ณ ที่จ่าย";
}

@section Styles {
    <style>
        table.dataTable td,
        table.dataTable th {
            font-size: 13px !important;
        }

        #modal-supplyer-payment {
            width: 600px !important;
            height: 430px !important;
            background-color: #fff;
            ;
        }

        #form-content {
            padding: 20px !important;
        }

        #form-title {
            width: 100%;
            background-color: #a37f48;
            padding: 7px 5px 7px 5px;
            font-size: 14px;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }

        h4 {
            font-size: 14px;
        }

        #form-action {
            border-top: 1px solid #edeadf;
            width: 100%;
            padding: 15px 20px 13px 20px;
            text-align: right;
        }

        .license-td {
            width: 110px !important;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/vatinvoice/">เอกสารหัก ณ ที่จ่าย</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> รายการเอกสารหัก ณ ที่จ่าย</span>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn-sm blue btn-circle btn-outline" onclick="getPdf()">
                        <i class="fad fa-download"></i> ดาวน์โหลด
                    </button>
                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-6">
                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right" role="form">
                            <div class="form-group">
                                @Html.DropDownList("month", null, new { @Class = "form-control dlListForm" })
                            </div>
                            <div class="form-group">
                                @Html.DropDownList("year", null, new { @Class = "form-control dlListForm", Style = "width:90px;" })
                            </div>
                            |
                            <!--<button type="button" class="btn btn-sm red" onclick="setAddAVA()">ทำรายการ</button>-->
                        </div>
                    </div>
                </div>
                <table class="table table-striped table-bordered table-hover" id="table-payment">
                    <thead>
                        <tr>
                            <th style="text-align:center!important;"></th>
                            <th> เลขที่</th>
                            <th> วันที่จัดทำ</th>
                            <th> ชื่อ</th>
                            <th> รายการ</th>
                            <th> ยอดเงิน</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr role="row" class="heading">
                            <th class="filter"></th>
                            <th class="filter"></th>
                            <th class="filter"></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameTH" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameEN" /></th>
                            <th class="filter"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        (function($) {
            var oTableBilling = $('#table-payment').DataTable({
                "processing": true,
                "searching": false,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [
                    [1, "desc"]
                ],
                "sAjaxSource": "/VatInvoice/GetInvoiceDataList",
                "fnRowCallback": function(row, aData, index) {

                    $('td', row).eq(5).html(number_format(aData.net_total));
                },
                "fnServerParams": function(aoData) {
                    aoData.push({
                        "name": "month",
                        "value": $("#month").val()
                    });
                    aoData.push({
                        "name": "year",
                        "value": $("#year").val()
                    });
                    aoData.push({
                        "name": "filterNameTH",
                        "value": $("#filterNameTH").val()
                    });
                    aoData.push({
                        "name": "filterNameEN",
                        "value": $("#filterNameEN").val()
                    });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [{
                    className: "action-3-td text-center",
                    targets: 0
                },
                {
                    className: "code-td",
                    targets: 1
                },
                {
                    className: "date-td",
                    targets: 2
                },
                {
                    className: "name-td",
                    targets: 3
                },
                {
                    className: "name-td",
                    targets: 4
                },
                {
                    className: "currency-td",
                    targets: 5
                }
                ],
                "columns": [{
                    "data": "code",
                    "orderable": false,
                    "render": function(data, type, row) {
                        var modify =
                            '<a class="btn btn-xs yellow" href="javascript:;" data-title="แก้ไขข้อมูล" data-toggle="tooltip" data-trigger="hover" onclick=setEdit("' +
                            data + '")><i class="fad fa-pencil"></i></a>';
                        var remove =
                            '<a class="btn btn-xs red" href="javascript:;" data-title="ลบข้อมูล" data-toggle="tooltip" data-trigger="hover" onclick=setDisabled("' +
                            data + '")><i class="fad fa-trash"></i></a>';
                        var print =
                            '<a href="javascript:;" class="btn btn-xs grey" data-title="รายละเอียด" data-toggle="tooltip" data-trigger="hover" onclick=setPrint("' +
                            data + '")><i class="fad fa-print"></i></a>';

                        return remove + print;
                    }
                },
                {
                    "data": "code"
                },
                {
                    "data": "create_date"
                },
                {
                    "data": "supplier_name"
                },
                {
                    "data": "payment_name"
                },
                {
                    "data": "net_total"
                }
                ],
                "createdRow": function(row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-payment tfoot tr').appendTo('#table-payment thead');

            $('.filterText').keyup(function() {
                $('#table-payment').dataTable()._fnAjaxUpdate();
            });

            $('.dlListForm').change(function() {
                reloadRow();
            });
        }(jQuery));
        var intervalId;

        function setAddAVA() {
            var url = '/vatinvoice/add';

            window.location = url;
        }

        function setEdit(code) {
            var url = '/vatinvoice/edit?code=' + code;

            window.location = url;
        }

        function getPdf() {

            var month = $('#month').val();
            var year = $('#year').val();

            var url = '/form/GetPND50PDFList?month=' + month + '&year=' + year;
            window.open(url, 'form list');
        }

        function setPrint(code) {
            url = '/form/PND50?code=' + code;

            window.open(url, 'Print Station');
        }

        function setDisabled(code) {
            $.alert.open('confirm', 'คุณต้องการยกเลิกข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLay();
                    $.post("/VatInvoice/Remove", {
                        code: code,
                    }, function(result) {
                        unoverLay();
                        if (result == true) {
                            $.alert.open('info', "ยกเลิกข้อมูลเรียบร้อยแล้ว", function(r) {
                                $('#table-payment').dataTable()._fnAjaxUpdate();
                            });
                        } else {
                            $.alert.open('error',
                                "<div>เกิดข้อผิดลพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>"
                            );
                        }
                    });
                }
            });
        }

        function reloadRow() {
            $("#table-payment").DataTable().ajax.reload();
        }

        function setPrintPayment(code) {
            url = '/form/fleetallowance?code=' + code;
            window.open(url, 'Print Station');
        }

        function setPrintPND50(code) {
            url = '/form/PND50?code=' + code;

            var setting = 'width=900,height=665';
            window.open(url, 'Print Station', setting);
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}