@model TMSWeb.Models.Entities.LOG.TblCustomer
@{
    ViewBag.TopActive = "Base";
    ViewBag.MidActive = "customer";
    ViewBag.Title01 = "ข้อมูลลูกค้า";
}
@section Styles {
    <style>
        #simplemodal-container {
            height: 600px;
            width: 800px;
        }

        .checkbox-lable {
            display: inline-block;
            width: 110px;
            font-size: 13px;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">ข้อมูลหลัก</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/customer/">ข้อมูลลูกค้า</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/customer/add">เพิ่ม</a>
        </li>
    </ul>
</div>
<br />
<div class="col-md-12 ">
    <!-- BEGIN SAMPLE FORM PORTLET-->
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-plus-circle"></i>
                <span class="caption-subject bold uppercase"> เพิ่มรายการ</span>
            </div>
        </div>
        @using (Html.BeginForm("AddCustomer", "Customer", FormMethod.Post, new { id = "frmAdd", onsubmit = "return OnValidate()" }))
        {
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6 col-sm-6">
                            <div class="form-group">
                                <label>
                                    เลขประจำตัวผู้เสียภาษี
                                    <span class="required"> * </span>
                                </label>
                                <div class="input-icon right">
                                    <i></i>
                                    @Html.TextBoxFor(m => m.CustomerVatNo, new { id = "txtVatNo", Class = "form-control form-number", autocomplete = "Off" })
                                    <span class="help-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>
                                    อักษรย่อ 3 ตัวอักษร
                                    <span class="required"> * </span>
                                </label>
                                <div class="input-icon right">
                                    <i></i>
                                    @Html.TextBoxFor(m => m.CustomerAcronym, new { id = "txtAcronym", @Class = "form-control dlList", autocomplete = "Off" })
                                    <span class="help-block"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>
                                    Vendor Code
                                    <span class="required"> * </span>
                                </label>
                                <div class="input-icon right">
                                    <i></i>
                                    @Html.TextBoxFor(m => m.VendorCode, new { id = "txtVendor", @Class = "form-control", autocomplete = "Off" })
                                    <span class="help-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-sm-6">
                            <div class="form-group">
                                <label>
                                    ระบุสำนักงานใหญ่/สาขา
                                    <span class="required"> * </span>
                                </label>
                                @Html.DropDownList("branch_type", null, "-----เลือก-----", new { @Class = "form-control dlList" })
                                <span class="help-block"></span>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-6">
                            <div class="form-group">
                                <label>
                                    สาขา
                                </label>
                                @Html.TextBoxFor(m => m.CustomerExten, new
                                {
                                    id = "txtExten",
                                    Class = "form-control",
                                    Disabled = "disabled"
                                })
                                <span class="help-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-sm-12">
                            <div class="form-group">
                                <label>
                                    ชื่อ (ภาษาไทย)
                                    <span class="required"> * </span>
                                </label>
                                @Html.TextBoxFor(m => m.CustomerNameTh, new { id = "txtNameTh", Class = "form-control", autocomplete = "Off" })
                                <span class="help-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-sm-12">
                            <div class="form-group">
                                <label>
                                    ชื่อ (ภาษาอังกฤษ)
                                    <span class="required"> * </span>
                                </label>
                                @Html.TextBoxFor(m => m.CustomerNameEn, new { id = "txtNameEn", Class = "form-control form-en", autocomplete = "Off" })
                                <span class="help-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>
                                    ที่อยู่
                                    <span class="required"> * </span>
                                </label>
                                @Html.TextBoxFor(m => m.CustomerAddress, new { id = "txtAddress", Class = "form-control", autocomplete = "Off" })
                                <span class="help-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>หัวข้อสำหรับเอกสาร</label>
                                <div class="mt-radio-inline">
                                    <label class="mt-radio">
                                        <input type="radio" class="rdoDocType" name="DocType" value="JN" checked /> Job No
                                        <span></span>
                                    </label>
                                    <label class="mt-radio">
                                        <input type="radio" class="rdoDocType" name="DocType" value="BN" /> Booking No
                                        <span></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>การสำรองจ่ายภาระค่าขนส่ง</label>
                                <div class="mt-checkbox-inline">
                                    <label class="mt-checkbox mt-checkbox-outline">
                                        <input type="checkbox" id="chkLiftOn" value="TRUE" name="IsLiftOn" />
                                        <div class="checkbox-lable">Lift On</div>
                                        <span></span>
                                    </label>
                                    <label class="mt-checkbox mt-checkbox-outline">
                                        <input type="checkbox" id="chkLiftOff" value="TRUE" name="IsLiftOff" />
                                        <div class="checkbox-lable">Lift Off</div>
                                        <span></span>
                                    </label>
                                    <label class="mt-checkbox mt-checkbox-outline">
                                        <input type="checkbox" id="chkYard" value="TRUE" name="IsYard" />
                                        <div class="checkbox-lable">ค่าผ่านลาน</div>
                                        <span></span>
                                    </label>
                                    <label class="mt-checkbox mt-checkbox-outline">
                                        <input type="checkbox" id="chkPort" value="TRUE" name="IsPort" />
                                        <div class="checkbox-lable">ค่าผ่านท่า</div>
                                        <span></span>
                                    </label>
                                    <br />
                                    <label class="mt-checkbox mt-checkbox-outline">
                                        <input type="checkbox" id="chkPort" value="TRUE" name="IsTransportOther" />
                                        <div class="checkbox-lable">รวมค่าใช้จ่ายอื่น ๆ</div>
                                        <span></span>
                                    </label>
                                    <label class="mt-checkbox mt-checkbox-outline">
                                        <input type="checkbox" id="chkPort" value="TRUE" name="IsBypassTripcost" />
                                        <div class="checkbox-lable">บายพาสการวางบิล</div>
                                        <span></span>
                                    </label>
                                    <label class="mt-checkbox mt-checkbox-outline">
                                        <input type="checkbox" id="chkPort" value="TRUE" name="IsLiftCashing" />
                                        <div class="checkbox-lable">จ่ายค่ายกเป็นเงินสด</div>
                                        <span></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row pull-right">
                        <div class="col-md-12">
                            <div class="tools-action">
                                <a href="/customer/">กลับหน้าหลัก</a> |
                                <button type="submit" class="btn green">บันทึกข้อมูล</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>

@section scripts
{
    <script src="~/js/autocomplete/bootstrap3-typeahead.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        var isDuplicateVat = true;
        var isDuplicateAcronym = true;
        (function($) {
            $("#frmAdd").ajaxForm(function(data) {
                killOverlayForm();
                if (data.result == true) {
                    $.alert.open('info', data.resultMessage, function(r) {
                        window.location.reload();
                    });
                } else {
                    $.alert.open('error', data.resultMessage);
                }
            });

            $('#txtVatNo').change(function() {
                var txtVatNo = $(this).val()
                $(this).prop('readonly', true)
                $(this).closest('div.input-icon').find('i').addClass('far fa-sync-alt fa-spin font-grey-mint');
                $.post("/Customer/IsVatNoDuplicate", {
                    vat_no: txtVatNo
                }, function(result) {
                    $('#txtVatNo').prop('readonly', false)
                    $('#txtVatNo').closest('div.input-icon').find('i').removeClass('far fa-sync-alt fa-spin');
                    if (result) {
                        isDuplicateVat = true;
                        $('#txtVatNo').closest("div.form-group").addClass("has-error");
                        $('#txtVatNo').next(".help-block").html("เลขประจำตัวผู้เสียภาษีนี้ถูกใช้ในระบบแล้ว กรุณาตรวจสอบความถูกต้อง");
                    }
                    else {
                        isDuplicateVat = false;
                        $('#txtVatNo').closest("div.form-group").removeClass("has-error");
                        $('#txtVatNo').next(".help-block").html('');
                    }
                });
            });

            $('#txtAcronym').change(function() {
                var name = $(this).val()
                $(this).prop('readonly', true)
                $(this).closest('div.input-icon').find('i').addClass('far fa-sync-alt fa-spin font-grey-mint');
                $.post("/Customer/IsAcronymDuplicate", {
                    name: name
                }, function(result) {
                    $('#txtAcronym').prop('readonly', false)
                    $('#txtAcronym').closest('div.input-icon').find('i').removeClass('far fa-sync-alt fa-spin');
                    if (result) {
                        isDuplicateAcronym = true;
                        $('#txtAcronym').closest("div.form-group").addClass("has-error");
                        $('#txtAcronym').next(".help-block").html("อักษรย่อนี้ถูกใช้ในระบบแล้ว กรุณาเปลี่ยนเป็นรหัสอื่น");
                    }
                    else {
                        isDuplicateAcronym = false;
                        $('#txtAcronym').closest("div.form-group").removeClass("has-error");
                        $('#txtAcronym').next(".help-block").html('');
                    }
                });
            });

            $('#branch_type').change(function() {
                var val = $(this).val();
                if (val == '2') {
                    $('#txtExten').prop('disabled', false)
                } else {
                    $('#txtExten').val('');
                    $('#txtExten').prop('disabled', true)
                }
            });
        }(jQuery));

        function OnValidate() {
            var fn = $('#frmAdd').myfunction({
                rules: {
                    txtNameTh: {
                        require: {
                            value: true,
                            message: "กรุณาพิมพ์ชื่อลูกค้า (ภาษาไทย)"
                        },
                        minlength: {
                            value: 6,
                            message: "กรุณาพิมพ์ข้อความอย่างน้อย 6 ตัวอักษร"
                        }
                    },
                    txtNameEn: {
                        require: {
                            value: true,
                            message: "กรุณาพิมพ์ชื่อลูกค้า (ภาษาอังกฤษ) หากไม่มีพิมพ์ -"
                        }
                    },
                    txtVatNo: {
                        require: {
                            value: true,
                            message: "กรุณาพิมพ์เลขประจำตัวผู้เสียภาษี หากไม่มีพิมพ์ -"
                        },
                        duplicate: {
                            value: isDuplicateVat,
                            message: "เลขประจำตัวผู้เสียภาษีนี้ถูกใช้ในระบบแล้ว กรุณาตรวจสอบความถูกต้อง"
                        }
                    },
                    txtAcronym: {
                        require: {
                            value: true,
                            message: "กรุณาพิมพ์อักษรย่อของลูกค้า"
                        },
                        minlength: {
                            value: 3,
                            message: "กรุณาพิมพ์ข้อความอย่างน้อย 3 ตัวอักษร"
                        },
                        duplicate: {
                            value: isDuplicateAcronym,
                            message: "อักษรย่อนี้ถูกใช้ในระบบแล้ว กรุณาเปลี่ยนอักษรย่อ"
                        }
                    },
                    txtAddress: {
                        require: {
                            value: true,
                            message: "กรุณาพิมพ์ที่อยู่ หากไม่มีพิมพ์ -"
                        }
                    },
                    branch_type: {
                        selected: {
                            value: true,
                            message: "กรุณาเลือกข้อมูล"
                        }
                    },
                    txtExten: {
                        other_text: {
                            value: true,
                            message: "กรุณาพิมพ์ชื่อสาขา"
                        }
                    }
                }
            })

            if (fn) {
                if (isDuplicateAcronym == false && isDuplicateVat == false) {
                    overLayForm();
                    return true;
                }
                else {
                    return false;
                }
            }
            else {
                return false;
            }
        }
    </script>
}