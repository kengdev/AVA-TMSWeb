@{
    ViewBag.TopActive = "Base";
    ViewBag.MidActive = "supplier";
    ViewBag.Title = "ข้อมูลบริษัทร่วมงาน";
}
@section Styles{
    <style>
        .action-td {
            width: 60px !important;
            padding-left: 15px !important;
            text-align: center;
        }
        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }
        .rate-td {
            text-align: right;
            width: 80px !important;
        }
        .phone-td{
            width:170px!important;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">ข้อมูลหลัก</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/supplier/">ข้อมูลบริษัทร่วม</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"></span> รายการบริษัทร่วม</span>
                </div>
                <div class="actions">

                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-6">

                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right">
                            <button type="button" class="btn btn-sm red" onclick="setAdd()">เพิ่มข้อมูล</button>
                        </div>
                    </div>
                </div>
                <table class="table table-striped table-bordered table-hover table-checkable order-column" id="table-supplyer">
                    <thead>
                        <tr>
                            <th></th>
                            <th> ชื่อบริษัท</th>
                            <th> เบอร์โทรศัพท์</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr role="row" class="heading">
                            <th class="filter"></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterNameTH" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterPhone" /></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            var oTable = $('#table-supplyer').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[1, "asc"]],
                "sAjaxSource": "/Supplier/GetSupplierDataList",
                "fnServerParams": function (aoData) {
                    aoData.push({ "name": "filterNameTH", "value": $("#filterNameTH").val() });
                    aoData.push({ "name": "filterPhone", "value": $("#filterPhone").val() });
                },
                "fnRowCallback": function (row, aData, index) {
                    if (!aData.is_actived)
                    $(row).addClass('inactive');
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-3-td", targets: 0 },
                    { className: "name-td", targets: 1 },
                    { className: "phone-td", targets: 2 }
                ],
                "columns":
                    [
                        {
                            "data": "supplier_code", "orderable": false, "render": function (data, type, row) {
                                var modify =
                                    '<a class="btn btn-xs yellow" href="javascript:;" data-title="แก้ไขข้อมูล"  data-toggle="tooltip" data-trigger="hover" onclick=setEdit("' +
                                    data + '")><i class="fad fa-pencil-alt"></i></a>';
                                var remove =
                                    '<a class="btn btn-xs red" href="javascript:;" data-title="ลบข้อมูล"  data-toggle="tooltip" data-trigger="hover" onclick=setDisabled("' +
                                    data + '")><i class="fad fa-trash-alt"></i></a>';
                                var active =
                                    '<a class="btn btn-xs green-jungle" href="javascript:;" data-title="เปิดใช้งาน"  data-toggle="tooltip" data-trigger="hover" onclick=setActive("' +
                                    data + '")><i class="fa fa-check"></i></a>';
                                var inactive =
                                    '<a class="btn btn-xs grey" href="javascript:;" data-title="ปิดใช้งาน"  data-toggle="tooltip" data-trigger="hover" onclick=setInactive("' +
                                    data + '")><i class="fa fa-times"></i></a>';

                                if (row.is_actived) {
                                    return inactive + remove + modify;
                                } else {
                                    return active + remove;
                                }
                            }
                        },
                        { "data": "supplier_name" },
                        { "data": "supplier_phone", "orderable": false }
                    ],
                "createdRow": function (row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-supplyer tfoot tr').appendTo('#table-supplyer thead');

            $('.filterText').keyup(function () {
                $('#table-supplyer').dataTable()._fnAjaxUpdate();
            });
        });

        function reloadRow() {
            $("#table-supplyer").DataTable().ajax.reload();
        }

        function setAdd() {
            var url = '/supplier/add';
            window.location = url;
        }

        function setEdit(code) {
            var url = '/supplier/edit?code=' + code;
            window.location = url;
        }

        function setDisabled(code) {
            $.alert.open('confirm', 'คุณต้องการลบข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function (r) {
                if (r) {
                    overLayPage();
                    $.post("/Supplier/Remove",
                        {
                            code: code
                        }, function (data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function (r) {
                                    $('#table-supplyer').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                $.alert.open('error', data.resultMessage);
                            }
                        });
                }
            });
        }

        function setActive(code) {
            $.alert.open('confirm', 'คุณต้องการเปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function (r) {
                if (r) {
                    overLayPage();
                    $.post("/Supplier/Active",
                        {
                            code: code
                        }, function (data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function (r) {
                                    $('#table-supplyer').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                $.alert.open('error', data.resultMessage);
                            }
                        });
                }
            });
        }

        function setInactive(code) {
            $.alert.open('confirm', 'คุณต้องการปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function (r) {
                if (r) {
                    overLayPage();
                    $.post("/Supplier/Inactive",
                        {
                            code: code
                        }, function (data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function (r) {
                                    $('#table-supplyer').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                $.alert.open('error', data.resultMessage);
                            }
                        });
                }
            });
        }
    </script>
}
