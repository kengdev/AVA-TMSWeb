@model TMSWeb.Models.Entities.LOG.TblDailypayment
@{
    Layout = null;
    var enCulture = new System.Globalization.CultureInfo("en-US", false);
    var row = 16 - Model.TblDailypaymentDetails.Count();
    int index = 0;
}
<link rel="stylesheet" type="text/css" href="~/css/print/printform.css" media="print">
<style>
    .page {
        font: 10pt "Tahoma", Times, serif;
        z-index: 1000;
        width: 100%;
    }

    .header {
        margin-top: 15px
    }

    .header-col-1 {
        width: 150px;
        float: left;
        display: inline-block;
    }

    .header-col-6 {
        width: 400px;
        float: left;
        display: inline-block;
    }

    .header-col-4 {
        width: 350px;
        float: left;
        text-align: left;
        display: inline-block
    }

    .right {
        text-align: right;
    }

    .font-18 {
        font-size: 18px;
    }

    .company-name {
        font-size: 16px;
        font-weight: bold;
    }

    .company-detail {
        font-size: 13px !important;
    }

    .font-16 {
        font-size: 16px;
    }

    .font-14 {
        font-size: 14px;
    }

    .bold {
        font-weight: bold;
    }

    .wrap-box {
        padding-top: 10px;
    }

    .topic-name {
        display: inline-block;
    }

    .topic-detail {
        display: inline-block;
        margin-left: 10px;
    }

    .topic-detail-underline {
        display: inline-block;
        margin-left: 10px;
        border-bottom: 1px solid #444444;
    }

    .box-50 {
        width: 35px;
        text-align: left;
        padding-left: 10px
    }

    .box-70 {
        width: 60px;
        text-align: left;
    }

    .box-140 {
        width: 120px;
        text-align: left;
        padding-left: 10px
    }

    .box-170 {
        width: 170px;
        text-align: left;
        padding-left: 10px
    }

    .box-500 {
        width: 500px;
        text-align: left;
        padding-left: 10px
    }

    .box-inline {
        display: inline-block;
    }

    .clearboth {
        clear: both
    }

    .payment {
        margin-top: 15px;
    }

    .item-box {
        border: 1px solid #000;
        width: 20px;
        height: 20px;
        text-align: center;
        display: inline-block;
    }

    .payment-detail {
        border-collapse: collapse;
        width: 100%;
    }

        .payment-detail th {
            border: 1px solid #000;
            padding: 5px !important;
            text-align: center !important;
            height: 35px;
            font-size: 14px
        }

        .payment-detail td {
            border: 1px solid #000;
            padding: 3px !important;
            height: 35px;
            font-size: 14px
        }

    .text-center, td.text-center {
        text-align: center;
    }

    .text-red {
        color: red;
    }

    td.text-right {
        text-align: right;
        padding-right: 7px !important;
    }

    td.index {
        text-align: center;
        width: 70px
    }

    td.quantity {
        text-align: center;
        width: 70px !important
    }

    td.date, td.doc {
        width: 130px;
        height: 35px;
    }

    td.description {
        padding-left: 7px !important;
    }

    td.amount {
        width: 110px;
        border-right: 1px solid #000;
    }

    tfoot td {
        border: 1px solid #000
    }

    .footer {
        margin-top: 20px;
    }

    .stamp {
        text-align: center;
        position: absolute;
        bottom: 170px !important;
        left: 250px !important;
    }

    .stamp-img {
        display: inline-block;
        opacity: 0.8;
    }

    .sign {
        text-align: center;
        position: relative;
        top: -10px !important;
        left: 0px !important;
    }

    .sign-img {
        display: inline-block;
    }

    .approve-topic {
        position: relative;
        top: -60px !important;
    }

    .receiver-topic {
        position: relative;
        top: -11px !important;
    }

    .approve-fullname {
        position: relative;
        top: -40px;
    }

    .receiver-fullname {
        position: relative;
        top: 10px;
        font-weight: 100;
    }

    .approve-date {
        position: relative;
        top: -30px;
        font-weight: 100;
    }

    .receiver-date {
        position: relative;
        top: 20px;
        font-weight: 100;
    }

    .remark label {
        font-weight: bold;
    }

    .remark div {
        padding-left: 30px;
        padding-top: 10px
    }

    @@media all {
        .page-break {
            display: block;
            page-break-after: always !important;
        }
    }

    @@media print {

        html,
        body {
            height: 99%;
        }
    }

    @@media print {
        .page-break {
            display: block;
            page-break-after: always !important;
        }
    }
</style>
<div class="page">
    <div class="form-content">
        <div class="top-header">
            @{
                Html.RenderPartial("HeaderPdf");
            }
        </div>
        <br />
        <div class="clearboth"></div>
        <div class="header">
            <div class="header-col-12 text-center">
                <div class="wrap-box">
                    <div class="font-18 bold">ใบสำคัญจ่ายเงิน</div>
                </div>
            </div>
        </div>
        <div class="header">
            <div class="header-col-12 right">
                <div class="wrap-box">
                    <div class="font-14 bold topic-name">วันที่</div>
                    <div class="font-14 topic-detail-underline box-140">@Model.PaymentDate.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
        <div class="clearboth"></div>
        <div class="payment">
            <table class="payment-detail">
                <thead>
                    <tr>
                        <th>ลำดับ</th>
                        <th>วันที่</th>
                        <th>รายการ</th>
                        <th>จำนวน</th>
                        <th>ยอดเงิน</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TblDailypaymentDetails)
                    {
                        index++;
                        <tr>
                            <td class="index">@index.ToString("#.")</td>
                            <td class="text-center">@item.PaymentOrderDate.ToString("dd/MM/yyyy")</td>
                            <td class="description">@item.Description</td>
                            <td class="quantity">@item.Quantity</td>
                            <td class="text-right amount">@item.Amount.ToString("#,##0.00")</td>
                        </tr>
                    }
                    @for (int i = 0; i < row; i++)
                    {
                        <tr>
                            <td class="index">&nbsp;</td>
                            <td class="text-center doc">&nbsp;</td>
                            <td class="description">&nbsp;</td>
                            <td class="text-center quantity">&nbsp;</td>
                            <td class="text-right amount">&nbsp;</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="bold text-right" colspan="4">ยอดเงินสุทธิ / Net Total</td>
                        <td class="amount text-right text-red bold">@Model.NetTotal.ToString("#,##0.00")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="footer">
            <div class="remark">
                <label>หมายเหตุ</label>
                <div>@Model.Remark</div>
            </div>
            <table style="width:100%;font-size:13px;">
                <tr>
                    <td style="text-align:center;font-weight:bold;">
                        <div class="receiver-topic">
                            ลงชื่อ...............................................(ผู้รับเงิน)
                        </div>
                        <div class="receiver-fullname">
                            .......................................................................
                        </div>
                        <div class="receiver-date">
                            วันที่...................................................
                        </div>
                    </td>

                    <td style="text-align:center;font-weight:bold;">
                        <div class="sign">
                            <div class="sign-img">
                                @{
                                    Html.RenderPartial("SignJutaratPdf");
                                }
                            </div>
                        </div>
                        <div class="approve-topic">
                            ลงชื่อ...............................................(ผู้อนุมัติ)
                        </div>
                        <div class="approve-fullname">
                            จุฑารัตน์ วิทยารัตน์
                        </div>
                        <div class="approve-date">
                            วันที่ @Model.PaymentDate.ToString("dd/MM/yyyy")
                        </div>
                    </td>
                </tr>
            </table>
            <div class="stamp">
                <div class="stamp-img">
                    @{
                        Html.RenderPartial("StampPdf");
                    }
                </div>
            </div>
        </div>
    </div>
</div>