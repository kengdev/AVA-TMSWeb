@model TMSWeb.Models.Entities.LOG.TblMonthlypayment
@{
    Layout = null;

    var enCulture = new System.Globalization.CultureInfo("en-US", false);
    var data = Model.TblMonthlypaymentDetails.ToArray();

    string code = Model.MonthlyPaymentCode;
    decimal row = data.Count();
    var pindex = 0;
    int index = 1;
    int item = 0;

    decimal pg = Math.Ceiling(row / 18);
}
<link rel="stylesheet" type="text/css" href="~/css/print/printform.css" media="print">
