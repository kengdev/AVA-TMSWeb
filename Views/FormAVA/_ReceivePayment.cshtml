@model TMSWeb.Models.Entities.LOG.TblReceivePayment
@{
    Layout = null;

    var thCulture = new System.Globalization.CultureInfo("th-TH", false);
    var data = Model.TblReceivePaymentDetails.ToArray();

    string code = Model.ReceivePaymentCode;
    int row = data.Count();
    int rowcontrol = 13 - row;
    int itemRow = 1;
}
<link rel="stylesheet" type="text/css" href="~/css/print/printform.css" media="print">
