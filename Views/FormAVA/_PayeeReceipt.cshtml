@model TMSWeb.Models.Entities.LOG.TblReceivePayment
@{
    Layout = null;
    int ipg = 0;
    var receipt = Model.TblReceivePaymentReceipts.FirstOrDefault();
    var row = 2 - Model.TblReceivePaymentDetails.Count;
}
<link href="../../fonts/fontawesome/css/all.min.css" rel="stylesheet" type="text/css" />
<link href="~/css/site/form.css" rel="stylesheet" type="text/css" media="print">
<style>
    .page {
        font: 10pt "Tahoma", Times, serif;
        z-index: 1000;
        width: 100%;
    }

    .header-col-1 {
        width: 150px;
        float: left;
        display: inline-block;
    }

        .header-col-1 img {
            width: 75px;
        }

    .header-col-6 {
        width: 400px;
        float: left;
        display: inline-block;
    }

    .header-col-3 {
        float: right;
        text-align: center;
        display: inline-block
    }

    .company-detail {
        font-size: 11px !important;
    }

    .font-11 {
        font-size: 11px;
    }

    .company-name {
        font-size: 13px !important;
    }

    .owner {
        text-align: center;
        font-size: 11px !important;
    }

    .owner-doc-wrapper {
        display: inline-block;
        text-align: center;
        font-size: 11px !important;
    }

    .doc-type {
        text-align: center !important;
        width: 100%;
    }

    .doc-type-content {
        margin-top: 5px;
        padding: 3px;
        border: 1px solid black;
        border-radius: 7px !important;
        width: 120px;
        display: inline-block;
    }

    .doc-name {
        text-align: center;
        margin-top: 7px;
    }

    .customer-payment {
        margin-top: 10px;
        border: 2px solid black;
        padding: 3px;
        display: inline-block;
        float: left;
    }

    .invoice-id-date {
        font-size: 11px;
        margin-top: 20px;
        display: inline-block;
        vertical-align: top;
        text-align: left;
        float: right;
        margin-right: 40px;
    }

        .invoice-id-date div {
            text-align: left !important;
        }

    .payment-content {
        margin-top: 3px !important;
    }

        .payment-content table.table {
            width: 100%;
            border-collapse: collapse;
            border: 2px solid black;
        }


            .payment-content table.table th.topic {
                border: 1px solid black;
                text-align: center;
                font-size: 9px;
                font-style: normal;
                line-height: 20px !important;
            }

            .payment-content table.table th {
                border: 1px solid black;
                text-align: center;
                font-size: 9px;
                font-style: italic;
                line-height: 15px !important;
            }


            .payment-content table.table td {
                font-size: 9px;
                border: 1px solid black;
                line-height: 15px !important;
                padding-right: 3px;
            }

                .payment-content table.table td.right,
                th.right {
                    text-align: right !important;
                    padding-right: 3px;
                    font-size: 9px;
                }

                .payment-content table.table td.center {
                    text-align: center;
                }

    .payment-footer {
        border: 2px solid black;
        margin-top: 3px !important;
        padding-bottom: 7px;
        ;
    }

    .item-box {
        border: 1px solid #000;
        width: 20px;
        height: 20px;
        text-align: center;
        display: inline-block;
    }

        .item-box span {
            font-size: 20px;
            position: relative;
            top: -5px;
        }

    .payment-type-wrapper {
        padding-top: 7px;
        font-size: 11px !important;
    }

    .payment-type {
        display: inline-block;
        margin-left: 10px;
    }

    .table-payment-type td label {
        margin-left: 7px;
        font-size: 11px;
    }

    .table-payment-type td div.item-box {
        margin-left: 20px;
    }

    .payment-remark {
        border: 2px solid black;
        margin-top: 3px;
        font-size: 11px;
        font-style: italic;
        text-align: center;
        padding: 7px;
    }

    .topic-customer-name {
        font-size: 11px;
        font-weight: bold;
    }

    .topic-customer-address, .topic-customer-tax {
        width: 530px !important;
        font-size: 9px !important;
    }

    td.left {
        padding-left: 7px;
    }

    td.no {
        width: 40px;
    }

    td.amount, td.unit, td.total {
        width: 80px;
    }

    .last {
        border-right: 2px solid black !important;
    }

    .cutoff {
        margin-top: 15px;
        margin-bottom: 15px;
        width: 100%;
        font-size: 20px;
    }

    #cutoff-line {
        width: 98%;
        border-top: 1px dashed grey;
        position: relative;
        top: -8px;
        left: 15px;
    }

    .sign1 {
        margin-left: 70px;
        padding: 0;
    }

    .sign2 {
        text-align: center;
    }

    div.stamp-sign-img img {
        width: 90px;
        position: relative;
        top: 15px;
        z-index: -1;
    }

    div.clear-float {
        clear: both;
    }

    @@media all {
        .page-break {
            display: block;
            page-break-after: always !important;
        }
    }

    @@media print {
        html, body {
            height: 99%;
        }
    }

    @@media print {
        .page-break {
            display: block;
            page-break-after: always !important;
        }
    }
</style>

@for (int pg = 0; pg < 2; pg++)
{
    <div class="page">
        <div class="form-content">
            <div class="top-header">
                @{
                    Html.RenderPartial("HeaderPdf");
                }
                <div class="header-col-3 pull-right bold">
                    <div class="owner-doc-wrapper">
                        <div class="doc-type">
                            <div class="doc-type-content">
                                @if (pg == 0)
                                {
                                    <div>ต้นฉบับ</div>
                                    <div>ORIGINAL</div>
                                }
                                else
                                {
                                    <div>สำเนา</div>
                                    <div>COPY</div>
                                }
                            </div>
                        </div>

                        <div class="doc-name">
                            <div>ใบเสร็จรับเงิน / ใบกำกับภาษี</div>
                            <div>RECEIPT / TAX INVOICE</div>
                        </div>
                    </div>

                </div>
                <br />
                <div class="clear-float"></div>


                <div class="customer-payment">
                    <div class="topic-customer-name">
                        @Model.SupplierCodeNavigation.SupplierFullname.ToUpper()
                    </div>
                    <div class="topic-customer-address">
                        @Model.SupplierCodeNavigation.SupplierAddress.ToUpper()
                    </div>
                    <div class="topic-customer-tax">
                        TAX ID : @Model.SupplierCodeNavigation.SupplierVatNo.ToUpper()
                    </div>
                </div>

                <div class="invoice-id-date">
                    <div>
                        <span class="topic-date">Date : </span>
                        <span>@receipt.ReceiptDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div>
                        <span class="topic-invoice">Invoice No : </span>
                        <span>@receipt.ReceiptCode</span>
                    </div>
                </div>
                <div class="clear-float"></div>
            </div>

            <div class="payment-content">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="topic" colspan="6">DESCRIPTION</th>
                        </tr>
                        <tr>
                            <th>No</th>
                            <th>Description</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th class="last">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                        }

                        @foreach (var item in Model.TblReceivePaymentDetails)
                        {
                            <tr>
                                <td class="center no">@index.ToString().</td>
                                <td class="left">@item.Description</td>
                                <td class="center amount">@item.Amount</td>
                                <td class="center unit">@item.Unit</td>
                                <td class="right last total">@item.Total.ToString("#,##0.00")</td>
                            </tr>
                            index++;
                        }

                        @for (int i = 0; i <= row; i++)
                        {
                            <tr>
                                <td class="center">&nbsp;</td>
                                <td class="center">&nbsp;</td>
                                <td class="center">&nbsp;</td>
                                <td class="right">&nbsp;</td>
                                <td class="right last">&nbsp;</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th class="right" colspan="4">Sub Total</th>
                            <th class="right last">@Model.Total.ToString("#,##0.00")</th>
                        </tr>
                        <tr>
                            <th class="right" colspan="4">Vat 7%</th>
                            <th class="right last">@Model.Vat.ToString("#,##0.00")</th>
                        </tr>
                        <tr>
                            <th class="right" colspan="4">Withholding</th>
                            <th class="right last">@Model.Tax.ToString("#,##0.00")</th>
                        </tr>
                        <tr>
                            <th class="right" colspan="4">Grand Total</th>
                            <th class="right last">@Model.NetTotal.ToString("#,##0.00")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="payment-footer">
                <div class="payment-type-wrapper">
                    <table class="table-payment-type">
                        <tr>
                            <td><label>ชำระโดย</label></td>
                            <td>
                                <div class="item-box">
                                    @if (receipt.PaymentType == "01")
                                    {
                                        <span>&#10003;</span>
                                    }
                                    else
                                    {
                                        <span>&nbsp;</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <label>เงินสด</label>
                            </td>
                            <td>
                                <div class="item-box">
                                    @if (receipt.PaymentType == "02")
                                    {
                                        <span>&#10003;</span>
                                    }
                                    else
                                    {
                                        <span>&nbsp;</span>
                                    }
                                </div>
                            </td>
                            @if (receipt.PaymentType == "02")
                            {
                                <td>
                                    <label>โอนผ่านธนาคาร</label>&nbsp;&nbsp;<span class="font-11">@receipt.BankName</span>
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <label>เช็คธนาคาร.............................</label>
                                </td>
                                <td>
                                    <label>สาขา........................</label>
                                </td>
                                <td>
                                    <label>เลขที่.....................</label>
                                </td>
                                <td>
                                    <label>วันที่.....................</label>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td>
                                <label>Pay by</label>
                            </td>
                            <td></td>
                            <td><label>Cash</label></td>
                            <td></td>
                            <td><label>Bank Transfer</label></td>
                            <td><label></label></td>
                            <td><label></label></td>
                            <td><label></label></td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-center">
                                <div class="sign1">
                                    @{
                                        Html.RenderPartial("StampChutimaPdf");
                                    }
                                </div>
                                <label>ผู้รับเงิน..................................</label>
                            </td>
                            <td>
                                <div style="margin-top: 30px;">
                                    <label>วันที่</label>
                                    <label class="bold">@receipt.ReceiptDate.ToString("dd/MM/yyyy")</label>
                                </div>
                            </td>
                            <td colspan="2" class="text-center">
                                <div class="sign2">
                                    @{
                                        Html.RenderPartial("StampChutimaPdf");
                                    }
                                </div>
                                <label>...........................................................</label>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <label>Receive by</label>
                            </td>
                            <td>
                                <label>Date</label>
                            </td>
                            <td colspan="2" class="text-center">
                                <label>(Authorized Signature)</label>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="payment-remark">
                <div>
                    ใบเสร็จรับเงินฉบับนี้จะสมบูรณ์ต่อเมื่อปรากฏลายเซ็นของผู้รักษาเงิน ถ้าชำระด้วยเช็ค
                    ใบเสร็จจะสมบูรณ์เมื่อเรียกเก็บเงินตามเช็คที่ได้เรียบร้อยแล้ว
                </div>
                <div>
                    บริษัทฯ กำหนดแก้ไขภายใน 3 วันหากพ้นกำหนดบริษัทฯ จะถือว่าถูกต้องสมบูรณ์ และไม่รับแก้ไขใบเสร็จทุกกรณี
                </div>
                <div style="margin-top: 3px;">
                    N.B. This receipt is notvalid unless signed by Cashier, if payment by cheque, receipt shall be valid
                    when the cheque has been honoured by the bank
                </div>
            </div>
        </div>
    </div>
    @if (pg == 0)
    {
        <div class="cutoff">
            <span>&#9985;</span>
            <div id="cutoff-line"></div>
        </div>
    }
}