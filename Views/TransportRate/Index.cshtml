@{
    ViewBag.TopActive = "Rate";
    ViewBag.MidActive = "triprate";
    ViewBag.Title = "ข้อมูลการคิดเงินลูกค้า";
}
@section Styles {
    <style>
        table.dataTable td,
        table.dataTable th {
            font-size: 13px !important;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">การคำนวณเงิน</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/triprate/">ข้อมูลเรทคิดเงินลูกค้า</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> รายการเรทคิดเงินลูกค้า</span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-6">
                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right">
                            <button type="button" class="btn btn-sm red" onclick="setAdd()">เพิ่มข้อมูล</button>
                        </div>
                    </div>
                </div>
                <table class="table table-striped table-bordered table-hover table-checkable order-column"
                       id="table-cost">
                    <thead>
                        <tr>
                            <th></th>
                            <th> ชื่อเรียก</th>
                            <th> สถานที่รับ/ส่งสินค้า</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr role="row" class="heading">
                            <th class="filter"></th>
                            <th class="filter">
                                <input type="text" class="form-control filterText" id="filterNameTH" />
                            </th>
                            <th class="filter">
                                <input type="text" class="form-control filterText" id="filterNameEN" />
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        (function($) {
            var oTable = $('#table-cost').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [
                    [1, "desc"]
                ],
                "sAjaxSource": "/TransportRate/GetCostDataList",
                "fnRowCallback": function(row, aData, index) {
                    if (!aData.is_actived)
                        $(row).addClass('inactive');

                    $('td', row).eq(4).html(number_format(aData.cost_value));
                },
                "fnServerParams": function(aoData) {
                    aoData.push({
                        "name": "filterNameTH",
                        "value": $("#filterNameTH").val()
                    });
                    aoData.push({
                        "name": "filterNameEN",
                        "value": $("#filterNameEN").val()
                    });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [{
                    className: "action-3-td text-center",
                    targets: 0
                },
                {
                    className: "name-td",
                    targets: 1
                },
                {
                    className: "name-td",
                    targets: 2
                }
                ],
                "columns": [{
                    "data": "cost_code",
                    "orderable": false,
                    "render": function(data, type, row) {
                        var modify =
                            '<a class="btn btn-xs yellow" href="/transportrate/edit?code=' + data +
                            '" data-title="แก้ไขข้อมูล"  data-toggle="tooltip" data-trigger="hover"><i class="fad fa-pencil-alt"></i></a>';
                        var active =
                            '<a class="btn btn-xs green-jungle" href="javascript:;" data-title="เปิดใช้งาน"  data-toggle="tooltip" data-trigger="hover" onclick=setActive("' +
                            data + '")><i class="fa fa-check"></i></a>';
                        var inactive =
                            '<a class="btn btn-xs grey" href="javascript:;" data-title="ปิดใช้งาน"  data-toggle="tooltip" data-trigger="hover" onclick=setInactive("' +
                            data + '")><i class="fa fa-times"></i></a>';
                        var remove =
                            '<a class="btn btn-xs red" href="javascript:;" data-title="ลบข้อมูล"  data-toggle="tooltip" data-trigger="hover" onclick=setDisabled("' +
                            data + '")><i class="fad fa-trash-alt"></i></a>';

                        if (row.is_actived) {
                            return inactive + remove + modify;
                        } else {
                            return active + remove;
                        }
                    }
                },
                {
                    "data": "customer_name_th"
                },
                {
                    "data": "mission_name"
                }
                ],
                "createdRow": function(row, data, dataIndex) {

                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-cost tfoot tr').appendTo('#table-cost thead');

            $('.filterText').keyup(function() {
                $('#table-cost').dataTable()._fnAjaxUpdate();
            });
        }(jQuery));

        function reloadRow() {
            $("#table-cost").DataTable().ajax.reload();
        }

        function setAdd() {
            var url = '/transportrate/add';
            window.location = url;
        }

        function setDisabled(code) {
            $.alert.open('confirm', 'คุณต้องการปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/TransportRate/Remove", {
                        code: code
                    }, function(data) {
                        killOverlayPage();
                        if (data.result == true) {
                            $.alert.open('info', "จัดการข้อมูลเรียบร้อยแล้ว", function(r) {
                                $('#table-cost').dataTable()._fnAjaxUpdate();
                            });
                        } else {
                            jAlert('ผลการทำงาน',
                                "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>"
                            );
                        }
                    });
                }
            });
        }

        function setActive(code) {
            $.alert.open('confirm', 'คุณต้องการเปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/TransportRate/Active", {
                        code: code
                    }, function(data) {
                        killOverlayPage();
                        if (data.result == true) {
                            $.alert.open('info', data.resultMessage, function(r) {
                                $('#table-cost').dataTable()._fnAjaxUpdate();
                            });
                        } else {
                            $.alert.open('error', data.resultMessage);
                        }
                    });
                }
            });
        }

        function setInactive(code) {
            $.alert.open('confirm', 'คุณต้องการปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/TransportRate/Inactive", {
                        code: code
                    }, function(data) {
                        killOverlayPage();
                        if (data.result == true) {
                            $.alert.open('info', data.resultMessage, function(r) {
                                $('#table-cost').dataTable()._fnAjaxUpdate();
                            });
                        } else {
                            $.alert.open('error', data.resultMessage);
                        }
                    });
                }
            });
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}