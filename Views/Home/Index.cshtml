@{
    ViewBag.TopActive = "Home";
    ViewBag.Title = "ระบบบริหารงาน";
}
<link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
<style>
    .widget-thumb-icon {
        height: 100px !important;
        width: 100px !important;
        padding-top: 30px !important;
    }

    .mt-action-img img {
        width: 40px;
    }
</style>
@if (ViewBag.Group == "Administrator")
{
    <div>
        @Html.Partial("_AdminPage")
    </div>
}
else if (ViewBag.Group == "Officer")
{
    <div>
        @Html.Partial("_OfficerPage", "Home")
    </div>
}
else
{
    @Html.Partial("_TransportPage", "Home")
}
@section scripts {
    <script src="~/js/signalr.js" type="text/javascript"></script>
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script src="~/js/fusioncharts/js/fusioncharts.js"></script>
    <script src="~/js/fusioncharts/js/fusioncharts.charts.js"></script>
    <script src="~/js/fusioncharts/js/themes/fusioncharts.theme.fint.js"></script>
    <script type="text/javascript">
        FusionCharts.ready(function() {
            var topcustomerchart = new FusionCharts({
                type: 'column2d',
                renderAt: 'render-top-customer',
                width: '100%',
                height: '353',
                dataFormat: 'jsonurl',
                dataSource: '/dashboard/_GraphMonthlyContainerByPlace'
            }).render();

            var yealychart = new FusionCharts({
                type: 'msspline',
                renderAt: 'render-yearly-trips',
                width: '100%',
                height: '300',
                dataFormat: 'jsonurl',
                dataSource: '/dashboard/_GraphYearlyContainer'
            }).render();

            var dailychart = new FusionCharts({
                type: 'msspline',
                renderAt: 'render-daily-trips',
                width: '100%',
                height: '300',
                dataFormat: 'jsonurl',
                dataSource: '/dashboard/_GraphDailyContainer'
            }).render();
        });

        (function($) {
            rendersum();
            renderhistory();

            const date = new Date();  // ใช้วันที่ปัจจุบัน
            // สร้างการเชื่อมต่อกับ SignalR Hub
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/dataHub")  // URL ของ SignalR Hub
                .configureLogging(signalR.LogLevel.Information) // เปิด log debug ได้
                .build();

            // ฟังก์ชันเมื่อได้รับข้อมูล JSON จาก Hub
            connection.on("ReceiveData", function(data) {
                console.log("📡 Received data:", data);
                
                // แปลง JSON เป็น object
                const jsonData = JSON.parse(data);
                const statusClass = jsonData.status === 'Late' ? 'bg-red' : 'bg-green';
                // สร้าง HTML element
                const item = `
                                <div class="mt-action">
                                    <div class="mt-action-img">
                                        <img src="${jsonData.emp_img}" />
                                    </div>
                                    <div class="mt-action-body">
                                        <div class="mt-action-row">
                                            <div class="mt-action-info">
                                                <div class="mt-action-details">
                                                    <span class="mt-action-author">${jsonData.fullname}</span>
                                                    <span class="font-green">${jsonData.emp_code}</span>
                                                    <p class="mt-action-desc">${jsonData.area_alias}</p>
                                                </div>
                                            </div>
                                            <div class="mt-action-datetime">
                                                <span class="mt-action-date">${jsonData.punch_date}</span>
                                                <span class="mt-action-dot ${statusClass}"></span>
                                                <span class="mt-action-time">${jsonData.punch_time}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `;

                // เพิ่มรายการใหม่ขึ้นบนสุด
                setTimeout(() => {
                    $('.mt-actions').prepend(item);
                }, 5000);
            });

            // ✅ เริ่มการเชื่อมต่อกับ Hub
            async function startConnection() {
                try {
                    await connection.start();
                    console.log("✅ SignalR Connected!");
                } catch (err) {
                    console.error("❌ SignalR Connection failed:", err);
                    // รอ 5 วิแล้วลองใหม่
                    setTimeout(startConnection, 5000);
                }
            }

            // ถ้า connection หลุด จะพยายามเชื่อมใหม่อัตโนมัติ
            connection.onclose(async () => {
                console.warn("⚠️ SignalR Disconnected. Reconnecting...");
                await startConnection();
            });

            // เริ่มครั้งแรก
            startConnection();
        })(jQuery);

        function rendersum() {
            $.post("/Dashboard/GetSum", {}, function(data) {
                var comma_separator_number_step = $.animateNumber.numberStepFactories.separator(',')
                $('#sum-net').animateNumber({
                    number: data.sum_netvalue,
                    numberStep: function(now, tween) {
                        var formatted = now.toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, '$1,');
                        $(tween.elem).text(formatted);
                    }
                });
                $('#sum-billing').animateNumber({
                    number: data.sum_billingvalue,
                    numberStep: function(now, tween) {
                        var formatted = now.toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, '$1,');
                        $(tween.elem).text(formatted);
