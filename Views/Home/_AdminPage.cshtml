@{
    string current_month = DateTime.Now.ToString("MMMM");
}
<div class="row">
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <a class="dashboard-stat dashboard-stat-v2 blue" href="javascript:;">
            <div class="visual">
                <i class="fad fa-money-check"></i>
            </div>
            <div class="details">
                <div class="number">
                    <span data-counter="counterup" id="sum-net">0.00</span>
                </div>
                <div class="desc"> ยอดค่าขนส่งรวม (บาท) </div>
                <div class="pull-right font-xs bold font-white">@current_month</div>
            </div>
        </a>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <a class="dashboard-stat dashboard-stat-v2 yellow" href="javascript:;">
            <div class="visual">
                <i class="fad fa-money-check"></i>
            </div>
            <div class="details">
                <div class="number">
                    <span data-counter="counterup" id="sum-billing">0.00</span>
                </div>
                <div class="desc"> วางบิลแล้ว (บาท) </div>
                <div class="pull-right font-xs bold font-white">@current_month</div>
            </div>
        </a>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <a class="dashboard-stat dashboard-stat-v2 red" href="javascript:;">
            <div class="visual">
                <i class="fad fa-money-check"></i>
            </div>
            <div class="details">
                <div class="number">
                    <span data-counter="counterup" id="sum-unbilling">0.00</span>
                </div>
                <div class="desc"> ยังไม่วางบิล (บาท) </div>
                <div class="pull-right font-xs bold font-white">@current_month</div>
            </div>
        </a>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <a class="dashboard-stat dashboard-stat-v2 purple" href="javascript:;">
            <div class="visual">
                <i class="fad fa-money-check"></i>
            </div>
            <div class="details">
                <div class="number">
                    <span data-counter="counterup" id="sum-uncashing">0.00</span>
                </div>
                <div class="desc"> ยอดค้างชำระ (บาท) </div>
                <div class="pull-right font-xs bold font-white">@current_month</div>
            </div>
        </a>
    </div>
</div>
<div class="clearfix"></div>

<div class="row widget-row">
    <div class="col-md-3">
        <!-- BEGIN WIDGET THUMB -->
        <div class="widget-thumb widget-bg-color-white text-uppercase margin-bottom-20 bordered">
            <a href="javascript:;" target="popup" onclick="window.open('/dashboard/summarydetail','popup','width=1100,height=675'); return false;"><h4 class="widget-thumb-heading">ยอดค่าขนส่งย้อนหลัง</h4></a>
            <div class="widget-thumb-wrap">
                <i class="widget-thumb-icon bg-blue fad fa-history"></i>
                <div class="widget-thumb-body">
                    <div>
                        <span class="font-xs bold label-2-name"></span>
                        <span class="font-xs" id="net-second"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-3-name"></span>
                        <span class="font-xs" id="net-third"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-4-name"></span>
                        <span class="font-xs" id="net-forth"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-5-name"></span>
                        <span class="font-xs" id="net-fifth"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-6-name"></span>
                        <span class="font-xs" id="net-sixth"></span>
                    </div>
                </div>
            </div>
        </div>
        <!-- END WIDGET THUMB -->
    </div>

    <div class="col-md-3">
        <!-- BEGIN WIDGET THUMB -->
        <div class="widget-thumb widget-bg-color-white text-uppercase margin-bottom-20 bordered">
            <h4 class="widget-thumb-heading">ยอดวางบิลย้อนหลัง</h4>
            <div class="widget-thumb-wrap">
                <i class="widget-thumb-icon bg-yellow fad fa-history"></i>
                <div class="widget-thumb-body">
                    <div>
                        <span class="font-xs bold label-2-name"></span>
                        <span class="font-xs" id="bill-second"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-3-name"></span>
                        <span class="font-xs" id="bill-third"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-4-name"></span>
                        <span class="font-xs" id="bill-forth"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-5-name"></span>
                        <span class="font-xs" id="bill-fifth"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-6-name"></span>
                        <span class="font-xs" id="bill-sixth"></span>
                    </div>
                </div>
            </div>
        </div>
        <!-- END WIDGET THUMB -->
    </div>

    <div class="col-md-3">
        <!-- BEGIN WIDGET THUMB -->
        <div class="widget-thumb widget-bg-color-white text-uppercase margin-bottom-20 bordered">
            <h4 class="widget-thumb-heading">รอวางบิลย้อนหลัง</h4>
            <div class="widget-thumb-wrap">
                <i class="widget-thumb-icon bg-red fad fa-history"></i>
                <div class="widget-thumb-body">
                    <div>
                        <span class="font-xs bold label-2-name"></span>
                        <span class="font-xs" id="unbill-second"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-3-name"></span>
                        <span class="font-xs" id="unbill-third"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-4-name"></span>
                        <span class="font-xs" id="unbill-forth"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-5-name"></span>
                        <span class="font-xs" id="unbill-fifth"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-6-name"></span>
                        <span class="font-xs" id="unbill-sixth"></span>
                    </div>
                </div>
            </div>
        </div>
        <!-- END WIDGET THUMB -->
    </div>

    <div class="col-md-3">
        <!-- BEGIN WIDGET THUMB -->
        <div class="widget-thumb widget-bg-color-white text-uppercase margin-bottom-20 bordered">
            <a href="javascript:;" target="popup" onclick="window.open('/dashboard/_pendingpayment','popup','width=1100,height=733'); return false;"><h4 class="widget-thumb-heading">ยอดค้างชำระย้อนหลัง</h4></a>
            <div class="widget-thumb-wrap">
                <i class="widget-thumb-icon bg-purple fad fa-history"></i>
                <div class="widget-thumb-body">
                    <div>
                        <span class="font-xs bold label-2-name"></span>
                        <span class="font-xs" id="unpay-second"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-3-name"></span>
                        <span class="font-xs" id="unpay-third"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-4-name"></span>
                        <span class="font-xs" id="unpay-forth"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-5-name"></span>
                        <span class="font-xs" id="unpay-fifth"></span>
                    </div>
                    <div>
                        <span class="font-xs bold label-6-name"></span>
                        <span class="font-xs" id="unpay-sixth"></span>
                    </div>
                </div>
            </div>
        </div>
        <!-- END WIDGET THUMB -->
    </div>
</div>
<div class="clearfix"></div>

<div class="row">
    <div class="col-lg-6 col-xs-12 col-sm-12">
        <!-- BEGIN PORTLET-->
        <div class="portlet light bordered">
            <div class="portlet-title tabbable-line">
                <div class="caption">
                    <i class="icon-bar-chart hide"></i>
                    <span class="caption-subject bold">รายได้รวม</span>
                    <span class="caption-helper">@DateTime.Now.ToString("MMMM yyyy")</span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body">
                <div class="tab-content">
                    <div class="tab-pane active" id="portlet_comments_1">
                        @await Component.InvokeAsync("EntryChartCost")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 col-xs-12 col-sm-12">
        <!-- BEGIN PORTLET-->
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="icon-bar-chart hide"></i>
                    <span class="caption-subject bold">10 อันดับลูกค้า</span>
                    <span class="caption-helper">@DateTime.Now.ToString("MMMM yyyy")</span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body">
                <div id="render-top-customer" align="center"></div>
            </div>
        </div>
        <!-- END PORTLET-->
    </div>
</div>
<div class="clearfix"></div>

<div class="row">
    <div class="col-lg-6 col-xs-12 col-sm-12">
        <!-- BEGIN PORTLET-->
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="icon-bar-chart hide"></i>
                    <span class="caption-subject bold">Graph 2-yearly trip</span>
                    <span class="caption-helper">@DateTime.Now.AddYears(-1).ToString("yyyy") - @DateTime.Now.ToString("yyyy")</span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body">
                <div id="render-yearly-trips" align="center"></div>
            </div>
        </div>
        <!-- END PORTLET-->
    </div>
    <div class="col-lg-6 col-xs-12 col-sm-12">
        <!-- BEGIN PORTLET-->
        <div class="portlet light tasks-widget bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="icon-bar-chart hide"></i>
                    <span class="caption-subject bold">สถานะการใช้งานรถปัจจุบัน</span>
                    <span class="caption-helper">Thursday - Wednesday</span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body">
                @await Component.InvokeAsync("EntryChartTruckLoad")
            </div>
        </div>
        <!-- END PORTLET-->
    </div>
</div>

<div class="row">
    <div class="col-lg-6 col-xs-12 col-sm-12">
        <!-- BEGIN PORTLET-->
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="icon-bar-chart hide"></i>
                    <span class="caption-subject bold">Graph Daily trip</span>
                    <span class="caption-helper">@DateTime.Now.ToString("MM-yyyy")</span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body">
                <div id="render-daily-trips" align="center"></div>
            </div>
        </div>
        <!-- END PORTLET-->
    </div>

    <div class="col-md-6 col-lg-6">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption font-green-sharp">
                    <i class="fad fa-alarm-clock font-green-sharp"></i>
                    <span class="caption-subject bold uppercase"> เวลาเข้า-ออกงาน</span>
                    <span class="caption-helper">realtime stats...</span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body">
                @await Component.InvokeAsync("EntryTimeAttendance")
            </div>
        </div>
    </div>
</div>