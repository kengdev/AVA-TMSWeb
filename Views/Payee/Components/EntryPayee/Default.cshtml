@model TMSWeb.Models.Entities.LOG.TblReceivePaymentDetail
@using HtmlHelpers.BeginCollectionItemCore
@{
    var action_type = ViewBag.Type;
}

<tr>
    @using (Html.BeginCollectionItem("TblReceivePaymentDetails"))
    {
        @if (Model.Id == 0)
        {
            <td class="text-center">
                @if (action_type == "default")
                {
                    <a href="#" class="font-blue" onclick="addItem()"><i class="fa fa-plus"></i></a>
                }
                else
                {
                    <a href="#" class="font-red" onclick="$(this).parent().parent().remove(), removeFunc()">
                        <i class="fa fa-times"></i>
                    </a>
                }
            </td>
            <td>
                @Html.TextBoxFor(m => m.Description, new { @Class = "form-control input-sm description" })
            </td>
            <td>
                <input asp-for="@Model.Amount" type="text" value="" class="form-control input-sm form-int amount" />
            </td>
            <td>
                <input asp-for="@Model.Unit" type="text" value="" class="form-control input-sm unit" />
            </td>
            <td>
                <input asp-for="@Model.Price" type="text" value="" class="form-control input-sm form-decimal price" />
            </td>
            <td>
                <input asp-for="@Model.Total" type="text" value="" class="form-control input-sm form-decimal total" />
            </td>
        }
        else
        {
            <td class="text-center">
                @if (action_type == "default")
                {
                    <a href="#" class="font-blue" onclick="addItem()"><i class="fa fa-plus"></i></a>
                }
                else
                {
                    <a href="#" class="font-red" onclick="$(this).parent().parent().remove(), removeFunc()">
                        <i class="fa fa-times"></i>
                    </a>
                }
            </td>
            <td>
                @Html.TextBoxFor(m => m.Description, new { @Class = "form-control input-sm description" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.Amount, new { @Class = "form-control input-sm form-int amount" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.Unit, new { @Class = "form-control input-sm unit" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.Price, new { @Class = "form-control input-sm form-decimal price" })
            </td>
            <td>
                @Html.TextBoxFor(m => m.Total, new { @Class = "form-control input-sm form-decimal total" })
            </td>
        }
    }
</tr>

<script>
    $('.form-decimal').keypress(function(e) {
        //return (e.which != 8 && e.which != 0 && (e.which == 46)) ? false : true;
        if (e.which != 8 && e.which != 0) {
            if (e.which == 46) {
                return true;
            }
            else if (e.which < 48 || e.which > 57) {
                return false;
            }
        }
        else {
            if (e.which == 8 || e.which == 0) {
                return true;
            }
        }
    });

    $('.price, .amount').on('keyup', function() {
        var amount = 0;
        var price = 0;
        var a = $(this).closest('tr').find('.amount').val();
        var b = $(this).closest('tr').find('.price').val();
        if (a != '') {
            amount = parseFloat(a);
        }

        if (b != '') {
            price = parseFloat(b);
        }

        var total = amount * price;
        $(this).closest('tr').find('.total').val(total)
        setTotal();
    });
</script>