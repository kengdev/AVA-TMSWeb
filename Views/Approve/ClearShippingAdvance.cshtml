@{
    ViewBag.TopActive = "Billing";
    ViewBag.MidActive = "approve";
    ViewBag.SubActive = "clearing";
    ViewBag.Title = "ข้อมูลงาน";
}
@section Styles {
    <style>
        table.dataTable td,
        table.dataTable th {
            font-size: 13px !important;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">การวางบิล</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="javascript:;">งานรอวางบิล</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/approve/clearshippingadvance/">เคลียร์ยอดสำรองจ่าย</a>
        </li>
    </ul>
</div>
<br />

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> เคลียร์ยอดสำรองจ่าย </span>
                </div>
                <div class="actions">
                </div>
            </div>

            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-6">
                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right" role="form">
                            <div class="form-group">
                                @Html.DropDownList("month", null, new { @Class = "form-control dlListForm", Style = "width:120px;" })
                            </div>
                            <div class="form-group">
                                @Html.DropDownList("year", null, new { @Class = "form-control dlListForm", Style = "width:90px;" })
                            </div>
                            |
                            <button type="button" class="btn btn-sm red" onclick="setAddShippingAdvance()">ทำรายการ</button>
                        </div>
                    </div>
                </div>
                <table class="table table-striped table-bordered table-hover " id="table-advance">
                    <thead>
                        <tr>
                            <th></th>
                            <th> วันที่</th>
                            <th> เลขที่</th>
                            <th> ลูกค้า</th>
                            <th> ยอดเงิน</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr role="row" class="heading">
                            <th class="filter"></th>
                            <th class="filter"></th>
                            <th class="filter">
                                <input type="text" class="form-control filterText" id="filterCode" />
                            </th>
                            <th class="filter">
                                <input type="text" class="form-control filterText" id="filterName" />
                            </th>
                            <th class="filter"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        (function($) {
            var iTable = $('#table-advance').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "searching": true,
                "order": [
                    [2, "asc"]
                ],
                "sAjaxSource": "/Approve/GetShippingAdvanceDataList",
                "fnRowCallback": function(row, aData, index) {
                    $('td', row).eq(4).html(number_format(aData.payment_total));
                },
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "month", "value": $("#month").val() });
                    aoData.push({ "name": "year", "value": $("#year").val() });
                },
                "oLanguage": {
                    "sSearch": "คำค้น: ",
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [{
                    className: "action-3-td text-center",
                    targets: 0
                },
                {
                    className: "date-td",
                    targets: 1
                },
                {
                    className: "code-td",
                    targets: 2
                },
                {
                    className: "name-td",
                    targets: 3
                },
                {
                    className: "currency-td",
                    targets: 4
                }
                ],
                "columns": [{
                    "data": "payment_code",
                    "orderable": false,
                    "render": function(data, type, row) {
                        var remove =
                            '<a class="btn btn-xs red" href="javascript:;" data-title="ลบ" data-toggle="tooltip" data-trigger="hover" onclick=setRemove("' +
                            data + '")><i class="fad fa-trash"></i></a>';
                        var edit =
                            '<a class="btn btn-xs yellow" href="javascript:;" data-title="แก้ไข" data-toggle="tooltip" data-trigger="hover" onclick=setEditShippingAdvance("' +
                            data + '")><i class="fad fa-pencil"></i></a>';
                        var print =
                            '<a class="btn btn-xs grey" href="javascript:;" data-title="พิมพ์รายการ" data-toggle="tooltip" data-trigger="hover" onclick=setPrintPayment("' +
                            data + '")><i class="fad fa-print"></i></a>';

                        return remove + edit + print;
                    }
                },
                {
                    "data": "payment_date", "orderable": false
                },
                {
                    "data": "payment_code"
                },
                {
                    "data": "customer_name"
                },
                {
                    "data": "payment_total", "orderable": false
                }
                ],
                "createdRow": function(row, data, dataIndex) {

                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-advance tfoot tr').appendTo('#table-advance thead');

            $('.filterText').keyup(function() {
                $('#table-advance').dataTable()._fnAjaxUpdate();
            });

            $('.dlListForm').change(function() {
                $('#table-advance').dataTable()._fnAjaxUpdate();
            });
        }(jQuery));

        function setPrintPayment(code, type) {
            var url = '/form/clearinglist?code=' + code;

            window.open(url, 'form clearing');
        }

        function setAddShippingAdvance() {
            var url = '/approve/clearing';
            var setting = 'width=1100,height=657';

            window.open(url, 'Receive Approve', setting);
        }

        function setEditShippingAdvance(code) {
            var url = '/approve/editclearing?code=' + code;
            var setting = 'width=1100,height=657';

            window.open(url, 'Receive Approve', setting);
        }

        function getDetail(code) {
            var url = '/job/detail?code=' + code;
            var setting = 'width=1100,height=672';

            window.open(url, 'Detail Station', setting);
        }

        function setRemove(code) {
            $.alert.open('confirm', 'คุณต้องการปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Approve/RemoveClearing",
                        {
                            code: code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function(r) {
                                    $('#table-advance').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                jAlert('ผลการทำงาน', data.resultMessage);
                            }
                        });
                }
            });
        }

        function reloadRow() {
            $("#table-advance").DataTable().ajax.reload();
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}