@{
    ViewBag.TopActive = "Billing";
    ViewBag.MidActive = "approve";
    ViewBag.SubActive = "check";
    ViewBag.Title = "ข้อมูลงาน";
}
@section Styles {
    <style>
        table.dataTable td, table.dataTable th {
            font-size: 13px !important;
        }

        .dataTables_length {
            position: relative;
            top: 5px;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">การวางบิล</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="javascript:;">งานรอวางบิล</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/approve/">ตรวจสอบความถูกต้อง</a>
        </li>
    </ul>
</div>
<br />

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase">  รายการงานรอวางบิล </span>
                </div>
                <div class="actions">
                </div>
            </div>

            <div class="portlet-body">
                <table class="table table-striped table-bordered table-hover table-checkable order-column" id="table-station">
                    <thead>
                        <tr>
                            <th></th>
                            <th> วันที่</th>
                            <th> เลขที่</th>
                            <th> งาน</th>
                            <th style="font-size:12px!important;"> Booking</th>
                            <th> เบอร์ตู้</th>
                            <th> ขนาด</th>
                            <th> ทะเบียน</th>
                            <th> สังกัด</th>
                            <th> สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr role="row" class="heading">
                            <th class="filter"></th>
                            <th class="filter"></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterCode" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterMission" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterBookingNo" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterContainerNo" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterContainerSize" /></th>
                            <th class="filter"><input type="text" class="form-control filterText" id="filterLicense" /></th>
                            <th class="filter">
                                @Html.DropDownList("supplier", null, "-----เลือก-----", new { @Class = "form-control filterDropdown", id = "filterSupplier" })
                            </th>
                            <th class="filter">
                                <div class="form-group filterDropdown">
                                    <select class="form-control" id="filterStatus">
                                        <option>--เลือก--</option>
                                        <option value="TRUE">ยืนยัน</option>
                                        <option value="FALSE">รอ</option>
                                    </select>
                                </div>
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/Scripts/default/jQuery.print.js"></script>
    <script type="text/javascript">
        (function($) {
            var oTable = $('#table-station').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "searching": true,
                "order": [[1, "desc"]],
                "sAjaxSource": "/approve/GetJobApproveDataList",
                "fnRowCallback": function(row, aData, index) {
                    var container_no = aData.container_no != '0' ? aData.container_no : 'รอเอกสาร';
                    var truck = aData.truck_license != '0' ? aData.truck_license : '-';

                    $('td', row).eq(3).html(aData.start_name + ' - ' + aData.mission_name);
                    $('td', row).eq(5).html(container_no);
                    $('td', row).eq(7).html(truck);
                    if (aData.is_approve == true) {
                        $('td', row).eq(9).addClass('approved');
                        $('td', row).eq(9).html('ยืนยัน');
                    }
                    else {
                        $('td', row).eq(9).addClass('pending');
                        $('td', row).eq(9).html('รอ');
                    }
                },
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "filterCode", "value": $("#filterCode").val() });
                    aoData.push({ "name": "filterMission", "value": $("#filterMission").val() });
                    aoData.push({ "name": "filterBookingNo", "value": $("#filterBookingNo").val() });
                    aoData.push({ "name": "filterContainerNo", "value": $("#filterContainerNo").val() });
                    aoData.push({ "name": "filterContainerSize", "value": $("#filterContainerSize").val() });
                    aoData.push({ "name": "filterLicense", "value": $("#filterLicense").val() });
                    aoData.push({ "name": "filterSupplier", "value": $("#filterSupplier").val() });
                    aoData.push({ "name": "filterStatus", "value": $("#filterStatus").val() });
                },
                "oLanguage": {
                    "sSearch": "คำค้น: ",
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-4-td text-center", targets: 0 },
                    { className: "date-td", targets: 1, },
                    { className: "code-td", targets: 2 },
                    { className: "name-td", targets: 3 },
                    { className: "booking-td", targets: 4 },
                    { className: "container-td", targets: 5 },
                    { className: "container-kind-td", targets: 6 },
                    { className: "license-td", targets: 7 },
                    { className: "supplyer-td", targets: 8 },
                    { className: "status-td", targets: 9 }
                ],
                "columns":
                    [
                        {
                            "data": "job_detail_code", "orderable": false, "render": function(data, type, row) {
                                var approve = '<a class="btn btn-xs green" href="javascript:;" data-title="ยืนยันความถูกต้อง" data-toggle="tooltip" data-trigger="hover" onclick=getApprove("' + data + '")><i class="fad fa-clipboard-check"></i></a>';
                                var back = '<a class="btn btn-xs red" href="javascript:;" data-title="ส่งกลับ" data-toggle="tooltip" data-trigger="hover" onclick=setBack("' + data + '")><i class="fad fa-undo"></i></a>';
                                var detail = '<a class="btn btn-xs blue" href="javascript:;" data-title="รายละเอียด" data-toggle="tooltip" data-trigger="hover" onclick=getDetail("' + data + '")><i class="fad fa-clipboard-list"></i></a>';
                                var grant = '<a class="btn btn-xs purple" href="javascript:;" data-title="ให้สิทธิ์อัพเดทเงินสำรองจ่าย" data-toggle="tooltip" data-trigger="hover" onclick=grant("' + data + '")><i class="fad fa-exchange-alt"></i></a>';
                                return approve + back + grant + detail;
                            }
                        },
                        { "data": "job_date" },
                        { "data": "job_detail_code" },
                        { "data": "cost_name" },
                        { "data": "booking_no" },
                        { "data": "container_no" },
                        { "data": "container_size" },
                        { "data": "truck_license" },
                        { "data": "supplier_name" },
                        { "data": "is_approve", "orderable": false }
                    ],
                "createdRow": function(row, data, dataIndex) {

                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-station tfoot tr').appendTo('#table-station thead');

            $('.filterText').keyup(function() {
                $('#table-station').dataTable()._fnAjaxUpdate();
            });

            $('.filterDropdown').change(function() {
                $('#table-station').dataTable()._fnAjaxUpdate();
            });
        }(jQuery));

        function setBack(code) {
            $.alert.open('confirm', 'คุณต้องการส่งข้อมูลดังกล่าวนี้กลับไปแก้ไขใหม่ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Approve/SendBack",
                        {
                            job_detail_code: code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $('#table-station').dataTable()._fnAjaxUpdate();
                            } else {
                                jAlert('ผลการทำงาน', "<div>เกิดข้อผิดลพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>");
                            }
                        });
                }
            });
        }

        function grant(code) {
            $.alert.open('confirm', 'คุณต้องการให้สิทธิ์การอัพเดทเงินสำรองจ่าย ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Approve/Grant",
                        {
                            code: code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $('#table-station').dataTable()._fnAjaxUpdate();
                            } else {
                                jAlert('ผลการทำงาน', "<div>เกิดข้อผิดลพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>");
                            }
                        });
                }
            });
        }

        function getApprove(code) {
            var url = '/approve/checked?job_detail_code=' + code;
            var setting = 'width=1100,height=678';

            window.open(url, 'Checked Approve', setting);
        }

        function getDetail(code) {
            var url = '/job/detail?code=' + code;
            var setting = 'width=1100,height=672';

            window.open(url, 'Detail Station', setting);
        }

        function reloadRow() {
            $("#table-station").DataTable().ajax.reload();
        }

        function closeModal() {
            $.modal.close();
        }
    </script>
}
