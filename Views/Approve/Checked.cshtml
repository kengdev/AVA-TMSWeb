@{
    ViewBag.Title = "Finish";
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
    var data = (TMSWeb.Models.Entities.LOG.ViewJobListActive)ViewBag.Data;
    var driver = (List<TMSWeb.Models.ViewModels.DriverCostViewModel>)ViewBag.Driver;
    var supplyer = (TMSWeb.Models.Entities.LOG.TblSupplierAllowance)ViewBag.Supplyer;
    //var driver_trip = (driver != null ? driver.TripValue : 0);
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
    <style>
        .table td {
            font-size: 13px;
        }

        .bordered {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }

        .data-bootstrap th {
            font-size: 13px !important;
            text-align: center;
            background: #e8e8e8;
        }

        td.topic {
            width: 120px !important;
            text-align: right;
        }

        a.closed {
            font-size: 16px !important;
            color: red;
        }

            a.closed:hover {
                color: #8e0505
            }

        .caption-helper {
            font-size: 13px;
            color: #929292
        }

        .other-val {
            width: 83px !important;
            display: inline-block;
        }

        .form-body {
            padding-top: 0 !important;
        }

        .form-actions {
            padding: 15px 0 0 0 !important;
            margin: 0;
        }

        .table-responsive {
            overflow-y: visible !important;
            z-index: 999;
        }

        .form-box,
        .nameAdvance {
            height: 25px !important;
        }

        th {
            text-align: left !important;
        }
    </style>
}

<div class="col-md-12 col-lg-12">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-clipboard-check"></i>
                <span class="caption-subject bold uppercase"> ยืนยันความถูกต้อง</span>
                <span class="caption-helper">[งานเลขที่ @data.JobDetailCode ]</span>
            </div>
        </div>
        @using (Html.BeginForm("Confirm", "Approve", FormMethod.Post, new
        {
            role = "form",
            id = "frmFinish",
            onsubmit
        = "return OnValidate()"
        }))
        {
            @Html.Hidden("job_detail_code", data.JobDetailCode)
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-lg-6 col-md-6">
                            @await Component.InvokeAsync("EntryAdvance", new { code = data.JobDetailCode })
                        </div>
                        <div class="col-lg-6 col-md-6">
                            @await Component.InvokeAsync("EntryCashing", new { code = data.JobDetailCode })

                            <div class="row">
                                <div class="col-md-12">
                                    <table data-toggle="table" data-height="135" data-width="100" class="data-bootstrap">
                                        <thead>
                                            <tr>
                                                <th data-align="left">พนักงานขับรถ</th>
                                                <th data-align="center" data-width="110">รายการ</th>
                                                <th data-align="right" data-width="110">ยอดเงิน</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in driver)
                                            {
                                                <tr>
                                                    <td>
                                                        @Html.Hidden("cost_type", item.cost_type)
                                                        @Html.Hidden("driver_code", item.driver_code)
                                                        <span style="padding-left:10px!important;">
                                                            @item.driver_name
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (item.cost_type == "A")
                                                        {
                                                            <span>ค่าเที่ยว</span>
                                                        }
                                                        else
                                                        {
                                                            <span>ค่าทอยตู้</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div>
                                                            @Html.TextBox("driver_value", item.cost_value, new { @Class = "form-control form-box", autocomplete = "off" })
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row" style="margin-top: 10px;">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="font-sm">เบอร์ตู้</label>
                                @Html.TextBox("container_no", data.ContainerNo, new { @Class = "form-control input-sm", autocomplete = "off" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="font-sm">เบอร์ซีล</label>
                                @Html.TextBox("seal_no", data.SealNo, new
                                {
                                    @Class = "form-control input-sm",
                                    autocomplete = "off"
                                })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="font-sm">Tare weight</label>
                                @Html.TextBox("tare_weight", data.TareWeight, new
                                {
                                    @Class = "form-control input-sm",
                                    autocomplete = "off"
                                })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group" style="margin:0;">
                                <label class="font-sm">คิดเงินลูกค้า</label>
                                @Html.TextBox("cost_value", data.CostValue, new
                                {
                                    @Class = "form-control input-sm",
                                    autocomplete = "off"
                                })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group" style="margin:0;">
                                <label class="font-sm">ค่าขนส่งรถร่วม [@data.SupplierName]</label>
                                @Html.TextBox("supplier_value", supplyer.CostValue, new
                                {
                                    @Class = "form-control input-sm",
                                    autocomplete = "off"
                                })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label></label>
                                <div class="mt-checkbox-list">
                                    <label class="mt-checkbox mt-checkbox-outline">
                                        บันทึกลงฐานข้อมูลหลัก
                                        <input type="checkbox" value="TRUE" name="is_save" />
                                        <span></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <div class="row pull-right">
                        <div class="col-md-12">
                            <div class="tools-action">
                                <a href="javascript:;" onclick="window.close();">ยกเลิก</a> |
                                <button type="submit" class="btn green">บันทึกข้อมูล</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts
{
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        (function($) {
            $("#frmFinish").ajaxForm(function(data) {
                killOverlayForm();
                if (data.result === true) {
                    $.alert.open('info', "บันทึกข้อมูลเรียบร้อยแล้ว", function(r) {
                        window.opener.reloadRow();
                        window.close();
                    });
                } else {
                    $.alert.open('error',
                        "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>"
                    );
                }
            });

            $(document.body).delegate('.cashing-val', 'change', function() {
                var cost = 0;
                var x = $(this).val();
                var arr = x.split('+');
                $.each(arr, function(index, value) {
                    if (value != '') {
                        cost = cost + parseFloat(value);
                    }
                });

                if (cost > 0) {
                    $(this).val(cost);
                }
                TotalCashingSum()
            });

            $(document.body).delegate('.advance-val', 'change', function() {
                var cost = 0;
                var x = $(this).val();
                var arr = x.split('+');
                $.each(arr, function(index, value) {
                    if (value != '') {
                        cost = cost + parseFloat(value);
                    }
                });

                if (cost > 0) {
                    $(this).val(cost);
                }
                TotalAdvanceSum()
            });
        }(jQuery));

        function addAdvance() {
            var row = $('#advance-table tr td').html();
            if (row == "No matching records found") {
                $('#advance-table tr').remove();
            }
            var row =
                '<tr><td style="text-align:center;vertical-align:middle;"><a href="#" class="closed" onclick=removeAdvanceItem(this)><span class="icon-close"></span></a></td>'
            row += '<td><input type="text" class="form-control nameAdvance" name="nameAdvance[]"></td>';
            row +=
                '<td><input type="text" class="form-control form-box" name="valWithdrawAdvance[]" value="0" /></td>'
            row +=
                '<td><input type="text" class="form-control form-box" name="valAdvance[]" value="0" /></td></tr>'
            $('#advance-table').append(row)
        }

        function addCashing() {
            var row =
                '<tr><td style="text-align:center;vertical-align:middle;"><a href="#" class="closed" onclick=removeCashingItem(this)><i class="icon icon-close"></a></td>'
            row += '<td><input type="text" class="form-control form-box" name="nameCashing[]"></td>';
            row +=
                '<td><input type="text" class="form-control cashing-val form-box" name="valCashing[]" value="0" /></td></tr>'
            $('#cashing-table').append(row)
        }

        function removeCashingItem(e) {
            //var val = $(e).closest("td").next().next().find("input").val();
            $(e).parent().parent().remove()
            TotalCashingSum();
        }

        function removeAdvanceItem(e) {
            //var val = $(e).closest("td").next().next().find("input").val();
            $(e).parent().parent().remove()
            TotalAdvanceSum();
        }

        function TotalCashingSum() {
            var sum = 0;
            $(".cashing-val").each(function() {
                sum += parseFloat(this.value) || 0;
            });

            $('#total-cashing').html(number_format(sum));
            $('#hidden-total-cashing').val(sum);
        }

        function TotalAdvanceSum() {
            var sum = 0;
            $(".advance-val").each(function() {
                sum += parseFloat(this.value) || 0;
            });

            $('#total-advance').html(number_format(sum));
            $('#hidden-total-advance').val(sum);
        }

        function OnValidate() {
            $(".form-box").each(function() {
                if ($(this).val() == '') {
                    $(this).val('0');
                }
            });

            $(".nameAdvance").each(function() {
                if ($(this).val() == '') {
                    $(this).val('-');
                }
            });

            overLayForm();
            return true;
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}