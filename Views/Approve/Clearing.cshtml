@model TMSWeb.Models.Entities.LOG.TblShippingpayment
@{
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
    var data = (List<TMSWeb.Models.ViewModels.JobViewModel>)ViewBag.List;
}
@section styles {
    <style>
        .dataTables_wrapper .dataTables_scroll div.dataTables_scrollBody {
            overflow-y: scroll !important;
            overflow-x: hidden !important;
        }

        .date, .customer {
            width: 110px;
        }

        .code {
            width: 130px;
            text-align: center;
        }

        .currency {
            width: 90px;
            text-align: right;
            padding-right: 15px !important;
        }
    </style>
}

<div class="col-md-12">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-plus-circle"></i>
                <span class="caption-subject bold small"> ทำรายการเคลียร์ยอดสำรองจ่าย</span>
            </div>
            <div class="actions">
            </div>
        </div>
        <div class="portlet-body">
            @using (Html.BeginForm("ClearingData", "Approve", FormMethod.Post, new { role = "form", id = "frmPayment", onsubmit = "return OnValidate()" }))
            {
                <div class="portlet-body form">
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-striped table-hover table-checkable order-column" id="table-advance">
                                <thead>
                                    <tr>
                                        <th data-align="center" data-width="40">
                                            <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                <input type="checkbox" id="check-all" onclick="checkAllFunc(this)" />
                                                <span></span>
                                            </label>
                                        </th>
                                        <th> Date</th>
                                        <th> Name</th>
                                        <th> Place</th>
                                        <th> Booking</th>
                                        <th> Container</th>
                                        <th> </th>
                                    </tr>
                                </thead>
                                <tbody id="list-billing">
                                    @foreach (var item in data)
                                    {
                                        <tr>
                                            <td style="text-align:center!important;">
                                                <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                    <input type="checkbox" name="code" class="item-checkable item-checked" value="@item.job_detail_code" onclick="checkboxFunc(this)" autocomplete="off" />
                                                    <input type="hidden" value="@item.cost_value" class="cost" />
                                                    <span></span>
                                                </label>
                                            </td>
                                            <td class="date">@item.job_date</td>
                                            <td class="customer">@item.customer_name</td>
                                            <td class="name">@item.mission_name</td>
                                            <td class="code">@item.booking_no</td>
                                            <td class="code">@item.container_no</td>
                                            <td class="currency">@item.cost_value.Value.ToString("#,##0.00")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="form-actions" style="background:#fff">
                        <div class="row pull-right">
                            <div class="col-md-12">
                                <div class="tools-action">
                                    <a href="javascript:;" onclick="window.close();">ยกเลิก</a> |
                                    <button type="submit" class="btn green">บันทึกข้อมูล</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $("#frmPayment").ajaxForm(function(data) {
            overLayForm();
            if (data.result == true) {
                $.alert.open('info', data.resultMessage, function(r) {
                    window.opener.reloadRow();
                    window.location.reload();
                });
            } else {
                $.alert.open('error', data.resultMessage);
            }
        });

        var iTable = $('#table-advance').DataTable({
            scrollY: 380,
            scrollCollapse: 0,
            sorting: 0,
            searching: false,
            info: false,
            "ordering": false,
            "paging": false
        });

        function checkAllFunc(e) {
            var ev = $(e).is(':checked');
            if (ev) {
                $(".item-checked").prop('checked', true);
            }
            else {
                $(".item-checked").prop('checked', false);
            }

            setNetTotal();
        }

        function checkboxFunc(e) {
            var _tot = $(".item-checked").length
            var _tot_checked = $(".item-checked:checked").length;

            if (_tot != _tot_checked) {
                $("#check-all").prop('checked', false);
            }
            else if (_tot == _tot_checked) {
                $("#check-all").prop('checked', true);
            }

            setNetTotal();
        }

        function setNetTotal() {
            var total = 0;
            var amount = $(".item-checked:checked").length;
            $('.item-checked:checked').each(function() {
                total = parseFloat($(this).next('.cost').val()) + total;
            });

            $('span#amount-total').html(amount);
            $('span#net-total').html(number_format(total));
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }

        function OnValidate() {
            overLayForm();
            return true;
        }
    </script>
}