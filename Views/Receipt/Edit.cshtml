@model TMSWeb.Models.Entities.LOG.TblReceipt
@{
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
    ViewBag.Title = "แก้ไขรายการใบเสร็จรับเงิน";
    var data = (List<TMSWeb.Models.ViewModels.CoverSheetViewModel>)ViewBag.Data;
    var detail = (List<TMSWeb.Models.Entities.LOG.TblReceiptDetail>)ViewBag.Detail;
    var c = detail.Count();
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
    <style>
        .bordered {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }

        .dataTables_wrapper .dataTables_filter {
            visibility: hidden;
        }

        div.dataTables_wrapper {
            margin: 0 auto;
        }

        .code {
            text-align: center;
            width: 150px;
            font-size: 13px !important;
        }

        .date {
            text-align: center;
            width: 110px;
            font-size: 13px !important;
        }

        .currency {
            text-align: right;
            width: 110px;
            font-size: 13px !important;
        }

        .name {
            font-size: 13px !important;
        }

        table.wrapper {
            width: 100% !important;
        }

        .scrolltable {
            height: 375px;
            overflow-y: scroll;
            overflow-x: scroll;
            border-left: 1px solid #ccc;
        }

        th,
        td {
            font-size: 13px !important;
        }

        .table {
            border-top: none !important;
        }

        .form-body {
            padding-top: 0 !important;
        }

        .form-actions {
            padding: 15px 0 0 0 !important;
            margin: 0;
        }
    </style>
}

<div class="col-md-12 col-lg-12">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-pencil"></i>
                <span class="caption-subject bold uppercase"> แก้ไขรายการ [งานตู้]</span>
                <span class="caption-helper">[เลขที่]</span>
            </div>
        </div>
        @using (Html.BeginForm("EditReceipt", "Receipt", FormMethod.Post, new { id = "frmAdd", onsubmit = "return OnValidate()" }))
        {
            @Html.HiddenFor(m => m.ReceiptName)
            @Html.HiddenFor(m => m.CustomerName)
            @Html.HiddenFor(m => m.CustomerTax)
            @Html.HiddenFor(m => m.CustomerAddress)
            @Html.HiddenFor(m => m.ReceiptCode)
            @Html.HiddenFor(m => m.ReceiptPartCode)
            @Html.HiddenFor(m => m.IsEnabled)
            @Html.HiddenFor(m => m.CreateDate)
            @Html.HiddenFor(m => m.CreateBy)
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="row">
                                <div class="col-md-12">
                                    <table data-toggle="table" data-height="453" data-search="true">
                                        <thead>
                                            <tr>
                                                <th data-align="center" data-width="40">
                                                    <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                        <input type="checkbox" id="check-all" onclick="checkAll(this)" />
                                                        <span></span>
                                                    </label>
                                                </th>
                                                <th data-width="130"> รหัส</th>
                                                <th> ชื่อลูกค้า</th>
                                                <th data-width="90"> วันที่</th>
                                                <th data-width="90"> ยอดเงิน</th>
                                            </tr>
                                        </thead>
                                        <tbody id="list-billing">
                                            @foreach (var item in data)
                                            {
                                                <tr>
                                                    <td style="text-align:center!important;">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="item-checkable item-checked"
                                                                   value="@item.billing_code"
                                                                   onclick="checkboxFunc('@item.billing_total', this)"
                                                                   autocomplete="off" />
                                                            <input type="hidden" value="@item.billing_total"
                                                                   class="total-val" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    <td class="code">@item.billing_code</td>
                                                    <td class="name">@item.customer_name</td>
                                                    <td class="date">@item.billing_date</td>
                                                    <td class="currency">@item.billing_total.ToString("#,##0.00")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="pull-right" style="margin-top:31px;font-size:13px;">
                                        <span>จำนวนที่เลือก : </span>
                                        <span id="checked-count"> 0 </span>
                                        <span> รายการ</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-1">
                            <div class="row" style="margin-top: 50px;">
                                <div class="col-md-12 text-center">
                                    <a href="javascript:;" class="btn btn-icon-only blue" id="append-job">
                                        <i class="fad fa-angle-double-right"></i>
                                    </a>
                                </div>
                            </div>
                            <div class="row" style="margin-top: 7px;">
                                <div class="col-md-12 text-center">
                                    <a href="javascript:;" class="btn btn-icon-only grey" id="remove-job">
                                        <i class="fad fa-angle-double-left"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="row" style="margin-top: 25px;">
                                <div class="col-md-4">
                                    <div class="form-group" style="margin:0!important;padding:0!important;">
                                        <label class="control-label font-sm">ชำระโดย</label>
                                        @Html.DropDownList("ReceiptType", null, "-----เลือก-----", new
                                        {
                                            @Class =
                                        "form-control input-sm",
                                            id = "receipt_type"
                                        })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group" style="margin:0!important;padding:0!important;">
                                        <label class="control-label font-sm">วันที่</label>
                                        @Html.TextBoxFor(m => m.ReceiptDate, "{0:yyyy-MM-dd}", new { @Class = "form-control input-sm datepicker" })
                                    </div>
                                </div>
                            </div>

                            <div class="row" style="margin-top: 5px;">
                                <div class="col-md-4">
                                    <div class="form-group" style="margin:0!important;padding:0!important;">
                                        <label class="control-label font-sm">ธนาคาร</label>
                                        @Html.DropDownList("BankName", null, "-----เลือก-----", new
                                        {
                                            @Class =
                                        "form-control input-sm",
                                            id = "bank_name",
                                            disabled = "disabled"
                                        })
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="control-label font-sm">สาขา</label>
                                        @Html.TextBoxFor(m => m.BankBranchName, new
                                        {
                                            @Class = "form-control input-sm",
                                            id = "branch_name",
                                            disabled = "disabled"
                                        })
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="control-label font-sm">เช็คเลขที่</label>
                                        @Html.TextBoxFor(m => m.ChequeNo, new
                                        {
                                            @Class = "form-control input-sm",
                                            id = "cheque_no",
                                            disabled = "disabled"
                                        })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label class="font-sm">หมายเหตุ</label>
                                        @Html.TextBoxFor(m => m.ReceiptRemark, new
                                        {
                                            @Class = "form-control input-sm",
                                            placeholder =
                                        "หมายเหตุ"
                                        })
                                    </div>
                                </div>
                            </div>
                            <br />

                            <div class="row">
                                <div class="col-md-12" style="margin-top:-35px!important;">
                                    <table class="table table-hover" id="selected">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th style="width:110px;">รหัส</th>
                                                <th style="width:70px;"> ลูกค้า</th>
                                                <th style="width:70px;"> สำรอง</th>
                                                <th style="width:70px;"> ค่าเที่ยว</th>
                                                <th style="text-align: left;width:70px;"> รวม</th>
                                            </tr>
                                        </thead>
                                        <tbody id="detail-body">
                                            @foreach (var item in detail)
                                            {
                                                @await Component.InvokeAsync("EntryReceipt", new { code = item.BillingCode })
                                                ;
                                            }
                                        </tbody>
                                    </table>
                                    <table style="width:100%">
                                        <tbody>
                                            <tr>
                                                <td style="font-weight:bold;text-align:right;">จำนวนรายการ</td>
                                                <td style="width:120px;font-weight:bold;color:#ff0000;text-align:right;font-size:14px!important;">
                                                    <span id="list-count"> @c.ToString() </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold;text-align:right;border:none;">ยอดเงินทั้งสิ้น</td>
                                                <td style="width:120px;font-weight:bold;color:#ff0000;text-align:right;font-size:14px!important;border:none;">
                                                    <span id="total-display">@Model.ReceiptTotal.ToString("#,##0.00")</span>
                                                    @Html.HiddenFor(m => m.ReceiptTotal, new { id = "total-val", autocomplete = "off" })
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-1">
                                    <div class="form-group">
                                        <label></label>
                                        <div class="mt-checkbox-list">
                                            <label class="mt-checkbox mt-checkbox-outline">
                                                @Html.CheckBoxFor(m => m.IsExcharge, new { id = "check-excharge" })
                                                <span></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-11">
                                    @if (Model.IsExcharge)
                                    {
                                        <div class="form-group">
                                            <label class="font-sm">รายการอื่น ๆ</label>
                                            @Html.TextBoxFor(m => m.ExchargeTopic, new { @Class = "form-control input-sm", id = "excharge-topic", placeholder = "รายละเอียด" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-group">
                                            <label class="font-sm">รายการอื่น ๆ</label>
                                            @Html.TextBoxFor(m => m.ExchargeTopic, new { @Class = "form-control input-sm", id = "excharge-topic", placeholder = "รายละเอียด", Disabled = "disabled" })
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row pull-right">
                        <div class="col-md-12">
                            <div class="tools-action">
                                <a href="javascript:;" onclick="javascript:window.close()">ปิด</a> |
                                <button type="submit" class="btn green">บันทึกข้อมูล</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>



@section scripts
{
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        (function($) {
            var sTable = $('#selected').DataTable({
                scrollY: 185,
                scrollCollapse: 0,
                sorting: 0,
                searching: false,
                info: false,
                "ordering": false,
                "paging": false
            });

            $("#frmAdd").ajaxForm(function(data) {
                killOverlayForm();
                if (data.result == true) {
                    $.alert.open('info', data.resultMessage, function(r) {
                        window.opener.reloadRow();
                        window.location.reload();
                    });
                } else {
                    $.alert.open('error', data.resultMessage);
                }
            });

            $('#receipt_type').change(function() {
                var x = $(this).val();
                if (x == '03') {
                    $('#bank_name').prop('disabled', false);
                    $('#cheque_no').prop('disabled', false);
                    $('#branch_name').prop('disabled', false);
                } else {
                    $('#bank_name').prop('disabled', true);
                    $('#cheque_no').prop('disabled', true);
                    $('#branch_name').prop('disabled', true);
                }
            });

            $('.item-checked').click(function() {
                countSelect();
            });

            $('#check-excharge').change(function() {
                var item_val = $(this).is(':checked')
                if (item_val) {
                    $('#excharge-topic').prop('disabled', false);
                }
                else {
                    $('#excharge-topic').val('');
                    $('#excharge-topic').prop('disabled', true);
                }
            });

            $('#append-job').click(function() {
                var net = 0;
                var x = $('.item-checked').filter(':checked').length;
                if (x < 200) {
                    var balance = parseFloat($('#total-val').val());
                    var row = $('#detail-body tr td').html();
                    if (row == "No data available in table") {
                        $('#detail-body tr').remove();
                    }

                    $('input[type=checkbox]:checked.item-checked').each(function() {
                        var code = $(this).val();
                        $.post("/Receipt/_EntryReceiptDetail", {
                            code: code
                        }, function(result) {
                            $('#detail-body').prepend(result);
                            countList();
                        });

                        $(this).closest('tr').remove();
                        var cash = parseFloat($(this).next('.total-val').val());
                        net += cash;
                    });

                    var total_val = net + balance;
                    $("#check-all").prop('checked', false);
                    $('#total-display').html(number_format(total_val));
                    $('#total-val').val(total_val.toFixed(2));
                } else {
                    $.alert.open('error',
                        "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> ไม่สามารถเลือกข้อมูลได้มากกว่า 200 รายการ</div>"
                    );
                }
            });

            $('#remove-job').click(function() {
                $('.billing_code').each(function() {
                    var billing_code = $(this).val();
                    var billing_date = $(this).next().val();
                    var customer_name = $(this).next().next().val();
                    var billing_total = $(this).next().next().next().val();

                    removeFunc(billing_code, billing_total, billing_date, customer_name);
                    $(this).parent().remove()
                    countList();
                });
            });
        }(jQuery));

        function checkAll(e) {
            $(".item-checked").prop('checked', $(e).prop("checked"));
            countSelect();
        }

        function countSelect() {
            var x = $('.item-checked').filter(':checked').length;
            $('#checked-count').html(x);
        }

        function countList() {
            var x = $('.billing_code').length;
            $('#list-count').html(x);
            $('#checked-count').html(0);
        }

        function checkboxFunc(e) {
            var _tot = $(".item-checked").length
            var _tot_checked = $(".item-checked:checked").length;
            var x = $(e).closest('td').find('.total-val');
            if ($(e).is(':checked')) {
                x.prop('disabled', false);
            } else {
                x.prop('disabled', true);
            }


            if (_tot != _tot_checked) {
                $("#check-all").prop('checked', false);
            } else if (_tot == _tot_checked) {
                $("#check-all").prop('checked', true);
            }

            countSelect();
        }

        function removeFunc(billing_code, billing_total, billing_date, customer_name) {
            var tr_val = "<tr>";
            var element_check = '<label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">';
            element_check +=
                '<input type="checkbox" class="item-checkable item-checked"  onclick="checkboxFunc()" value="' +
                billing_code + '" />';
            element_check += '<input type="hidden" value="' + billing_total + '" class="total-val"/>';
            element_check += '<span></span></label>';

            tr_val += "<td  style='text-align:center;'>" + element_check + "</td>";
            tr_val += "<td style='text-align:center;'>" + billing_code + "</td>";
            tr_val += "<td style='text-align:left;'>" + customer_name + "</td>";
            tr_val += "<td style='text-align:center;'>" + billing_date + "</td>";
            tr_val += "<td style='text-align:right;'>" + parseFloat(billing_total).toFixed(2) + "</td>";

            $('#list-billing').append(tr_val);
            setTotal(parseFloat(billing_total));
        }

        function setTotal(total) {
            var net_total = $('#total-val').val();
            var total_val = parseFloat(net_total) - total;

            countList();
            $('#total-display').html(number_format(total_val));
            $('#total-val').val(total_val.toFixed(2));
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }


        function OnValidate() {
            var total = parseFloat($('#total-val').val());
            if (total <= 0) {
                $.alert.open('error', "<div>กรุณาเลือกอย่างน้อย 1 รายการ</div>");
                return false;
            } else {
                overLayForm();
                return true;
            }
        }
    </script>
}