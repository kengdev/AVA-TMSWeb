@{
    ViewBag.TopActive = "Billing";
    ViewBag.MidActive = "receipt";
    ViewBag.Title = "ใบเสร็จรับเงิน";
}
@section Styles {
    <style>
        table.dataTable td,
        table.dataTable th {
            font-size: 13px !important;
        }

        .dataTables_filter {
            display: none;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">การวางบิล</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/receipt/">ใบเสร็จรับเงิน</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> รายการใบเสร็จรับเงิน </span>
                </div>
                <div class="actions">
                    <button type="button" class="btn btn-sm yellow-lemon btn-circle btn-outline" onclick="uploadFile()">
                        <i class="fad fa-upload"></i> นำเข้าไฟล์
                    </button>

                    <button type="button" class="btn btn-sm blue btn-circle btn-outline" onclick="getPdf()">
                        <i class="fad fa-download"></i> ดาวน์โหลด
                    </button>
                </div>
            </div>
            <div class="portlet-body table-both-scroll">
                <div class="row">
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-6">
                        <div class="form-inline pull-right">
                            <div class="form-group">
                                @Html.DropDownList("month", null, new
                                {
                                    @Class = "form-control dlListForm",
                                    Style =
                                "width:120px;"
                                })
                            </div>
                            <div class="form-group">
                                @Html.DropDownList("year", null, new
                                {
                                    @Class = "form-control dlListForm",
                                    Style =
                                "width:90px;"
                                })
                            </div>
                            |
                            <button type="button" class="btn btn-sm red" onclick="setAddReceipt()">ทำรายการ</button>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-striped table-bordered table-hover table-checkable order-column"
                               id="table-receipt">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th> วันที่/เวลา</th>
                                    <th> เลขที่</th>
                                    <th> ลูกค้า</th>
                                    <th> จำนวน</th>
                                    <th> ยอดเงิน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr role="row" class="heading">
                                    <th class="filter"></th>
                                    <th class="filter"></th>
                                    <th class="filter">
                                        <input type="text" class="form-control filterText"
                                               id="filterCode" />
                                    </th>
                                    <th class="filter">
                                        <input type="text" class="form-control filterText"
                                               id="filterCustomer" />
                                    </th>
                                    <th class="filter"></th>
                                    <th class="filter"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/Scripts/default/jQuery.print.js"></script>
    <script type="text/javascript">
        (function($) {
            var oTable = $('#table-receipt').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[2, "desc"]],
                "sAjaxSource": "/Receipt/GetReceiptDataList",
                "fnRowCallback": function(row, aData, index) {
                    $('td', row).eq(4).html(aData.receipt_amount + ' รายการ');
                    $('td', row).eq(5).html(number_format(aData.receipt_total));
                },
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "month", "value": $("#month").val() });
                    aoData.push({ "name": "year", "value": $("#year").val() });
                    aoData.push({ "name": "filterCode", "value": $("#filterCode").val() });
                    aoData.push({ "name": "filterCustomer", "value": $("#filterCustomer").val() });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-4-td text-center", targets: 0 },
                    { className: "date-td", targets: 1 },
                    { className: "date-td", targets: 2 },
                    { className: "name-td", targets: 3 },
                    { className: "quantity-td", targets: 4 },
                    { className: "currency-td", targets: 5 }
                ],
                "columns":
                    [
                        {
                            "data": "receipt_code", "orderable": false, "render": function(data, type, row) {
                                var print = '<a  class="btn btn-xs grey" href="javascript:;" data-title="พิมพ์เอกสาร"  data-toggle="tooltip" data-trigger="hover" onclick=setPrint("' + data + '")><i class="fad fa-print"></i></a>';
                                var remove = '<a class="btn btn-xs red" href="javascript:;" data-title="ลบ"  data-toggle="tooltip" data-trigger="hover" onclick=setRemove("' + data + '")><i class="fad fa-trash"></i></a>';
                                var edit = '<a class="btn btn-xs yellow" href="javascript:;" data-title="แก้ไข"  data-toggle="tooltip" data-trigger="hover" onclick=setEdit("' + data + '")><i class="fad fa-pencil"></i></a>';
                                var detail = '<a class="btn btn-xs blue" href="javascript:;" data-title="รายละเอียด"  data-toggle="tooltip" data-trigger="hover" onclick=setDetail("' + data + '")><i class="fad fa-clipboard-list"></i></a>';

                                return remove + edit + detail + print;
                            }
                        },
                        { "data": "receipt_date" },
                        { "data": "receipt_part_code" },
                        { "data": "customer_name" },
                        { "data": "receipt_amount", "orderable": false },
                        { "data": "receipt_total", "orderable": false }
                    ],
                "createdRow": function(row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-receipt tfoot tr').appendTo('#table-receipt thead');

            $('.filterText').keyup(function() {
                $('#table-receipt').dataTable()._fnAjaxUpdate();
            });

            $('.dlListForm').change(function() {
                $('#table-receipt').dataTable()._fnAjaxUpdate();
            });
        }(jQuery));

        function getPdf() {

            var month = $('#month').val();
            var year = $('#year').val();

            var url = '/form/GetReceiptPDFList?month=' + month + '&year=' + year;
            window.open(url, 'form list');
        }

        function uploadFile() {
            var url = '/receipt/upload';
            var setting = 'width=1250,height=750';

            window.open(url, 'receipt upload', setting);
        }

        function setPrint(code) {
            var url = '/form/_receipt?code=' + code;

            window.open(url, '_blank');
        }

        function setEdit(code) {
            var url = '/receipt/edit?code=' + code;
            var setting = 'width=1250,height=750';

            window.open(url, 'edit receipt', setting);
        }

        function setAddReceipt() {
            var url = '/receipt/add';
            var setting = 'width=1250,height=750';

            window.open(url, 'add receipt', setting);
        }

        function setDetail(code) {
            var url = '/receipt/detail?code=' + code;
            var setting = 'width=1100,height=628';

            window.open(url, 'detail receipt', setting);
        }

        function reloadRow() {
            $("#table-receipt").DataTable().ajax.reload();
        }

        function setRemove(code) {
            $.alert.open('confirm', 'คุณต้องการลบข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/Receipt/RemoveReceipt",
                        {
                            code: code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function(r) {
                                    $('#table-receipt').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                jAlert('ผลการทำงาน', data.resultMessage);
                            }
                        });
                }
            });
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}
