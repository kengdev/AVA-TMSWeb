@model TMSWeb.Models.Entities.LOG.TblReceiptDetail
@using HtmlHelpers.BeginCollectionItemCore
@{
    var data = (TMSWeb.Models.ViewModels.CoverSheetViewModel)ViewBag.Data;
}
<tr>
    @using (Html.BeginCollectionItem("TblReceiptDetails"))
    {
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.BillingCode)
        @Html.HiddenFor(m => m.ReceiptValue)
        @Html.HiddenFor(m => m.BillingType)
        @Html.Hidden("billing_code", data.billing_code, new { @Class = "billing_code" })
        @Html.Hidden("billing_date", data.create_date)
        @Html.Hidden("customer_name", data.customer_name)
        @Html.Hidden("billing_total", data.billing_total)
        <td style="border-left:none;text-align:center;">
            <a href="#" class="font-red" onclick="$(this).parent().parent().remove(), removeFunc('@data.billing_code','@data.billing_total','@data.create_date.ToString("yyyy-MM-dd")','@data.customer_name')">
                <i class="fa fa-times"></i>
            </a>
        </td>
        <td>
            @data.billing_code
        </td>
        <td style="text-align:left;">@data.customer_name</td>
        <td style="text-align:right;">
            @data.advance_value.ToString("#,##0.00")
        </td>
        <td style="text-align:right;">
            @data.transport_value.ToString("#,##0.00")
        </td>
        <td style="text-align:right;">
            @data.billing_total.ToString("#,##0.00")
        </td>
    }
</tr>
