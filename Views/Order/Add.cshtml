        function addDomList() {
            var code = $('#txtDomesticFinish').val();
            var name = $('#txtDomesticDisFinishName').val();
            var row = '<tr><td class="action"><a href="javascript:;" onclick="removeItem()"><i class="fal fa-times-circle font-red"></i></a></td>';
            row += '<td class="code"><input type="hidden" name="domesticFinishCode[]" value="' + code + '" />' + code + '</td>';
            row += '<td>' + name + '</td></tr>'

            $('#domesticBody').append(row);
            $('#txtDomesticFinish').val('');
            $('#txtDomesticDisFinishName').val('');
        }

        function addDetail() {
            var data =
                '<tr><td style="vertical-align:middle;text-align:center;"><a href="javascript:;" class="font-red" onclick="$(this).parent().parent().remove()"><i class="fa fa-times"></i></a></td>';
            data +=
                '<td><input type="text" name="iBL[]" class="form-control input-sm" placeholder="B/L No" autocomplete="off" /></td>';
            data +=
                '<td><input type="text" name="iContainer[]" class="form-control input-sm" placeholder="เบอร์ตู้" autocomplete="off" /></td>';
            data +=
                '<td><input type="text" name="iQuantity[]" class="form-control input-sm" placeholder="จำนวน" autocomplete="off" /></td>';
            data +=
                '<td><input type="text" name="iWeight[]" class="form-control input-sm" placeholder="น้ำหนัก" autocomplete="off" /></td>';
            data +=
                '<td><input type="text" name="iCBM[]" class="form-control input-sm" placeholder="ปริมาตร" autocomplete="off" /></td>';
            data +=
                '<td><input type="text" name="iDelivery[]" class="form-control input-sm jt" placeholder="วันที่ส่งสินค้า" autocomplete="off" /></td></tr>';
            $('#ocean-detail').append(data);
            $('#ocean-detail').find(".jt").datetimepicker({
                datepicker: true,
                timepicker: true,
                lang: 'th',
                step: 30,
                format: 'Y-m-d H:i',
                inline: false
            });
        }

        function searchYardPortFunc() {
            var url = '';
            var setting = 'width=900,height=550';
            url = '/search/yardport?ev=flr';

            window.open(url, 'search place', setting);
        }

        function searchDomYardPortFunc(ele) {
            var url = '';
            var setting = 'width=900,height=550';
            url = '/search/yardport?ev=' + ele;

            window.open(url, 'search place', setting);
        }

        function searchPlaceFunc(action) {
            var url = '';
            var setting = 'width=900,height=550';
            var type = $('.rdoJobType:checked').val();
            $('#valueChange').val(action)

            if (action == 'S') {
                if (type == "IMPORT") {
                    url = '/search/port';
                }
                else if (type == "EXPORT") {
                    url = '/search/yard';
                }
            }
            else if (action == 'F') {
                if (type == "IMPORT") {
                    url = '/search/yard';
                }
                else if (type == "EXPORT") {
                    url = '/search/port';
                }
            }
            else {
                url = '/search/place'
            }

            window.open(url, 'search place', setting);
        }

        function searchCustomerFunc(e) {
            var url = '../search/transportrate?ev=' + e;
            var setting = 'width=900,height=550';
            window.open(url, 'search customer', setting);
        }

        function setYardPortBox(code, type) {
            var event = $('#job_type_handle').val();
            var action = $('#valueChange').val();
            overLayForm();
            $.post("../Order/GetYardPort",
                {
                    code: code
                }, function(result) {
                    var code = result.place_code;
                    var name = result.place_name;
                    var type = result.place_type;
                    if (event == 'flr') {
                        $('#txtFloorStartCode').val(code);
                        $('#txtFloorDisStartName').val(name);
                        $('#txtStartType').val(type);
                    }
                    else if (event == 'cont') {
                        if (action === 'S') {
                            $('#txtStartCode').val(code);
                            $('#txtDisStartName').val(name);
                        }
                        else if (action === 'F') {
                            $('#txtFinishCode').val(code);
                            $('#txtDisFinishName').val(name);
                        }
                    }
                    else if (event == 'dom') {
                        if (action === 'S') {
                            $('#txtDomesticStartCode').val(code);
                            $('#txtDomesticStartName').val(name);
                        }
                        else if (action === 'F') {
                            $('#txtFinishCode').val(code);
                            $('#txtDisFinishName').val(name);
                        }
                    }
                    else {
                        if (action === 'S') {
                            $('#txtOceanStartCode').val(code);
                            $('#txtOceanDisStartName').val(name);
                        }
                        else if (action === 'F') {
                            $('#txtOceanFinishCode').val(code);
                            $('#txtOceanDisFinishName').val(name);
                        }
                    }
                    killOverlayForm();
                });
        }

        function setDomYardPortBox(code, type, ele) {
            var event = $('#job_type_handle').val();
            var action = $('#valueChange').val();
            overLayForm();
            $.post("../Order/GetYardPort",
                {
                    code: code
                }, function(result) {
                    var code = result.place_code;
                    var name = result.place_name;
                    var place_type = result.place_type;
                    $('#txtDomesticFinish').val(code);
                    $('#txtDomesticDisFinishName').val(name);
                    killOverlayForm();
                });
        }

        function setCustomerBox(code, event) {
            overLayForm();
            $.post("../Order/GetCustomerCost",
                {
                    code: code
                }, function(result) {
                    if (event == 'cont') {
                        $('#txtCostCode').val(result.cost_code);
                        $('#txtCustomerCode').val(result.customer_code);
                        $('#txtCustomerName').val(result.customer_name_th);
                        $('#txtMissionCode').val(result.mission_code);
                        $('#txtExpressway').val(result.expressway_value);
                        $('#txtDisMissionName').val(result.mission_name);
                        $('#acronym').val(result.customer_acronym);
                    }
                    else if (event == 'flr') {
                        $('#txtFloorCostCode').val(result.cost_code);
                        $('#txtFloorCustomerCode').val(result.customer_code);
                        $('#txtFloorCustomerName').val(result.customer_name_th);
                        $('#txtFloorMissionCode').val(result.mission_code);
                        $('#txtFloorDisMissionName').val(result.mission_name);
                        $('#txtFloorExpressway').val(result.expressway_value);
                        $('#txtMissionType').val(result.mission_type);
                        $('#flooracronym').val(result.customer_acronym);
                    }
                    else if (event == 'dom') {
                        $('#txtDomesticCostCode').val(result.cost_code);
                        $('#txtDomesticCustomerCode').val(result.customer_code);
                        $('#txtDomesticCustomerName').val(result.customer_name_th);
                        $('#domesticacronym').val(result.customer_acronym);
                        $('#route_code').val(result.mission_code);
                        $('#txtDomesticRouteName').html(result.mission_name);
                        $('#txtDomExpressway').val(result.expressway_value);
                    }
                    else {
                        $('#txtOceanCostCode').val(result.cost_code);
                        $('#txtOceanCustomerCode').val(result.customer_code);
                        $('#txtOceanCustomerName').val(result.customer_name_th);
                        $('#txtOceanMissionCode').val(result.mission_code);
                        $('#txtOceanDisMissionName').val(result.mission_name);
                        $('#txtOceanExpressway').val(result.expressway_value);
                        $('#oceanacronym').val(result.customer_acronym);
                    }

                    killOverlayForm();
                });
            $('#txtSearchCustomer').val('');
        }

        function getRouteDetail(code) {
            $.post("../Route/GetRouteDetail",
                {
                    code: code
                }, function(data) {
                    $.each(data.start, function(index, item) {
                        $('#domesticStartBody').append('<tr><td>' + item.start_name + '</td></tr>')
                    });

                    $.each(data.mission, function(index, item) {
                        $('#domesticMissionBody').append('<tr><td>' + item.mission_name + '</td></tr>')
                    });
                });
        }

