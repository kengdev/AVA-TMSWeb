@{
    ViewBag.TopActive = "Job";
    ViewBag.MidActive = "daily";
    ViewBag.Title = "ข้อมูลงาน";
}
@section Styles {
    <style>
        .dataTables_filter {
            display: none;
        }

        table.dataTable td,
        table.dataTable th {
            font-size: 12px !important;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }

        .dropdown-td {
            width: 70px !important;
            padding-top: 11px !important;
        }

        .wrap-print {
            width: 100% !important;
            text-align: center !important;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">ข้อมูลงาน</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/order/">ข้อมูลงานประจำวัน</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase">
                        รายการงานประจำวัน
                    </span>
                </div>
                <div class="actions">
                </div>
            </div>
            <div class="portlet-body table-both-scroll">
                <div class="row">
                    <div class="col-md-6">
                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right">
                            <input type="text" class="form-control"
                                   value="@DateTime.Now.AddDays(-3).ToString(" yyyy-MM-dd")" id="filterDateRangeStart" />
                            <span style="display:inline-block;" class="daterange-to-text">to</span>

                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                       id="filterDateRangeEnd">
                                <span class="input-group-btn">
                                    <button class="btn green" id="btnSearch" type="button">ค้นหา</button>
                                </span>
                            </div>

                            <button type="button" class="btn btn-sm red" onclick="setAddOrder()">ทำรายการ</button>
                        </div>
                    </div>
                </div>

                <table class="table table-striped table-bordered table-hover order-column" id="table-job">
                    <thead>
                        <tr>
                            <th></th>
                            <th></th>
                            <th> วันที่/เวลา</th>
                            <th> เลขที่งาน</th>
                            <th> สถานที่</th>
                            <th style="font-size:12px!important;"> Booking</th>
                            <th style="font-size:12px!important;"> Invoice</th>
                            <th> งาน</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr role="row" class="heading">
                            <th class="filter"></th>
                            <th class="filter"></th>
                            <th class="filter"></th>

                            <th class="filter">
                                <input type="text" class="form-control filterText" id="filterCode" />
                            </th>
                            <th class="filter">
                                <input type="text" class="form-control filterText" id="filterMission" />
                            </th>
                            <th class="filter">
                                <input type="text" class="form-control filterText"
                                       id="filterBookingNo" />
                            </th>
                            <th class="filter">
                                <input type="text" class="form-control filterText" id="filterInvoice" />
                            </th>
                            <th class="filter"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        (function($) {
            var oTable = $('#table-job').DataTable({
                "processing": true,
                "serverSide": true,
                "iDisplayLength": 20,
                "scrollCollapse": false,
                "order": [[1, "asc"]],
                "sAjaxSource": "/Order/GetOrderBookingDataList",
                "fnRowCallback": function(row, aData, index) {
                    if (aData.job_type == "IMPORT") {
                        $('td', row).eq(7).html('<span class="label label-sm label-warning"> IMPORT </span>');
                    }
                    else if (aData.job_type == "EXPORT") {

                        $('td', row).eq(7).html('<span class="label label-sm label-danger"> EXPORT </span>');
                    }
                    else if (aData.job_type == "OCEAN") {
                        $('td', row).eq(7).html('<span class="label label-sm label-success">&nbsp;OCEAN&nbsp;</span>');
                    }
                    else if (aData.job_type == "DOMESTIC") {
                        $('td', row).eq(7).html('<span class="label label-sm label-info">&nbsp;DOMESTIC&nbsp;</span>');
                    }
                    else {
                        $('td', row).eq(7).html('<span class="label label-sm label-success">&nbsp;FLOOR&nbsp;</span>');
                    }
                },
                "fnServerParams": function(aoData) {
                    aoData.push({ "name": "filterDateRangeStart", "value": $("#filterDateRangeStart").val() });
                    aoData.push({ "name": "filterDateRangeEnd", "value": $("#filterDateRangeEnd").val() });
                    aoData.push({ "name": "filterCode", "value": $("#filterCode").val() });
                    aoData.push({ "name": "filterMission", "value": $("#filterMission").val() });
                    aoData.push({ "name": "filterBookingNo", "value": $("#filterBookingNo").val() });
                    aoData.push({ "name": "filterInvoice", "value": $("#filterContainerNo").val() });
                },
                "oLanguage": {
                    "sInfoFiltered": " ",
                    "sInfo": "แสดงจำนวน _START_ to _END_ รายการ (ทั้งหมด _TOTAL_ รายการ)",
                    "sSearch": "ค้นหา : ",
                    "sLengthMenu": 'แสดงจำนวน <select class="form-control">' +
                        '<option value="10">10</option>' +
                        '<option value="20" selected>20</option>' +
                        '<option value="30">30</option>' +
                        '<option value="40">40</option>' +
                        '<option value="50">50</option>' +
                        '<option value="100">100</option>' +
                        '</select> รายการ'
                },
                "columnDefs": [
                    { className: "action-3-td text-center", targets: 0 },
                    { className: "dropdown-td text-left", targets: 1 },
                    { className: "datetime-filter-td", targets: 2 },
                    { className: "code-td", targets: 3 },
                    { className: "name-td", targets: 4 },
                    { className: "booking-td", targets: 5 },
                    { className: "invoice-td", targets: 6 },
                    { className: "type-td", targets: 7 }
                ],
                "columns":
                    [
                        {
                            "data": "job_code", "orderable": false, "render": function(data, type, row) {
                                var transport = '<a href="javascript:;" class="btn btn-xs purple" data-title="จัดรถ"  data-toggle="tooltip" data-trigger="hover" onclick=setManage("' + data + '","' + row.job_detail_code + '")><i class="fad fa-layer-plus"></i></a>';
                                var remove = '<a href="javascript:;" data-title="ลบ"  data-toggle="tooltip" class="btn btn-xs red" data-trigger="hover" onclick=setRemove("' + data + '","' + row.job_detail_code + '")><i class="fad fa-trash"></i></a>';
                                var edit = '<a href="javascript:;" data-title="แก้ไข"  data-toggle="tooltip" class="btn btn-xs yellow" data-trigger="hover" onclick=setEdit("' + data + '","' + row.job_type + '")><i class="fad fa-pencil"></i></a>';

                                return remove + edit + transport;
                            }
                        },
                        {
                            "data": "job_code", "orderable": false, "render": function(data, type, row) {
                                if (row.job_type == 'OCEAN') {
                                    var action = '<div class="btn-group dropup">';
                                    action += '<button class="btn btn-xs blue dropdown-toggle" type="button" data-toggle="dropdown" aria-expanded="false"> พิมพ์เอกสาร ';
                                    action += '<i class="fa fa-angle-down"></i>';
                                    action += '</button>';
                                    action += '<ul class="dropdown-menu pull-right" role="menu">';

                                    action += '<li><a href="javascript:;" onclick=printJobOrder("' + row.job_detail_code + '")> ใบสั่งงาน (งานตู้) </a></li>';
                                    action += '<li class="divider"> </li>';
                                    action += '<li><a href="javascript:;" onclick=printBooking("' + data + '")> HDMC </a></li>';
                                    action += '<li><a href="javascript:;" onclick=printTriumph("' + data + '")> TRIUMPH </a></li>';

                                    action += '</ul></li>';
                                    action += '</ul></div>';

                                    return action;
                                }
                                else {
                                    var print = '<div class="wrap-print"><a href="javascript:;" data-title="พิมพ์เอกสาร" data-toggle="tooltip" class="btn btn-xs grey" data-trigger="hover" onclick=printJobOrder("' + row.job_detail_code + '")><i class="fad fa-print"></i></a></div>';

                                    return print;
                                }
                            }
                        },
                        { "data": "job_date" },
                        { "data": "job_detail_code" },
                        { "data": "mission_name" },
                        { "data": "booking_no" },
                        { "data": "job_invoice" },
                        { "data": "job_type" }
                    ],
                "createdRow": function(row, data, dataIndex) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            $('#table-job tfoot tr').appendTo('#table-job thead');

            $('.filterText').keyup(function() {
                $('#table-job').dataTable()._fnAjaxUpdate();
            });

            $('#filterDateRangeStart').datetimepicker({
                format: 'Y/m/d',
                lang: 'th',
                onShow: function(ct) {
                    this.setOptions({
                        maxDate: jQuery('#filterDateRangeEnd').val() ? jQuery('#filterDateRangeEnd').val() : false
                    })
                },
                timepicker: false
            });

            $('#filterDateRangeEnd').datetimepicker({
                format: 'Y/m/d',
                lang: 'th',
                onShow: function(ct) {
                    this.setOptions({
                        minDate: jQuery('#filterDateRangeStart').val() ? jQuery('#filterDateRangeStart').val() : false
                    })
                },
                timepicker: false
            });

            $('#btnSearch').click(function() {
                $('#table-job').dataTable()._fnAjaxUpdate();
            });
        }(jQuery));

        function setExport(type) {
            var month = $("#month").val();
            var year = $("#year").val();
            var filterDateRangeStart = $("#filterDateRangeStart").val();
            var filterDateRangeEnd = $("#filterDateRangeEnd").val();
            var filterCode = $("#filterCode").val();
            var filterMission = $("#filterMission").val();
            var filterBookingNo = $("#filterBookingNo").val();
            var filterInvoice = $("#filterInvoice").val();
            var filter = "filterDateRangeStart=" + filterDateRangeStart + "&filterDateRangeEnd=" + filterDateRangeEnd;

            filter += "&filterCode" + filterCode + "&filterMission=" + filterMission;
            filter += "&filterBookingNo=" + filterBookingNo + "&filterInvoice=" + filterInvoice;
            filter += "&month=" + month + "&year=" + year;

            //var url = "http://localhost:58607/ava-report/RPT/JobListReport?type="+type+"&" + filter;
            var url = "http://avagloballogistics.com/ava-report/RPT/JobListReport?type=" + type + "&" + filter;
            window.open(url);
        }

        function setManage(code, detail_code) {
            var url = '/order/ordertruck?code=' + code + '&detail_code=' + detail_code;
            var setting = 'width=1180,height=648';

            window.open(url, 'arrange job', setting);
        }

        function setEdit(code, type) {
            var url = "";
            var setting = "";
            if (type == 'FLOOR') {
                url = '/order/editfloorjob?code=' + code;
            }
            else if (type == 'OCEAN') {
                url = '/order/editoceanjob?code=' + code;
            }
            else {
                url = '/order/editcontainerjob?code=' + code;
            }

            window.location = url;
        }

        function setAddOrder() {
            var url = '/order/add';

            window.location = url;
        }

        function setRemove(code, job_detail_code) {
            $.alert.open('confirm', 'คุณต้องการลบข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?', function(r) {
                if (r) {
                    overLayPage();
                    $.post("/order/RemoveOrder",
                        {
                            code: code,
                            job_detail_code: job_detail_code
                        }, function(data) {
                            killOverlayPage();
                            if (data.result == true) {
                                $.alert.open('info', data.resultMessage, function(r) {
                                    $('#table-job').dataTable()._fnAjaxUpdate();
                                });
                            } else {
                                jAlert('ผลการทำงาน', data.resultMessage);
                            }
                        });
                }
            });
        }

        function printJobOrder(code) {
            //var url = "http://localhost:82/report/invoice/joborder?code=" + code;
            var url = "/form/order?code=" + code;
            window.open(url, 'Print Station');
        }

        function printBooking(code) {
            var url = "/form/ceva?code=" + code;
            window.open(url, 'Print Station');
        }

        function printTriumph(code) {
            var url = "/form/triumph?code=" + code;
            window.open(url, 'Print Station');
        }

        function reloadRow() {
            $("#table-job").DataTable().ajax.reload();
        }
    </script>
}